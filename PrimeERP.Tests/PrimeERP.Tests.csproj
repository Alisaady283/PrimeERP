<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- الاختبارات تُصيّر نوافذ WPF فعلاً، فتُعلن ذلك بدل أن ترث الإطار عرضاً عبر ProjectReference.
         بلا الإعلان لا يعرف الاستعادة أن System.IO.Packaging يوفّرها الإطار، فتُبقي النسخة الموروثة
         8.0.0 المصابة بثغرتين (GHSA-f32c-w444-8ppv وGHSA-qj66-m88j-hmgj) بدلاً من تقليمها. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrimeERP.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>