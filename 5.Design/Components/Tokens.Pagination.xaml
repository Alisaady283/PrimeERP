<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L3 — رموز شريط الصفحات (AppPagination). -->

    <!-- ثانوي لا خافت: TextMuted على أرضية الصفحة تباينه 2.26 — أقل من حدّ القراءة، وقد كشفه ThemeContrastTests. -->
    <SolidColorBrush x:Key="C.Pagination.Info.Fg" Color="{DynamicResource TextSecondary.Color}"/>
    <sys:Double      x:Key="C.Pagination.Height">44</sys:Double>
    <sys:Double      x:Key="C.Pagination.Info.FontSize">12</sys:Double>
    <sys:Double      x:Key="C.Pagination.Button.Size">34</sys:Double>
    <sys:Double      x:Key="C.Pagination.Button.Radius">6</sys:Double>
    <sys:Double      x:Key="C.Pagination.Button.Gap">4</sys:Double>
    <sys:Double      x:Key="C.Pagination.Button.FontSize">13</sys:Double>

</ResourceDictionary>
