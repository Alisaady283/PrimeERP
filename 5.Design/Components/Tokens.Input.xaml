<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L3 — رموز مكوّن الحقول. الألوان تشير لـ L2 Semantic حصراً (راجع تعليق Tokens.Button.xaml — لماذا لا L1 مباشرة). -->

    <SolidColorBrush x:Key="C.Input.Bg"          Color="{DynamicResource SurfaceDefault}"/>
    <SolidColorBrush x:Key="C.Input.Fg"          Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="C.Input.Border"      Color="{DynamicResource OutlineDefault}"/>
    <SolidColorBrush x:Key="C.Input.Placeholder" Color="{DynamicResource TextMuted}"/>

    <SolidColorBrush x:Key="C.Input.Focus.Border" Color="{DynamicResource OutlineFocus}"/>
    <sys:Double      x:Key="C.Input.Focus.BorderWidth">2</sys:Double>

    <SolidColorBrush x:Key="C.Input.Error.Border" Color="{DynamicResource Danger}"/>
    <SolidColorBrush x:Key="C.Input.Error.Text"   Color="{DynamicResource Danger}"/>

    <SolidColorBrush x:Key="C.Input.ReadOnly.Bg" Color="{DynamicResource SurfaceSunken}"/>
    <sys:Double      x:Key="C.Input.Disabled.Opacity">0.5</sys:Double>

    <SolidColorBrush x:Key="C.Input.Label.Fg" Color="{DynamicResource TextSecondary}"/>
    <sys:Double      x:Key="C.Input.Label.Gap">4</sys:Double>

    <SolidColorBrush x:Key="C.Input.Required.Fg" Color="{DynamicResource Danger}"/>
    <SolidColorBrush x:Key="C.Input.Hint.Fg"     Color="{DynamicResource TextMuted}"/>

    <!-- ===== الأبعاد — مستقلة، ثابتة بين الهويات ===== -->
    <sys:Double x:Key="C.Input.Height">36</sys:Double>
    <sys:Double x:Key="C.Input.Height.Sm">32</sys:Double>

</ResourceDictionary>
