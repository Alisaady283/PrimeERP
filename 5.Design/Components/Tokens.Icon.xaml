<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        L3 — مواصفة الأيقونة الموحّدة. كانت السماكة والحجم يُحدَّدان في كل موضع استدعاء بأرقام حرفية
        (2 و1.8 و1.7 و3، وأحجام بين 9 و18) فتبدو الأيقونة نفسها أثقل في شريط وأخف في جدول.
        AppIcon هي المستهلك الوحيد لهذه المفاتيح — لا موضع استدعاء يحدّد رقماً بعدها.
    -->

    <sys:Double x:Key="C.Icon.Size.Xs">12</sys:Double>
    <sys:Double x:Key="C.Icon.Size.Sm">14</sys:Double>
    <sys:Double x:Key="C.Icon.Size.Md">18</sys:Double>
    <sys:Double x:Key="C.Icon.Size.Lg">22</sys:Double>

    <!-- سماكة واحدة لكل الأحجام: تساوي الوزن البصري هو ما يجعل مجموعة الأيقونات تُقرأ كعائلة واحدة. -->
    <sys:Double x:Key="C.Icon.Stroke">1.75</sys:Double>

    <SolidColorBrush x:Key="C.Icon.Fg"       Color="{DynamicResource TextSecondary.Color}"/>
    <SolidColorBrush x:Key="C.Icon.Fg.Muted" Color="{DynamicResource TextMuted.Color}"/>

</ResourceDictionary>
