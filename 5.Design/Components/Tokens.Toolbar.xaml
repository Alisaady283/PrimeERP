<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L3 — رموز شرائط الصفحة العلوية (PageHeader/FilterBar) — "شريط أدوات" بالمعنى العام لا ActionToolbar تحديداً (تلك في Tokens.Button.xaml). الألوان تشير لـ L2 Semantic حصراً. -->

    <SolidColorBrush x:Key="C.Toolbar.Bg"     Color="{DynamicResource SurfaceDefault}"/>
    <SolidColorBrush x:Key="C.Toolbar.AltBg"  Color="{DynamicResource SurfaceCanvas}"/>
    <SolidColorBrush x:Key="C.Toolbar.Border" Color="{DynamicResource OutlineDefault}"/>

    <SolidColorBrush x:Key="C.Toolbar.Title.Fg"    Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="C.Toolbar.Subtitle.Fg" Color="{DynamicResource TextMuted}"/>
    <SolidColorBrush x:Key="C.Toolbar.Muted.Fg"    Color="{DynamicResource TextSecondary}"/>

    <SolidColorBrush x:Key="C.Toolbar.IconWrap.Bg" Color="{DynamicResource BrandSoft}"/>
    <SolidColorBrush x:Key="C.Toolbar.Icon.Fg"     Color="{DynamicResource BrandDefault}"/>

    <SolidColorBrush x:Key="C.Toolbar.CountBadge.Bg"     Color="{DynamicResource BrandSoft}"/>
    <SolidColorBrush x:Key="C.Toolbar.CountBadge.Border" Color="{DynamicResource BrandDefault}"/>
    <SolidColorBrush x:Key="C.Toolbar.CountBadge.Fg"     Color="{DynamicResource BrandDefault}"/>

    <sys:Double x:Key="C.Toolbar.IconWrap.Size">40</sys:Double>
    <sys:Double x:Key="C.Toolbar.Icon.Size">18</sys:Double>

</ResourceDictionary>
