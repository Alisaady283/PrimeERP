<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L3 — رموز الأسطح البطاقية (AppCard/AppStatCard/AppEmptyState/AppLoadingOverlay). الألوان تشير لـ L2 Semantic حصراً. -->

    <SolidColorBrush x:Key="C.Card.Bg"     Color="{DynamicResource SurfaceRaised}"/>
    <SolidColorBrush x:Key="C.Card.Border" Color="{DynamicResource OutlineDefault}"/>
    <SolidColorBrush x:Key="C.Card.Title.Fg"    Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="C.Card.Subtitle.Fg" Color="{DynamicResource TextSecondary}"/>

    <SolidColorBrush x:Key="C.StatCard.Value.Fg" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="C.StatCard.Label.Fg" Color="{DynamicResource TextSecondary}"/>

    <SolidColorBrush x:Key="C.EmptyState.Fg"     Color="{DynamicResource TextMuted}"/>
    <sys:Double      x:Key="C.EmptyState.IconSize">48</sys:Double>

    <!-- الحاجب الخلفي لـ AppLoadingOverlay يستهلك Scrim (L2، Semantic.Light/Dark.xaml) مباشرة — هو نفسه Brush جاهز، لا حاجة لإعادة تغليفه هنا. -->

</ResourceDictionary>
