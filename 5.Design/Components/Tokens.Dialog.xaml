<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L3 — رموز مكوّن الحوار. لون الهيدر نفسه ليس هنا — يُحسب وقت التشغيل عبر VariantToBrushConverter من StatusVariant. -->

    <SolidColorBrush x:Key="C.Dialog.Header.Bg"     Color="{DynamicResource SurfaceHeader.Color}"/>
    <SolidColorBrush x:Key="C.Dialog.Header.Border" Color="{DynamicResource OutlineSubtle.Color}"/>
    <SolidColorBrush x:Key="C.Dialog.Footer.Bg"     Color="{DynamicResource SurfaceOverlay.Color}"/>
    <SolidColorBrush x:Key="C.Dialog.Footer.Border" Color="{DynamicResource OutlineDefault.Color}"/>


    <!-- هامش شفاف حول بطاقة الحوار يتّسع للظل. النافذة أوسع/أطول به من البطاقة المرئية، فكل حساب
         عرضٍ أو ارتفاع يطرحه — راجع AppDialogWindow.CardWidth. -->
    <Thickness x:Key="C.Dialog.Gutter">16</Thickness>

    <sys:Double x:Key="C.Dialog.Width.Sm">420</sys:Double>
    <sys:Double x:Key="C.Dialog.Width.Md">560</sys:Double>
    <sys:Double x:Key="C.Dialog.Width.Lg">760</sys:Double>
    <sys:Double x:Key="C.Dialog.Width.Xl">1000</sys:Double>
    <sys:Double x:Key="C.Dialog.Width.Xxl">1260</sys:Double>

</ResourceDictionary>
