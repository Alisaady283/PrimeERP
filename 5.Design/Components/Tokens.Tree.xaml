<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- L3 — رموز الشجرة (AppTreeView). الألوان تشير لـ L2 Semantic حصراً. -->

    <SolidColorBrush x:Key="C.Tree.Bg"          Color="{DynamicResource SurfaceDefault.Color}"/>
    <SolidColorBrush x:Key="C.Tree.Border"      Color="{DynamicResource OutlineDefault.Color}"/>
    <SolidColorBrush x:Key="C.Tree.Item.Fg"     Color="{DynamicResource TextPrimary.Color}"/>
    <SolidColorBrush x:Key="C.Tree.Item.Disabled.Fg" Color="{DynamicResource TextMuted.Color}"/>
    <SolidColorBrush x:Key="C.Tree.Item.Match.Fg"    Color="{DynamicResource BrandDefault.Color}"/>

</ResourceDictionary>
