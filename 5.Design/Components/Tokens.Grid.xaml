<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L3 — رموز مكوّن الجدول (AppDataGrid). الألوان تشير لـ L2 Semantic حصراً. -->

    <SolidColorBrush x:Key="C.Grid.Header.Bg"     Color="{DynamicResource GridHeaderBg.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Header.Fg"     Color="{DynamicResource GridHeaderFg.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Header.Border" Color="{DynamicResource BrandHover.Color}"/>

    <SolidColorBrush x:Key="C.Grid.Row.Bg"      Color="{DynamicResource SurfaceRaised.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Row.AltBg"   Color="{DynamicResource GridRowAltBg.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Row.Hover"   Color="{DynamicResource BrandSoft.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Row.Selected.Bg" Color="{DynamicResource BrandSoft.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Row.Selected.Fg" Color="{DynamicResource TextPrimary.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Row.Selected.Border" Color="{DynamicResource BrandDefault.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Row.Danger.Bg"   Color="{DynamicResource DangerSoft.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Row.Warning.Bg"  Color="{DynamicResource WarningSoft.Color}"/>

    <SolidColorBrush x:Key="C.Grid.Border"      Color="{DynamicResource OutlineSubtle.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Cell.Fg"     Color="{DynamicResource TextPrimary.Color}"/>

    <SolidColorBrush x:Key="C.Grid.Footer.Bg"     Color="{DynamicResource SurfaceSunken.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Footer.Fg"     Color="{DynamicResource TextPrimary.Color}"/>
    <SolidColorBrush x:Key="C.Grid.Footer.Border" Color="{DynamicResource OutlineStrong.Color}"/>

    <SolidColorBrush x:Key="C.Grid.Empty.Fg" Color="{DynamicResource TextMuted.Color}"/>
    <sys:Double      x:Key="C.Grid.Empty.IconSize">40</sys:Double>

    <sys:Double x:Key="C.Grid.Header.Height">44</sys:Double>
    <Thickness  x:Key="C.Grid.Header.BorderBottomThickness">0,0,0,2</Thickness>
    <sys:Double x:Key="C.Grid.Row.Height">40</sys:Double>
    <Thickness  x:Key="C.Grid.Row.Selected.BorderThickness">0,0,3,0</Thickness>
    <sys:Double x:Key="C.Grid.Footer.Height">36</sys:Double>
    <Thickness  x:Key="C.Grid.Footer.BorderThickness">1,0,1,2</Thickness>
    <sys:Double x:Key="C.Grid.RowHeader.Width">40</sys:Double>
    <CornerRadius x:Key="C.Grid.Container.Radius">10</CornerRadius>
    <Thickness  x:Key="C.Grid.Container.BorderThickness">1</Thickness>

</ResourceDictionary>
