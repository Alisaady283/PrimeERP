<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- الهوية: زيتي (Olive) — ترابيّ رصين — اسم الملف اسم الهوية، ومحتواه ألوانها؛ والنسخة الجديدة تُنسخ منه بالمفاتيح والتعليقات نفسها -->

    <!-- Surface -->
    <SolidColorBrush x:Key="PageBg" Color="#FFFFFF"/>  <!-- خلفية منطقة الصفحة -->
    <SolidColorBrush x:Key="SurfaceCanvas"     Color="#F3F4EE"/>  <!-- خلفية النافذة الرئيسية وتمرير عناصر القوائم -->
    <SolidColorBrush x:Key="SurfaceBackground" Color="#F8F9F5"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="SurfaceDefault"    Color="#FFFFFF"/>  <!-- خلفية الحقول والأزرار والجداول -->
    <SolidColorBrush x:Key="SurfaceRaised"     Color="#FFFFFF"/>  <!-- خلفية القوائم المنسدلة والجداول المرتفعة -->
    <SolidColorBrush x:Key="SurfaceOverlay"    Color="#FFFFFF"/>  <!-- خلفية نوافذ الحوار -->
    <SolidColorBrush x:Key="SurfaceSunken"     Color="#F3F4EE"/>  <!-- خلفية تمرير زرّ الأيقونة والحقل المعطّل -->
    <SolidColorBrush x:Key="SurfaceHeader"     Color="#F8F9F5"/>  <!-- غير مستعمل -->

    <!-- Border -->
    <SolidColorBrush x:Key="OutlineSubtle"  Color="#F3F4EE"/>  <!-- حدّ خفيف داخل الحوار والطباعة -->
    <SolidColorBrush x:Key="OutlineDefault" Color="#E3E5DA"/>  <!-- حدّ الحقول والأزرار والحوار -->
    <SolidColorBrush x:Key="OutlineStrong"  Color="#CDD1C0"/>  <!-- حدّ قوي وشريط التمرير -->
    <SolidColorBrush x:Key="OutlineFocus"   Color="#5B6B2E"/>  <!-- حدّ الحقل عند التركيز -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#22251A"/>  <!-- الخطّ الأساسي -->
    <SolidColorBrush x:Key="TextSecondary" Color="#54594A"/>  <!-- الخطّ الثانوي وأيقونات الأزرار -->
    <SolidColorBrush x:Key="TextTertiary"  Color="#707563"/>  <!-- خطّ الشارة المحايدة -->
    <SolidColorBrush x:Key="TextMuted"     Color="#A0A493"/>  <!-- الخطّ الباهت والتلميحات -->
    <SolidColorBrush x:Key="TextOnBrand"   Color="#FFFFFF"/>  <!-- الخطّ فوق لون الهوية -->
    <SolidColorBrush x:Key="TextLink"      Color="#5B6B2E"/>  <!-- غير مستعمل -->

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandDefault"    Color="#5B6B2E"/>  <!-- لون الهوية: زرّ الدخول والأزرار الأساسية -->
    <SolidColorBrush x:Key="BrandHover"      Color="#4B5926"/>  <!-- لون الهوية عند التمرير -->
    <SolidColorBrush x:Key="BrandActive"     Color="#3A451D"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="BrandSoft"       Color="#F0F3E6"/>  <!-- خلفية فاتحة بلون الهوية -->
    <SolidColorBrush x:Key="BrandSoftBorder" Color="#C3CE9F"/>  <!-- حدّ الشارة بلون الهوية -->
    <SolidColorBrush x:Key="BrandSoftText"   Color="#445020"/>  <!-- خطّ الشارة بلون الهوية -->

    <!-- Grid -->
    <SolidColorBrush x:Key="GridHeaderBg" Color="#F3F4EE"/>  <!-- خلفية صفوف العناوين داخل الجدول -->
    <SolidColorBrush x:Key="GridHeaderFg" Color="#22251A"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="GridRowAltBg" Color="#F8F9F5"/>  <!-- خلفية الصفّ المتناوب في الجدول -->

    <SolidColorBrush x:Key="TreeFolder" Color="#E9B949"/>  <!-- أيقونة المجلّد في الشجرة -->
    <SolidColorBrush x:Key="LoginBg" Color="#F8F9F5"/>  <!-- خلفية نافذة الدخول -->
    <SolidColorBrush x:Key="ToolbarBg" Color="#FFFFFF"/>  <!-- خلفية شريط الأدوات وشريط التصفية -->

    <!-- Status -->
    <SolidColorBrush x:Key="Success"         Color="#277F55"/>  <!-- لون النجاح -->
    <SolidColorBrush x:Key="SuccessHover"    Color="#1E6544"/>  <!-- النجاح عند التمرير -->
    <SolidColorBrush x:Key="SuccessSoft"     Color="#EDF6F0"/>  <!-- خلفية النجاح الفاتحة -->
    <SolidColorBrush x:Key="SuccessSoftText" Color="#1E6544"/>  <!-- خطّ النجاح -->

    <SolidColorBrush x:Key="Danger"         Color="#B03E34"/>  <!-- لون الخطأ والحذف -->
    <SolidColorBrush x:Key="DangerHover"    Color="#8F312A"/>  <!-- الخطأ عند التمرير -->
    <SolidColorBrush x:Key="DangerSoft"     Color="#FCEFEE"/>  <!-- خلفية الخطأ الفاتحة -->
    <SolidColorBrush x:Key="DangerSoftText" Color="#8F312A"/>  <!-- خطّ الخطأ -->

    <SolidColorBrush x:Key="Warning"         Color="#B07817"/>  <!-- لون التنبيه -->
    <SolidColorBrush x:Key="WarningHover"    Color="#8D5F12"/>  <!-- التنبيه عند التمرير -->
    <SolidColorBrush x:Key="WarningSoft"     Color="#FDF5E9"/>  <!-- خلفية التنبيه الفاتحة -->
    <SolidColorBrush x:Key="WarningSoftText" Color="#8D5F12"/>  <!-- خطّ التنبيه -->

    <SolidColorBrush x:Key="Info"         Color="#3A66A0"/>  <!-- لون المعلومة -->
    <SolidColorBrush x:Key="InfoHover"    Color="#2F5382"/>  <!-- المعلومة عند التمرير -->
    <SolidColorBrush x:Key="InfoSoft"     Color="#EEF3FA"/>  <!-- خلفية المعلومة الفاتحة -->
    <SolidColorBrush x:Key="InfoSoftText" Color="#2F5382"/>  <!-- خطّ المعلومة -->

    <!-- Nav -->
    <SolidColorBrush x:Key="NavSurface"       Color="#23281A"/>  <!-- خلفية السايدبار -->
    <SolidColorBrush x:Key="NavSurfaceRaised" Color="#2C3220"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="NavText"          Color="#D6DBC6"/>  <!-- خطّ السايدبار -->
    <SolidColorBrush x:Key="NavTextHover"     Color="#FFFFFF"/>  <!-- خطّ السايدبار عند التمرير -->
    <SolidColorBrush x:Key="NavTextSelected"  Color="#FFFFFF"/>  <!-- خطّ الصفحة المفتوحة واسم البرنامج -->
    <SolidColorBrush x:Key="NavIcon"          Color="#A2AA8B"/>  <!-- أيقونات السايدبار ولاحقة ERP -->
    <SolidColorBrush x:Key="NavIconHover"     Color="#FFFFFF"/>  <!-- أيقونة السايدبار عند التمرير -->
    <SolidColorBrush x:Key="NavIconSelected"  Color="#FFFFFF"/>  <!-- أيقونة الصفحة المفتوحة -->
    <SolidColorBrush x:Key="NavHover"         Color="#313824"/>  <!-- خلفية التمرير والصفحة المفتوحة والفواصل في السايدبار -->
    <SolidColorBrush x:Key="NavSelected"      Color="#3D452C"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="NavSelectedBar"   Color="#C9D78F"/>  <!-- شريط علامة الصفحة المفتوحة -->
    <SolidColorBrush x:Key="NavSectionLabel"  Color="#A2AA8B"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="NavDivider"       Color="#3D452C"/>  <!-- غير مستعمل -->

    <!-- Dialog -->
    <SolidColorBrush x:Key="DialogHeaderSurface" Color="#23281A"/>  <!-- خلفية رأس الفورم ونوافذ الحوار -->
    <SolidColorBrush x:Key="DialogHeaderText"    Color="#FFFFFF"/>  <!-- عنوان رأس الفورم وأيقونتاه -->

    <!-- TitleBar -->
    <SolidColorBrush x:Key="TitleBarSurface"    Color="#23281A"/>  <!-- خلفية شريط العنوان أعلى النافذة -->
    <SolidColorBrush x:Key="TitleBarIcon"       Color="#FFFFFF"/>  <!-- أيقونات التصغير والتكبير والإغلاق -->
    <SolidColorBrush x:Key="TitleBarHover"      Color="#313824"/>  <!-- خلفية زرّ التصغير والتكبير عند التمرير -->
    <SolidColorBrush x:Key="TitleBarCloseHover" Color="#E81123"/>  <!-- خلفية زرّ الإغلاق عند التمرير -->

    <!-- TopBar -->
    <SolidColorBrush x:Key="TopBarSurface"   Color="#23281A"/>  <!-- خلفية الهيدر وقائمة المستخدم -->
    <SolidColorBrush x:Key="TopBarBorder"    Color="#3D452C"/>  <!-- حدّ الهيدر السفلي -->
    <SolidColorBrush x:Key="TopBarText"      Color="#FFFFFF"/>  <!-- خطّ الهيدر -->
    <SolidColorBrush x:Key="TopBarIcon"      Color="#D6DBC6"/>  <!-- أيقونات الهيدر -->
    <SolidColorBrush x:Key="TopBarIconHover" Color="#FFFFFF"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="TopBarTextMuted" Color="#A2AA8B"/>  <!-- الخطّ الباهت في الهيدر -->
    <SolidColorBrush x:Key="TopBarHover"     Color="#313824"/>  <!-- التمرير في الهيدر -->
    <SolidColorBrush x:Key="TopBarAvatar"    Color="#5B6B2E"/>  <!-- دائرة حرف المستخدم -->

    <!-- Table -->
    <SolidColorBrush x:Key="TableHeaderBg"        Color="#3D452C"/>  <!-- خلفية رأس الجدول — درجةٌ داكنة من السايدبار -->
    <SolidColorBrush x:Key="TableHeaderText"      Color="#FFFFFF"/>  <!-- خطّ رأس الجدول -->
    <SolidColorBrush x:Key="TableHeaderBorder"    Color="#23281A"/>  <!-- حدّ رأس الجدول -->
    <SolidColorBrush x:Key="TableRowHover"        Color="#F0F3E6"/>  <!-- خلفية صفّ الجدول عند التمرير -->
    <SolidColorBrush x:Key="TableRowSelected"     Color="#DFE6C8"/>  <!-- خلفية الصفّ المحدّد في الجدول والقوائم -->
    <SolidColorBrush x:Key="TableRowSelectedText" Color="#22251A"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="TableBorder"          Color="#F3F4EE"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="TableFooterBg"        Color="#F3F4EE"/>  <!-- غير مستعمل -->

    <!-- Interaction -->
    <SolidColorBrush x:Key="StateHoverOverlay"   Color="#22251A" Opacity="0.04"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="StatePressedOverlay" Color="#22251A" Opacity="0.08"/>  <!-- غير مستعمل -->
    <sys:Double x:Key="StateDisabledOpacity">0.45</sys:Double>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="StateSelectedBg" Color="#DFE6C8"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="FocusRing"       Color="#5B6B2E"/>  <!-- غير مستعمل -->
    <sys:Double x:Key="FocusRingWidth">2</sys:Double>  <!-- غير مستعمل -->

    <!-- Shadow -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="{DynamicResource P.Shadow.Sm.Blur}" ShadowDepth="{DynamicResource P.Shadow.Sm.Depth}" Opacity="{DynamicResource P.Shadow.Sm.Opacity}" Color="#22251A" Direction="270"/>  <!-- ظلّ صغير للبطاقات -->
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="{DynamicResource P.Shadow.Md.Blur}" ShadowDepth="{DynamicResource P.Shadow.Md.Depth}" Opacity="{DynamicResource P.Shadow.Md.Opacity}" Color="#22251A" Direction="270"/>  <!-- ظلّ القوائم المنسدلة -->
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="{DynamicResource P.Shadow.Lg.Blur}" ShadowDepth="{DynamicResource P.Shadow.Lg.Depth}" Opacity="{DynamicResource P.Shadow.Lg.Opacity}" Color="#22251A" Direction="270"/>  <!-- ظلّ نوافذ الحوار والدخول -->
    <DropShadowEffect x:Key="ShadowXl" BlurRadius="{DynamicResource P.Shadow.Xl.Blur}" ShadowDepth="{DynamicResource P.Shadow.Xl.Depth}" Opacity="{DynamicResource P.Shadow.Xl.Opacity}" Color="#22251A" Direction="270"/>  <!-- غير مستعمل -->

    <!-- Scrim -->
    <SolidColorBrush x:Key="Scrim" Color="#000000" Opacity="0.35"/>  <!-- تعتيم خلف شاشة التحميل -->

</ResourceDictionary>
