<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inputs="clr-namespace:PrimeERP.UI.Components.Inputs">

    <!--
        L4 — كل البصري لقطع Inputs. يستهلك C.Input.* (L3) للألوان/الحالات، و P.Font.*/P.Space.*/P.Radius.*
        (L1) مباشرة للطباعة/الحشو/نصف القطر (استثناء موثَّق، راجع Tokens.Button.xaml وARCHITECTURE.md ⚠️ توقف 4).
        القطع نفسها بنية+منطق فقط، تربط عناصرها الداخلية بمفاتيح هنا عبر Style="{StaticResource ...}".
    -->

    <!-- ===== أجزاء مشتركة ===== -->

    <Style x:Key="FieldLabelRowStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource C.Input.Label.Fg}"/>
    </Style>

    <Style x:Key="FieldRequiredMarkStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource C.Input.Required.Fg}"/>
    </Style>

    <Style x:Key="FieldInnerTextBoxStyle" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.300}"/>
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource C.Input.Fg}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <Style x:Key="FieldPlaceholderStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.300}"/>
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource C.Input.Placeholder}"/>
    </Style>

    <Style x:Key="FieldErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource C.Input.Error.Text}"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldPrefixIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="Fill" Value="{DynamicResource C.Input.Hint.Fg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldSuffixIconStyle" TargetType="Path" BasedOn="{StaticResource FieldPrefixIconStyle}">
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="FieldClearButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="FieldClearIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Stroke" Value="{DynamicResource C.Input.Hint.Fg}"/>
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>

    <!-- ===== AppTextBox ===== -->

    <Style x:Key="AppTextBox_FieldBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource C.Input.Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource C.Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource P.Radius.Md}"/>
        <Setter Property="Height" Value="{DynamicResource C.Input.Height}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppTextBox}}}" Value="False">
                <Setter Property="Background" Value="{DynamicResource C.Input.ReadOnly.Bg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineSubtle}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppTextBox}}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource C.Input.Focus.Border}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppTextBox}}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource C.Input.Error.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== AppSearchBox (حقل أقصر بلا تسمية/خطأ، حشو أضيق) ===== -->

    <Style x:Key="AppSearchBox_FieldBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource C.Input.Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource C.Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource P.Radius.Md}"/>
        <Setter Property="Height" Value="{DynamicResource C.Input.Height.Sm}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppSearchBox}}}" Value="False">
                <Setter Property="Background" Value="{DynamicResource C.Input.ReadOnly.Bg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineSubtle}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppSearchBox}}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource C.Input.Focus.Border}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SearchFieldIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="Stroke" Value="{DynamicResource C.Input.Hint.Fg}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SearchFieldInnerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldInnerTextBoxStyle}">
        <Setter Property="Padding" Value="8,0"/>
    </Style>

    <Style x:Key="SearchFieldPlaceholderStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldPlaceholderStyle}">
        <Setter Property="Margin" Value="8,0"/>
    </Style>

    <!-- ===== AppComboBox ===== -->

    <Style x:Key="AppComboBox_FieldBorder" TargetType="Border" BasedOn="{StaticResource AppTextBox_FieldBorder}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppComboBox}}}" Value="False">
                <Setter Property="Background" Value="{DynamicResource C.Input.ReadOnly.Bg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineSubtle}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppComboBox}}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource C.Input.Focus.Border}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppComboBox}}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource C.Input.Error.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComboChevronStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Stroke" Value="{DynamicResource C.Input.Hint.Fg}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ComboPopupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource C.Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource P.Radius.Md}"/>
        <Setter Property="MaxHeight" Value="240"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowMd}"/>
    </Style>

    <Style x:Key="ComboPopupListBoxStyle" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.300}"/>
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
    </Style>

    <!-- ===== AppCheckBox ===== -->

    <Style TargetType="{x:Type inputs:AppCheckBox}">
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource C.Input.Disabled.Opacity}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CheckBoxBoxStyle" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0,2,10,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource P.Radius.Sm}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrong}"/>
        <Setter Property="Background" Value="{DynamicResource C.Input.Bg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppCheckBox}}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrandDefault}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppCheckBox}}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrandDefault}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrandDefault}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource AncestorType={x:Type inputs:AppCheckBox}}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrandDefault}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrandDefault}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CheckBoxMarkStyle" TargetType="Path">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource TextOnBrand}"/>
        <Setter Property="StrokeThickness" Value="2.4"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="CheckBoxDashStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="2.4"/>
        <Setter Property="RadiusX" Value="1.2"/>
        <Setter Property="RadiusY" Value="1.2"/>
        <Setter Property="Fill" Value="{DynamicResource TextOnBrand}"/>
    </Style>

    <Style x:Key="CheckBoxLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.300}"/>
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource C.Input.Fg}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CheckBoxDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource C.Input.Label.Fg}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

</ResourceDictionary>
