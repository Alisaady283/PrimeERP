<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- أنماط الحوارات -->

    <Style x:Key="DialogHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceHeader}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="DialogHeaderIconWrapStyle" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="DialogHeaderIconBackdropStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="17"/>
        <Setter Property="Opacity" Value="0.15"/>
    </Style>

    <Style x:Key="DialogHeaderIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="DialogHeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.500}"/>
        <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.Bold}"/>
    </Style>

    <Style x:Key="DialogHeaderSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="DialogCloseIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>

    <Style x:Key="DialogContentScrollStyle" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="DialogFooterStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceOverlay}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineDefault}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,14"/>
    </Style>

    <Thickness x:Key="DialogButtonSpacing">8,0,0,0</Thickness>

</ResourceDictionary>
