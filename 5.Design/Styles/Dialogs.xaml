<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- كل البصري لـ AppDialogWindow (والحوارات المشتقة منه: AppConfirmDialog/AppMessageDialog/AppProgressDialog) هنا.
         لون الهيدر نفسه ليس هنا — يُحسب وقت التشغيل عبر VariantToBrushConverter من StatusVariant الذي تضبطه القطعة. -->

    <Style x:Key="DialogHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <Style x:Key="DialogHeaderIconWrapStyle" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- خلفية دائرية شبه شفافة خلف أيقونة الهيدر — بيضاء بشفافية عبر Opacity على عنصر مستقل، لا لون بألفا مُدمج،
         حتى لا يتأثر Path الأيقونة (شقيق لا ابن) بنفس الشفافية. -->
    <Style x:Key="DialogHeaderIconBackdropStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="17"/>
        <Setter Property="Background" Value="{DynamicResource TextOnBrand}"/>
        <Setter Property="Opacity" Value="0.2"/>
    </Style>

    <Style x:Key="DialogHeaderIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke" Value="{DynamicResource TextOnBrand}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="DialogHeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnBrand}"/>
    </Style>

    <Style x:Key="DialogHeaderSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnBrand}"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="DialogCloseIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Stroke" Value="{DynamicResource TextOnBrand}"/>
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>

    <Style x:Key="DialogContentScrollStyle" TargetType="ScrollViewer">
        <Setter Property="MaxHeight" Value="480"/>
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="DialogFooterStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceDefault}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineDefault}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,14"/>
    </Style>

    <!-- مسافة قياسية بين زر وزر عند بناء صف أزرار برمجياً (Footer) — بدل Thickness حرفية في الكود. -->
    <Thickness x:Key="DialogButtonSpacing">8,0,0,0</Thickness>

</ResourceDictionary>
