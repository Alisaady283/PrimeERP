<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        L1 — نصف القطر وسمك الحدود، حزمة "Default". Radius.* مطابق تماماً لسلّم Metrics.xaml السابق
        (RadiusNone..RadiusFull). Border.* جديد — لم يكن مُرمَّزاً سابقاً (قيم BorderThickness كانت حرفية
        متفرقة). Corporate يعيد تعريف Radius.* بزوايا أحدّ (أصغر) — الحدود لا تتبع الهوية عمداً (ليست من
        الأبعاد الخمسة المطلوب تمايزها).
    -->

    <CornerRadius x:Key="P.Radius.None">0</CornerRadius>
    <CornerRadius x:Key="P.Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="P.Radius.Md">6</CornerRadius>
    <CornerRadius x:Key="P.Radius.Lg">8</CornerRadius>
    <CornerRadius x:Key="P.Radius.Xl">12</CornerRadius>
    <CornerRadius x:Key="P.Radius.Full">999</CornerRadius>

    <sys:Double x:Key="P.Border.Thin">1</sys:Double>
    <sys:Double x:Key="P.Border.Medium">1.5</sys:Double>
    <sys:Double x:Key="P.Border.Thick">2</sys:Double>

</ResourceDictionary>
