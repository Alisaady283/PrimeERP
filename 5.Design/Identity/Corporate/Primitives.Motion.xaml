<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L1 — حزمة "Corporate". الحركة ليست من الأبعاد الخمسة المطلوب تمايزها — مطابقة لـ Default حرفياً. -->

    <sys:Double x:Key="P.Duration.Fast">120</sys:Double>
    <sys:Double x:Key="P.Duration.Normal">200</sys:Double>
    <sys:Double x:Key="P.Duration.Slow">320</sys:Double>

    <CubicEase x:Key="P.Easing.Standard"    EasingMode="EaseInOut"/>
    <CubicEase x:Key="P.Easing.Decelerate"  EasingMode="EaseOut"/>
    <CubicEase x:Key="P.Easing.Accelerate"  EasingMode="EaseIn"/>

</ResourceDictionary>
