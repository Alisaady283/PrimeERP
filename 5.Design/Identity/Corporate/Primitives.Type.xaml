<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        L1 — حزمة "Corporate". العائلات تختلف فعلياً عن Default (Calibri بدل Segoe UI، Georgia كخط عرض جاد
        بدل Segoe UI Semilight) — كلاهما متوفر افتراضياً على Windows فلا حاجة لتضمين خط. المقياس أكبر بمقدار
        نقطة واحدة عبر كل الدرجات (طابع أكثر رسمية/طباعية) — فرق مقصود صغير يبقي التناسب بين الدرجات، لا
        مقياساً مختلف المنطق. الأوزان/ارتفاع السطر مطابقة لـ Default (ليست من أبعاد التمايز).
    -->

    <FontFamily x:Key="P.Font.Family.Primary">Calibri, Segoe UI, Tahoma</FontFamily>
    <!-- أرقام واضحة الشكل: رقم "1" في بعض خطوط العرض شرطة رفيعة تُقرأ حرفاً — يُستعمل حيث الرقم وحده معنى (ترقيم الصفحات). -->
    <FontFamily x:Key="P.Font.Family.Numeric">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="P.Font.Family.Mono">Consolas, Courier New</FontFamily>
    <FontFamily x:Key="P.Font.Family.Display">Georgia, Segoe UI, Tahoma</FontFamily>

    <sys:Double x:Key="P.Font.Size.100">11</sys:Double>
    <sys:Double x:Key="P.Font.Size.200">12</sys:Double>
    <sys:Double x:Key="P.Font.Size.300">13</sys:Double>
    <sys:Double x:Key="P.Font.Size.400">14</sys:Double>
    <sys:Double x:Key="P.Font.Size.500">15</sys:Double>
    <sys:Double x:Key="P.Font.Size.600">17</sys:Double>
    <sys:Double x:Key="P.Font.Size.700">19</sys:Double>
    <sys:Double x:Key="P.Font.Size.800">23</sys:Double>
    <sys:Double x:Key="P.Font.Size.900">29</sys:Double>

    <FontWeight x:Key="P.Font.Weight.Normal">Normal</FontWeight>
    <FontWeight x:Key="P.Font.Weight.Medium">Medium</FontWeight>
    <FontWeight x:Key="P.Font.Weight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="P.Font.Weight.Bold">Bold</FontWeight>

    <sys:Double x:Key="P.Line.Tight">1.2</sys:Double>
    <sys:Double x:Key="P.Line.Normal">1.45</sys:Double>
    <sys:Double x:Key="P.Line.Relaxed">1.6</sys:Double>

</ResourceDictionary>
