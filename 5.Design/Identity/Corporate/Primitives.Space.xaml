<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L1 — حزمة "Corporate". كل قيمة = قيمة Default × 1.25 مضبوطة لأقرب عدد صحيح (مسافات أوسع 25% كما يطلب التوقف). -->

    <sys:Double x:Key="P.Space.0">0</sys:Double>
    <sys:Double x:Key="P.Space.1">5</sys:Double>
    <sys:Double x:Key="P.Space.2">10</sys:Double>
    <sys:Double x:Key="P.Space.3">15</sys:Double>
    <sys:Double x:Key="P.Space.4">20</sys:Double>
    <sys:Double x:Key="P.Space.5">25</sys:Double>
    <sys:Double x:Key="P.Space.6">30</sys:Double>
    <sys:Double x:Key="P.Space.8">40</sys:Double>
    <sys:Double x:Key="P.Space.10">50</sys:Double>
    <sys:Double x:Key="P.Space.12">60</sys:Double>
    <sys:Double x:Key="P.Space.16">80</sys:Double>

    <Thickness x:Key="P.Space.4.Uniform">20</Thickness>

</ResourceDictionary>
