<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L1 — حزمة "Corporate". ظلال أقوى (Opacity/Blur أعلى بوضوح) من Default — عمق بصري أكبر. -->

    <sys:Double x:Key="P.Shadow.Sm.Blur">6</sys:Double>
    <sys:Double x:Key="P.Shadow.Sm.Depth">2</sys:Double>
    <sys:Double x:Key="P.Shadow.Sm.Opacity">0.08</sys:Double>

    <sys:Double x:Key="P.Shadow.Md.Blur">16</sys:Double>
    <sys:Double x:Key="P.Shadow.Md.Depth">3</sys:Double>
    <sys:Double x:Key="P.Shadow.Md.Opacity">0.12</sys:Double>

    <sys:Double x:Key="P.Shadow.Lg.Blur">32</sys:Double>
    <sys:Double x:Key="P.Shadow.Lg.Depth">6</sys:Double>
    <sys:Double x:Key="P.Shadow.Lg.Opacity">0.18</sys:Double>

    <sys:Double x:Key="P.Shadow.Xl.Blur">52</sys:Double>
    <sys:Double x:Key="P.Shadow.Xl.Depth">10</sys:Double>
    <sys:Double x:Key="P.Shadow.Xl.Opacity">0.24</sys:Double>

</ResourceDictionary>
