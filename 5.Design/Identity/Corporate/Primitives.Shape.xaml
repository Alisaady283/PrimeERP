<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- L1 — حزمة "Corporate". زوايا أحدّ (أصغر تقريباً النصف) من Default — هوية أكثر جدية/رسمية. Border.* كما في Default. -->

    <CornerRadius x:Key="P.Radius.None">0</CornerRadius>
    <CornerRadius x:Key="P.Radius.Sm">2</CornerRadius>
    <CornerRadius x:Key="P.Radius.Md">3</CornerRadius>
    <CornerRadius x:Key="P.Radius.Lg">4</CornerRadius>
    <CornerRadius x:Key="P.Radius.Xl">6</CornerRadius>
    <CornerRadius x:Key="P.Radius.Full">999</CornerRadius>

    <sys:Double x:Key="P.Border.Thin">1</sys:Double>
    <sys:Double x:Key="P.Border.Medium">1.5</sys:Double>
    <sys:Double x:Key="P.Border.Thick">2</sys:Double>

</ResourceDictionary>
