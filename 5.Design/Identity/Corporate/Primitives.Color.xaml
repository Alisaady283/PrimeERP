<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L1 — حزمة هوية بديلة "Corporate"، إثبات عملي لتوقف 1: نفس مفاتيح Default حرفياً، قيم مختلفة تماماً
        (بنفسجي بدل الأزرق، رمادي أبرد). Semantic لا يتغيّر سطر واحد فيه — استبدال هذا الملف وحده (+ملف الشريط
        الجانبي أدناه) كافٍ لتغيير هوية التطبيق بالكامل وقت التشغيل. الحالات الدلالية (Success/Danger/Warning/
        Info) والأساسيات (White/Black) تبقى كما في Default عمداً — معناها عالمي، لا يتبع هوية العلامة.
    -->

    <!-- ===== Brand — بنفسجي (Violet) بدل الأزرق ===== -->
    <Color x:Key="P.Color.Brand.50">#F5F3FF</Color>
    <Color x:Key="P.Color.Brand.100">#EDE9FE</Color>
    <Color x:Key="P.Color.Brand.200">#DDD6FE</Color>
    <Color x:Key="P.Color.Brand.300">#C4B5FD</Color>
    <Color x:Key="P.Color.Brand.400">#A78BFA</Color>
    <Color x:Key="P.Color.Brand.500">#8B5CF6</Color>
    <Color x:Key="P.Color.Brand.600">#7C3AED</Color>
    <Color x:Key="P.Color.Brand.700">#6D28D9</Color>
    <Color x:Key="P.Color.Brand.800">#5B21B6</Color>
    <Color x:Key="P.Color.Brand.900">#4C1D95</Color>
    <Color x:Key="P.Color.Brand.950">#2E1065</Color>

    <!-- ===== Neutral — رمادي أبرد (Zinc) بدل Slate ===== -->
    <Color x:Key="P.Color.Neutral.50">#FAFAFA</Color>
    <Color x:Key="P.Color.Neutral.100">#F4F4F5</Color>
    <Color x:Key="P.Color.Neutral.200">#E4E4E7</Color>
    <Color x:Key="P.Color.Neutral.300">#D4D4D8</Color>
    <Color x:Key="P.Color.Neutral.400">#A1A1AA</Color>
    <Color x:Key="P.Color.Neutral.500">#71717A</Color>
    <Color x:Key="P.Color.Neutral.600">#52525B</Color>
    <Color x:Key="P.Color.Neutral.700">#3F3F46</Color>
    <Color x:Key="P.Color.Neutral.800">#27272A</Color>
    <Color x:Key="P.Color.Neutral.900">#18181B</Color>
    <Color x:Key="P.Color.Neutral.950">#09090B</Color>

    <!-- ===== NeutralDark — بصبغة بنفسجية خفيفة تناسب Brand الجديد ===== -->
    <Color x:Key="P.Color.NeutralDark.950">#0F0B1A</Color>
    <Color x:Key="P.Color.NeutralDark.900">#171227</Color>
    <Color x:Key="P.Color.NeutralDark.800">#201933</Color>
    <Color x:Key="P.Color.NeutralDark.700">#2A2140</Color>
    <Color x:Key="P.Color.NeutralDark.600">#332850</Color>
    <Color x:Key="P.Color.NeutralDark.500">#453569</Color>

    <!-- ===== Nav — نفس التدرج البنفسجي الغامق ===== -->
    <Color x:Key="P.Color.Nav.700">#2A2140</Color>
    <Color x:Key="P.Color.Nav.800">#201933</Color>
    <Color x:Key="P.Color.Nav.900">#171227</Color>
    <Color x:Key="P.Color.Nav.950">#0F0B1A</Color>

    <!-- ===== Success/Danger/Warning/Info — كما في Default عمداً (دلالة عالمية لا تتبع العلامة) ===== -->
    <Color x:Key="P.Color.Success.50">#F0FDF4</Color>
    <Color x:Key="P.Color.Success.100">#DCFCE7</Color>
    <Color x:Key="P.Color.Success.500">#22C55E</Color>
    <Color x:Key="P.Color.Success.600">#16A34A</Color>
    <Color x:Key="P.Color.Success.700">#15803D</Color>
    <Color x:Key="P.Color.Success.900">#14532D</Color>

    <Color x:Key="P.Color.Danger.50">#FEF2F2</Color>
    <Color x:Key="P.Color.Danger.100">#FEE2E2</Color>
    <Color x:Key="P.Color.Danger.500">#EF4444</Color>
    <Color x:Key="P.Color.Danger.600">#DC2626</Color>
    <Color x:Key="P.Color.Danger.700">#B91C1C</Color>
    <Color x:Key="P.Color.Danger.900">#7F1D1D</Color>

    <Color x:Key="P.Color.Warning.50">#FFFBEB</Color>
    <Color x:Key="P.Color.Warning.100">#FEF3C7</Color>
    <Color x:Key="P.Color.Warning.500">#F59E0B</Color>
    <Color x:Key="P.Color.Warning.600">#D97706</Color>
    <Color x:Key="P.Color.Warning.700">#B45309</Color>
    <Color x:Key="P.Color.Warning.900">#78350F</Color>

    <Color x:Key="P.Color.Info.50">#ECFEFF</Color>
    <Color x:Key="P.Color.Info.100">#CFFAFE</Color>
    <Color x:Key="P.Color.Info.500">#06B6D4</Color>
    <Color x:Key="P.Color.Info.600">#0891B2</Color>
    <Color x:Key="P.Color.Info.700">#0E7490</Color>
    <Color x:Key="P.Color.Info.900">#164E63</Color>

    <Color x:Key="P.Color.Folder">#E9B949</Color>

    <Color x:Key="P.Color.LoginBg">#F2F2F2</Color>

    <Color x:Key="P.Color.White">#FFFFFF</Color>
    <Color x:Key="P.Color.Black">#000000</Color>

</ResourceDictionary>
