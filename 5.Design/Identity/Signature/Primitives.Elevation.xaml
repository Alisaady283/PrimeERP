<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        L1 — حزمة الهوية "Signature". ظلال أوسع انتشاراً وأخفض عتمة من Default: الارتفاع يُقرأ من نعومة
        الحافة لا من قتامتها — الظل الداكن الضيّق هو ما يجعل الواجهة تبدو قديمة.
    -->

    <sys:Double x:Key="P.Shadow.Sm.Blur">6</sys:Double>
    <sys:Double x:Key="P.Shadow.Sm.Depth">1</sys:Double>
    <sys:Double x:Key="P.Shadow.Sm.Opacity">0.05</sys:Double>

    <sys:Double x:Key="P.Shadow.Md.Blur">16</sys:Double>
    <sys:Double x:Key="P.Shadow.Md.Depth">3</sys:Double>
    <sys:Double x:Key="P.Shadow.Md.Opacity">0.07</sys:Double>

    <sys:Double x:Key="P.Shadow.Lg.Blur">30</sys:Double>
    <sys:Double x:Key="P.Shadow.Lg.Depth">6</sys:Double>
    <sys:Double x:Key="P.Shadow.Lg.Opacity">0.10</sys:Double>

    <sys:Double x:Key="P.Shadow.Xl.Blur">48</sys:Double>
    <sys:Double x:Key="P.Shadow.Xl.Depth">10</sys:Double>
    <sys:Double x:Key="P.Shadow.Xl.Opacity">0.13</sys:Double>

</ResourceDictionary>
