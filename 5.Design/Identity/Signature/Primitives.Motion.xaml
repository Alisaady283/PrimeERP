<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        L1 — الحركة، حزمة "Default". Duration.* بالمللي ثانية (كـ sys:Double لا Duration — يُبنى Duration الفعلي
        عند الاستهلاك في L3/الأنماط عبر {Duration 0:0:0.12} حيث تُستخدم القيمة الخام، لأن Duration نوع بنيوي
        WPF لا يقبل تحويلاً ضمنياً من مورد رقمي مباشرة داخل Storyboard). Easing.* كائنات EasingFunction حقيقية
        قابلة للاستهلاك المباشر عبر DynamicResource في DoubleAnimation.EasingFunction. القيم ثابتة بين الحزم
        عمداً — الحركة ليست من الأبعاد الخمسة المطلوب تمايزها بين الهويات.
    -->

    <sys:Double x:Key="P.Duration.Fast">120</sys:Double>
    <sys:Double x:Key="P.Duration.Normal">200</sys:Double>
    <sys:Double x:Key="P.Duration.Slow">320</sys:Double>

    <CubicEase x:Key="P.Easing.Standard"    EasingMode="EaseInOut"/>
    <CubicEase x:Key="P.Easing.Decelerate"  EasingMode="EaseOut"/>
    <CubicEase x:Key="P.Easing.Accelerate"  EasingMode="EaseIn"/>

</ResourceDictionary>
