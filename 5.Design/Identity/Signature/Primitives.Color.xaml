<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- كل ألوان التطبيق. غيّر الرقم هنا فقط. "=" يعني نفس لون السطر المذكور. -->

    <!-- ===== الأساس ===== -->
    <Color x:Key="P.Color.Brand.50">#ECF0F6</Color>   <!-- تمرير على صف الجدول -->
    <Color x:Key="P.Color.Brand.100">#D4DEEB</Color>  <!-- الصف المحدد -->
    <Color x:Key="P.Color.Brand.200">#A9BDD6</Color>  <!-- حدود ملوّنة خفيفة -->
    <Color x:Key="P.Color.Brand.300">#7593BB</Color>  <!-- شريط المحدد في سايد بار داكن -->
    <Color x:Key="P.Color.Brand.400">#476C9B</Color>  <!-- تركيز الحقول -->
    <Color x:Key="P.Color.Brand.500">#234A75</Color>  <!-- احتياطي -->
    <Color x:Key="P.Color.Brand.600">#0F2442</Color>  <!-- زر اللوج ان · الأزرار الرئيسية · هيدر الجدول فاتح -->
    <Color x:Key="P.Color.Brand.700">#0C1D36</Color>  <!-- = تمرير -->
    <Color x:Key="P.Color.Brand.800">#09172A</Color>  <!-- = ضغط -->
    <Color x:Key="P.Color.Brand.900">#07121F</Color>  <!-- احتياطي -->
    <Color x:Key="P.Color.Brand.950">#040A13</Color>  <!-- احتياطي -->

    <!-- ===== المحايدات ===== -->
    <Color x:Key="P.Color.Neutral.50">#F7F9FC</Color>   <!-- الصف البديل · سايد بار فاتح -->
    <Color x:Key="P.Color.Neutral.100">#EFF2F7</Color>  <!-- خلفية الصفحة · فوتر الجدول -->
    <Color x:Key="P.Color.Neutral.200">#E1E6EF</Color>  <!-- الحدود -->
    <Color x:Key="P.Color.Neutral.300">#CBD3E0</Color>  <!-- حدود أوضح · مربع الاختيار -->
    <Color x:Key="P.Color.Neutral.400">#98A3B8</Color>  <!-- نص خافت · أيقونات سايد بار داكن -->
    <Color x:Key="P.Color.Neutral.500">#6B7794</Color>  <!-- أيقونات سايد بار فاتح -->
    <Color x:Key="P.Color.Neutral.600">#4E5975</Color>  <!-- نص ثانوي · عناوين المجموعات -->
    <Color x:Key="P.Color.Neutral.700">#3A445C</Color>  <!-- نص سايد بار فاتح -->
    <Color x:Key="P.Color.Neutral.800">#2A3245</Color>  <!-- احتياطي -->
    <Color x:Key="P.Color.Neutral.900">#1B2233</Color>  <!-- لون النص الأساسي -->
    <Color x:Key="P.Color.Neutral.950">#0F1420</Color>  <!-- احتياطي -->

    <!-- ===== أسطح داكنة — غير مستخدمة حالياً ===== -->
    <Color x:Key="P.Color.NeutralDark.950">#0A0F1A</Color>  <!-- محجوز -->
    <Color x:Key="P.Color.NeutralDark.900">#0F1524</Color>  <!-- محجوز -->
    <Color x:Key="P.Color.NeutralDark.800">#151D30</Color>  <!-- محجوز -->
    <Color x:Key="P.Color.NeutralDark.700">#1D273E</Color>  <!-- محجوز -->
    <Color x:Key="P.Color.NeutralDark.600">#26324C</Color>  <!-- محجوز -->
    <Color x:Key="P.Color.NeutralDark.500">#35425F</Color>  <!-- محجوز -->

    <!-- ===== الوضع الليلي ===== -->
    <Color x:Key="P.Color.Nav.700">#1E3D64</Color>  <!-- تمرير السايد بار · الفواصل -->
    <Color x:Key="P.Color.Nav.800">#16304F</Color>  <!-- الشريط العلوي · العنصر المحدد -->
    <Color x:Key="P.Color.Nav.900">#0F2442</Color>  <!-- سايد بار داكن · هيدر الجدول ليلي -->
    <Color x:Key="P.Color.Nav.950">#0A1930</Color>  <!-- احتياطي -->

    <!-- ===== ألوان المعنى ===== -->
    <Color x:Key="P.Color.Success.50">#EDF6F0</Color>   <!-- خلفية نجاح -->
    <Color x:Key="P.Color.Success.100">#D5EADD</Color>  <!-- = نص على داكن -->
    <Color x:Key="P.Color.Success.500">#339E6B</Color>  <!-- صح الصلاحيات -->
    <Color x:Key="P.Color.Success.600">#277F55</Color>  <!-- النجاح -->
    <Color x:Key="P.Color.Success.700">#1E6544</Color>  <!-- = تمرير -->
    <Color x:Key="P.Color.Success.900">#123A27</Color>  <!-- = خلفية داكنة -->

    <Color x:Key="P.Color.Danger.50">#FCEFEE</Color>   <!-- خلفية خطأ · صف محذّر -->
    <Color x:Key="P.Color.Danger.100">#F8DAD7</Color>  <!-- = نص على داكن -->
    <Color x:Key="P.Color.Danger.500">#D0554A</Color>  <!-- حجب الصلاحيات -->
    <Color x:Key="P.Color.Danger.600">#B03E34</Color>  <!-- الخطأ · زر الحذف -->
    <Color x:Key="P.Color.Danger.700">#8F312A</Color>  <!-- = تمرير -->
    <Color x:Key="P.Color.Danger.900">#4E1A16</Color>  <!-- = خلفية داكنة -->

    <Color x:Key="P.Color.Warning.50">#FDF5E9</Color>   <!-- خلفية تحذير · صف منبَّه -->
    <Color x:Key="P.Color.Warning.100">#F9E8CB</Color>  <!-- = نص على داكن -->
    <Color x:Key="P.Color.Warning.500">#D2941F</Color>  <!-- احتياطي -->
    <Color x:Key="P.Color.Warning.600">#B07817</Color>  <!-- التحذير -->
    <Color x:Key="P.Color.Warning.700">#8D5F12</Color>  <!-- = تمرير -->
    <Color x:Key="P.Color.Warning.900">#4B330A</Color>  <!-- = خلفية داكنة -->

    <Color x:Key="P.Color.Info.50">#EEF3FA</Color>   <!-- خلفية معلومة -->
    <Color x:Key="P.Color.Info.100">#D8E4F4</Color>  <!-- = نص على داكن -->
    <Color x:Key="P.Color.Info.500">#4A7FC1</Color>  <!-- احتياطي -->
    <Color x:Key="P.Color.Info.600">#3A66A0</Color>  <!-- المعلومة -->
    <Color x:Key="P.Color.Info.700">#2F5382</Color>  <!-- = تمرير -->
    <Color x:Key="P.Color.Info.900">#1B3049</Color>  <!-- = خلفية داكنة -->

    <Color x:Key="P.Color.Folder">#E9B949</Color>  <!-- مجلد الشجرة -->

    <Color x:Key="P.Color.LoginBg">#F7F7F7</Color>  <!-- خلفية اللوج ان وحدها -->

    <Color x:Key="P.Color.White">#FFFFFF</Color>  <!-- الجداول والبطاقات · نص فوق الكحلي -->
    <Color x:Key="P.Color.Black">#000000</Color>  <!-- الظلال -->

</ResourceDictionary>
