<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L1 — حزمة الهوية "Signature". مبنية على ممارسة 2026 السائدة في منتجات B2B الاحترافية:
        نيلي عميق يحمل البنية (تنقّل/رؤوس/إجراء رئيسي واحد)، أسطح بيضاء دافئة بدل الأبيض البارد،
        محايدات دافئة، وألوان حالة مخفوضة التشبّع محجوزة للمعنى وحده لا للزينة.
        تغيير هذا الملف وحده يعيد تلوين التطبيق كاملاً — L2/L3/L4 تشير إليه عبر DynamicResource حصراً.
    -->

    <!-- ===== الأساس — كل السلّم مبني على #0F2442 عند الدرجة 600 ===== -->
    <Color x:Key="P.Color.Brand.50">#ECF0F6</Color>
    <Color x:Key="P.Color.Brand.100">#D4DEEB</Color>
    <Color x:Key="P.Color.Brand.200">#A9BDD6</Color>
    <Color x:Key="P.Color.Brand.300">#7593BB</Color>
    <Color x:Key="P.Color.Brand.400">#476C9B</Color>
    <Color x:Key="P.Color.Brand.500">#234A75</Color>
    <Color x:Key="P.Color.Brand.600">#0F2442</Color>
    <Color x:Key="P.Color.Brand.700">#0C1D36</Color>
    <Color x:Key="P.Color.Brand.800">#09172A</Color>
    <Color x:Key="P.Color.Brand.900">#07121F</Color>
    <Color x:Key="P.Color.Brand.950">#040A13</Color>

    <!-- ===== المحايدات — رمادي مائل للأزرق، فالنص نفسه كحلي داكن لا أسود ===== -->
    <Color x:Key="P.Color.Neutral.50">#F7F9FC</Color>
    <Color x:Key="P.Color.Neutral.100">#EFF2F7</Color>
    <Color x:Key="P.Color.Neutral.200">#E1E6EF</Color>
    <Color x:Key="P.Color.Neutral.300">#CBD3E0</Color>
    <Color x:Key="P.Color.Neutral.400">#98A3B8</Color>
    <Color x:Key="P.Color.Neutral.500">#6B7794</Color>
    <Color x:Key="P.Color.Neutral.600">#4E5975</Color>
    <Color x:Key="P.Color.Neutral.700">#3A445C</Color>
    <Color x:Key="P.Color.Neutral.800">#2A3245</Color>
    <Color x:Key="P.Color.Neutral.900">#1B2233</Color>
    <Color x:Key="P.Color.Neutral.950">#0F1420</Color>

    <!-- ===== أسطح الوضع الداكن — كحلي غامق لا أسود، بخطوات واضحة بين المستويات ===== -->
    <Color x:Key="P.Color.NeutralDark.950">#0A0F1A</Color>
    <Color x:Key="P.Color.NeutralDark.900">#0F1524</Color>
    <Color x:Key="P.Color.NeutralDark.800">#151D30</Color>
    <Color x:Key="P.Color.NeutralDark.700">#1D273E</Color>
    <Color x:Key="P.Color.NeutralDark.600">#26324C</Color>
    <Color x:Key="P.Color.NeutralDark.500">#35425F</Color>

    <!-- ===== الشريط الجانبي — 900 هو #0F2442، و700 هو لون التمرير المشتقّ منه ===== -->
    <Color x:Key="P.Color.Nav.700">#1E3D64</Color>
    <Color x:Key="P.Color.Nav.800">#16304F</Color>
    <Color x:Key="P.Color.Nav.900">#0F2442</Color>
    <Color x:Key="P.Color.Nav.950">#0A1930</Color>

    <!-- ===== الحالات — محجوزة للمعنى، مخفوضة التشبّع كي لا تنافس الأساس ===== -->
    <Color x:Key="P.Color.Success.50">#EDF6F0</Color>
    <Color x:Key="P.Color.Success.100">#D5EADD</Color>
    <Color x:Key="P.Color.Success.500">#339E6B</Color>
    <Color x:Key="P.Color.Success.600">#277F55</Color>
    <Color x:Key="P.Color.Success.700">#1E6544</Color>
    <Color x:Key="P.Color.Success.900">#123A27</Color>

    <Color x:Key="P.Color.Danger.50">#FCEFEE</Color>
    <Color x:Key="P.Color.Danger.100">#F8DAD7</Color>
    <Color x:Key="P.Color.Danger.500">#D0554A</Color>
    <Color x:Key="P.Color.Danger.600">#B03E34</Color>
    <Color x:Key="P.Color.Danger.700">#8F312A</Color>
    <Color x:Key="P.Color.Danger.900">#4E1A16</Color>

    <Color x:Key="P.Color.Warning.50">#FDF5E9</Color>
    <Color x:Key="P.Color.Warning.100">#F9E8CB</Color>
    <Color x:Key="P.Color.Warning.500">#D2941F</Color>
    <Color x:Key="P.Color.Warning.600">#B07817</Color>
    <Color x:Key="P.Color.Warning.700">#8D5F12</Color>
    <Color x:Key="P.Color.Warning.900">#4B330A</Color>

    <Color x:Key="P.Color.Info.50">#EEF3FA</Color>
    <Color x:Key="P.Color.Info.100">#D8E4F4</Color>
    <Color x:Key="P.Color.Info.500">#4A7FC1</Color>
    <Color x:Key="P.Color.Info.600">#3A66A0</Color>
    <Color x:Key="P.Color.Info.700">#2F5382</Color>
    <Color x:Key="P.Color.Info.900">#1B3049</Color>

    <Color x:Key="P.Color.Folder">#E9B949</Color>

    <Color x:Key="P.Color.White">#FFFFFF</Color>
    <Color x:Key="P.Color.Black">#000000</Color>

</ResourceDictionary>
