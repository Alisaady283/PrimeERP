<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L1 — حزمة الهوية "Signature". مبنية على ممارسة 2026 السائدة في منتجات B2B الاحترافية:
        نيلي عميق يحمل البنية (تنقّل/رؤوس/إجراء رئيسي واحد)، أسطح بيضاء دافئة بدل الأبيض البارد،
        محايدات دافئة، وألوان حالة مخفوضة التشبّع محجوزة للمعنى وحده لا للزينة.
        تغيير هذا الملف وحده يعيد تلوين التطبيق كاملاً — L2/L3/L4 تشير إليه عبر DynamicResource حصراً.
    -->

    <!-- ===== الأساس — نيلي عميق ===== -->
    <Color x:Key="P.Color.Brand.50">#F1F1FB</Color>
    <Color x:Key="P.Color.Brand.100">#E1E1F7</Color>
    <Color x:Key="P.Color.Brand.200">#C5C4EF</Color>
    <Color x:Key="P.Color.Brand.300">#9E9CE2</Color>
    <Color x:Key="P.Color.Brand.400">#7C79D6</Color>
    <Color x:Key="P.Color.Brand.500">#5F5BC7</Color>
    <Color x:Key="P.Color.Brand.600">#4B46B4</Color>
    <Color x:Key="P.Color.Brand.700">#3C3893</Color>
    <Color x:Key="P.Color.Brand.800">#302D74</Color>
    <Color x:Key="P.Color.Brand.900">#26245B</Color>
    <Color x:Key="P.Color.Brand.950">#16153A</Color>

    <!-- ===== المحايدات — رمادي دافئ، وأفتحها أبيض دافئ لا بارد ===== -->
    <Color x:Key="P.Color.Neutral.50">#FAF9F7</Color>
    <Color x:Key="P.Color.Neutral.100">#F3F1EE</Color>
    <Color x:Key="P.Color.Neutral.200">#E7E4DF</Color>
    <Color x:Key="P.Color.Neutral.300">#D5D0C9</Color>
    <Color x:Key="P.Color.Neutral.400">#A9A29A</Color>
    <Color x:Key="P.Color.Neutral.500">#837B73</Color>
    <Color x:Key="P.Color.Neutral.600">#635C55</Color>
    <Color x:Key="P.Color.Neutral.700">#4A443F</Color>
    <Color x:Key="P.Color.Neutral.800">#35302C</Color>
    <Color x:Key="P.Color.Neutral.900">#221F1C</Color>
    <Color x:Key="P.Color.Neutral.950">#14120F</Color>

    <!-- ===== أسطح الوضع الداكن — مائلة قليلاً للنيلي فيبدو الوضعان من عائلة واحدة ===== -->
    <Color x:Key="P.Color.NeutralDark.950">#0E0E16</Color>
    <Color x:Key="P.Color.NeutralDark.900">#14141F</Color>
    <Color x:Key="P.Color.NeutralDark.800">#1B1B29</Color>
    <Color x:Key="P.Color.NeutralDark.700">#232235</Color>
    <Color x:Key="P.Color.NeutralDark.600">#2C2B42</Color>
    <Color x:Key="P.Color.NeutralDark.500">#3A3853</Color>

    <!-- ===== الشريط الجانبي — أعمق درجات النيلي، يحمل البنية ===== -->
    <Color x:Key="P.Color.Nav.700">#262357</Color>
    <Color x:Key="P.Color.Nav.800">#1E1C46</Color>
    <Color x:Key="P.Color.Nav.900">#171536</Color>
    <Color x:Key="P.Color.Nav.950">#100F26</Color>

    <!-- ===== الحالات — محجوزة للمعنى، مخفوضة التشبّع كي لا تنافس الأساس ===== -->
    <Color x:Key="P.Color.Success.50">#EDF6F0</Color>
    <Color x:Key="P.Color.Success.100">#D5EADD</Color>
    <Color x:Key="P.Color.Success.500">#339E6B</Color>
    <Color x:Key="P.Color.Success.600">#277F55</Color>
    <Color x:Key="P.Color.Success.700">#1E6544</Color>
    <Color x:Key="P.Color.Success.900">#123A27</Color>

    <Color x:Key="P.Color.Danger.50">#FCEFEE</Color>
    <Color x:Key="P.Color.Danger.100">#F8DAD7</Color>
    <Color x:Key="P.Color.Danger.500">#D0554A</Color>
    <Color x:Key="P.Color.Danger.600">#B03E34</Color>
    <Color x:Key="P.Color.Danger.700">#8F312A</Color>
    <Color x:Key="P.Color.Danger.900">#4E1A16</Color>

    <Color x:Key="P.Color.Warning.50">#FDF5E9</Color>
    <Color x:Key="P.Color.Warning.100">#F9E8CB</Color>
    <Color x:Key="P.Color.Warning.500">#D2941F</Color>
    <Color x:Key="P.Color.Warning.600">#B07817</Color>
    <Color x:Key="P.Color.Warning.700">#8D5F12</Color>
    <Color x:Key="P.Color.Warning.900">#4B330A</Color>

    <Color x:Key="P.Color.Info.50">#EEF3FA</Color>
    <Color x:Key="P.Color.Info.100">#D8E4F4</Color>
    <Color x:Key="P.Color.Info.500">#4A7FC1</Color>
    <Color x:Key="P.Color.Info.600">#3A66A0</Color>
    <Color x:Key="P.Color.Info.700">#2F5382</Color>
    <Color x:Key="P.Color.Info.900">#1B3049</Color>

    <Color x:Key="P.Color.Folder">#E9B949</Color>

    <Color x:Key="P.Color.White">#FFFFFF</Color>
    <Color x:Key="P.Color.Black">#000000</Color>

</ResourceDictionary>
