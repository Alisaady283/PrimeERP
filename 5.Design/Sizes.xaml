<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- مقاسات النظام -->

    <!-- Font -->
    <FontFamily x:Key="P.Font.Family.Primary">Dubai, Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="P.Font.Family.Numeric">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="P.Font.Family.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="P.Font.Family.Display">Dubai Medium, Dubai, Segoe UI, Tahoma</FontFamily>
    <sys:Double x:Key="P.Font.Size.100">11</sys:Double>
    <sys:Double x:Key="P.Font.Size.200">12</sys:Double>
    <sys:Double x:Key="P.Font.Size.300">13</sys:Double>
    <sys:Double x:Key="P.Font.Size.400">14</sys:Double>
    <sys:Double x:Key="P.Font.Size.500">15</sys:Double>
    <sys:Double x:Key="P.Font.Size.600">17</sys:Double>
    <sys:Double x:Key="P.Font.Size.700">20</sys:Double>
    <sys:Double x:Key="P.Font.Size.800">24</sys:Double>
    <sys:Double x:Key="P.Font.Size.900">30</sys:Double>
    <FontWeight x:Key="P.Font.Weight.Normal">Normal</FontWeight>
    <FontWeight x:Key="P.Font.Weight.Medium">Medium</FontWeight>
    <FontWeight x:Key="P.Font.Weight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="P.Font.Weight.Bold">Bold</FontWeight>
    <sys:Double x:Key="P.Line.Tight">1.25</sys:Double>
    <sys:Double x:Key="P.Line.Normal">1.5</sys:Double>
    <sys:Double x:Key="P.Line.Relaxed">1.65</sys:Double>

    <!-- Spacing -->
    <sys:Double x:Key="P.Space.0">0</sys:Double>
    <sys:Double x:Key="P.Space.1">4</sys:Double>
    <sys:Double x:Key="P.Space.2">8</sys:Double>
    <sys:Double x:Key="P.Space.3">12</sys:Double>
    <sys:Double x:Key="P.Space.4">16</sys:Double>
    <sys:Double x:Key="P.Space.5">20</sys:Double>
    <sys:Double x:Key="P.Space.6">24</sys:Double>
    <sys:Double x:Key="P.Space.8">32</sys:Double>
    <sys:Double x:Key="P.Space.10">40</sys:Double>
    <sys:Double x:Key="P.Space.12">48</sys:Double>
    <sys:Double x:Key="P.Space.16">64</sys:Double>
    <Thickness x:Key="P.Space.4.Uniform">16</Thickness>
    <Thickness x:Key="P.Space.1.Top">0,4,0,0</Thickness>
    <Thickness x:Key="P.Space.1.Bottom">0,0,0,4</Thickness>
    <Thickness x:Key="P.Space.1.Right">0,0,4,0</Thickness>
    <Thickness x:Key="P.Space.2.Left">8,0,0,0</Thickness>
    <Thickness x:Key="P.Space.2.Top">0,8,0,0</Thickness>
    <Thickness x:Key="P.Space.2.Bottom">0,0,0,8</Thickness>
    <Thickness x:Key="P.Space.2.Right">0,0,8,0</Thickness>
    <Thickness x:Key="P.Space.2.Uniform">8</Thickness>
    <Thickness x:Key="P.Space.3.Uniform">12</Thickness>
    <Thickness x:Key="P.Space.3.Right">0,0,12,0</Thickness>
    <Thickness x:Key="P.Space.4.Top">0,16,0,0</Thickness>
    <Thickness x:Key="P.Space.4.Bottom">0,0,0,16</Thickness>
    <Thickness x:Key="P.Space.5.Bottom">0,0,0,20</Thickness>
    <Thickness x:Key="P.Space.4.Horizontal">16,0</Thickness>
    <GridLength x:Key="P.Space.4.Column">16</GridLength>

    <!-- Radius -->
    <CornerRadius x:Key="P.Radius.None">0</CornerRadius>
    <CornerRadius x:Key="P.Radius.Sm">5</CornerRadius>
    <CornerRadius x:Key="P.Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="P.Radius.Lg">12</CornerRadius>
    <CornerRadius x:Key="P.Radius.Xl">18</CornerRadius>
    <CornerRadius x:Key="P.Radius.Full">999</CornerRadius>
    <sys:Double x:Key="P.Border.Thin">1</sys:Double>
    <sys:Double x:Key="P.Border.Medium">1.5</sys:Double>
    <sys:Double x:Key="P.Border.Thick">2</sys:Double>

    <!-- Shadow -->
    <sys:Double x:Key="P.Shadow.Sm.Blur">6</sys:Double>
    <sys:Double x:Key="P.Shadow.Sm.Depth">1</sys:Double>
    <sys:Double x:Key="P.Shadow.Sm.Opacity">0.05</sys:Double>
    <sys:Double x:Key="P.Shadow.Md.Blur">16</sys:Double>
    <sys:Double x:Key="P.Shadow.Md.Depth">3</sys:Double>
    <sys:Double x:Key="P.Shadow.Md.Opacity">0.07</sys:Double>
    <sys:Double x:Key="P.Shadow.Lg.Blur">30</sys:Double>
    <sys:Double x:Key="P.Shadow.Lg.Depth">6</sys:Double>
    <sys:Double x:Key="P.Shadow.Lg.Opacity">0.10</sys:Double>
    <sys:Double x:Key="P.Shadow.Xl.Blur">48</sys:Double>
    <sys:Double x:Key="P.Shadow.Xl.Depth">10</sys:Double>
    <sys:Double x:Key="P.Shadow.Xl.Opacity">0.13</sys:Double>

    <!-- Badge -->
    <sys:Double x:Key="C.Badge.IconSize">11</sys:Double>

    <!-- قياساتٌ يتقاسمها أكثر من مكوّن -->
    <sys:Double x:Key="C.IconButton.Size">34</sys:Double>
    <sys:Double x:Key="C.Control.Size.Xs">24</sys:Double>
    <sys:Double x:Key="C.Stepper.Height">18</sys:Double>
    <Thickness  x:Key="C.Input.AdornmentMargin">2,4,0,0</Thickness>
    <Thickness  x:Key="C.Cell.Padding">10,5</Thickness>
    <Thickness  x:Key="C.Cell.Gap">0,0,6,0</Thickness>
    <Thickness  x:Key="C.Field.Gap">0,0,10,0</Thickness>
    <Thickness  x:Key="C.Field.GapSm">0,0,8,0</Thickness>
    <Thickness  x:Key="C.Section.Gap">0,10,0,0</Thickness>
    <Thickness  x:Key="C.Section.Indent">18,0,0,0</Thickness>
    <Thickness  x:Key="C.Bar.Padding">10,6</Thickness>
    <sys:Double x:Key="C.Overlay.Width">320</sys:Double>
    <sys:Double x:Key="C.Glyph.Size">14</sys:Double>

    <!-- Button -->
    <sys:Double x:Key="C.Button.Pressed.Opacity">0.85</sys:Double>
    <sys:Double x:Key="C.Button.Disabled.Opacity">0.68</sys:Double>
    <sys:Double x:Key="C.Button.Height.Sm">32</sys:Double>
    <sys:Double x:Key="C.Button.Height.Md">36</sys:Double>
    <sys:Double x:Key="C.Button.Height.Lg">40</sys:Double>
    <sys:Double x:Key="C.Button.IconSize.Sm">14</sys:Double>
    <sys:Double x:Key="C.Button.IconSize.Md">16</sys:Double>
    <sys:Double x:Key="C.Button.IconSize.Lg">18</sys:Double>

    <!-- Dialog -->
    <Thickness x:Key="C.Dialog.Gutter">16</Thickness>
    <sys:Double x:Key="C.Dialog.Width.Sm">420</sys:Double>
    <sys:Double x:Key="C.Dialog.Width.Md">560</sys:Double>
    <sys:Double x:Key="C.Dialog.Width.Lg">760</sys:Double>
    <sys:Double x:Key="C.Dialog.Width.Xl">1000</sys:Double>
    <sys:Double x:Key="C.Dialog.Width.Xxl">1260</sys:Double>

    <!-- Grid -->
    <sys:Double      x:Key="C.Grid.Empty.IconSize">40</sys:Double>
    <Thickness       x:Key="C.Grid.Empty.Margin">0,44,0,0</Thickness>
    <sys:Double x:Key="C.Grid.Header.Height">44</sys:Double>
    <Thickness  x:Key="C.Grid.Header.BorderBottomThickness">0,0,0,1</Thickness>
    <sys:Double x:Key="C.Grid.Row.Height">40</sys:Double>
    <Thickness  x:Key="C.Grid.Row.Selected.BorderThickness">0,0,3,0</Thickness>
    <sys:Double x:Key="C.Grid.Footer.Height">36</sys:Double>
    <Thickness  x:Key="C.Grid.Footer.BorderThickness">1,0,1,2</Thickness>
    <sys:Double x:Key="C.Grid.RowHeader.Width">40</sys:Double>
    <CornerRadius x:Key="C.Grid.Container.Radius">10</CornerRadius>
    <Thickness  x:Key="C.Grid.Container.BorderThickness">1</Thickness>

    <!-- Icon -->
    <sys:Double x:Key="C.Icon.Size.Xs">12</sys:Double>
    <sys:Double x:Key="C.Icon.Size.Sm">14</sys:Double>
    <sys:Double x:Key="C.Icon.Size.Md">18</sys:Double>
    <sys:Double x:Key="C.Icon.Size.Lg">22</sys:Double>
    <sys:Double x:Key="C.Icon.Stroke">1.75</sys:Double>

    <!-- Input -->
    <Thickness       x:Key="C.Input.Focus.BorderWidth">2</Thickness>
    <sys:Double      x:Key="C.Input.Disabled.Opacity">0.5</sys:Double>
    <sys:Double      x:Key="C.Input.Label.Gap">4</sys:Double>
    <sys:Double x:Key="C.Input.Height">36</sys:Double>
    <sys:Double x:Key="C.Input.Height.Sm">32</sys:Double>
    <sys:Double    x:Key="C.Input.PaddingX">10</sys:Double>
    <Thickness     x:Key="C.Input.Padding">10,0</Thickness>
    <Thickness     x:Key="C.Input.BorderThickness">1</Thickness>
    <Thickness     x:Key="C.Input.Label.Gap.Margin">0,0,0,4</Thickness>

    <!-- Pagination -->
    <sys:Double      x:Key="C.Pagination.Height">36</sys:Double>
    <sys:Double      x:Key="C.Pagination.Info.FontSize">12</sys:Double>
    <sys:Double      x:Key="C.Pagination.Button.Size">34</sys:Double>
    <sys:Double      x:Key="C.Pagination.Button.Radius">6</sys:Double>
    <sys:Double      x:Key="C.Pagination.Button.Gap">4</sys:Double>
    <sys:Double      x:Key="C.Pagination.Button.FontSize">13</sys:Double>

</ResourceDictionary>
