<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        نفس مفاتيح Semantic.Light.xaml بالضبط، بلا استثناء — أي مفتاح ناقص هنا = لون فاتح يظهر خطأً وسط الوضع
        الداكن. IdentityService يضيف هذا الملف فوق Semantic.Light.xaml فيُعيد تعريف كل مفتاح بقيمته الداكنة؛
        القيمة دائماً DynamicResource لمفتاح P.Color.* من حزمة الهوية الحالية (الوضع الداكن يبقى قابلاً للتبديل
        فوق أي حزمة هوية — بنفسجي داكن أو أزرق داكن كلاهما يستهلك P.Color.NeutralDark.* نفسه).
    -->

    <!-- ===== الأسطح — الإضاءة تزيد مع الارتفاع (لا الظل) ===== -->
    <SolidColorBrush x:Key="SurfaceCanvas"     Color="{DynamicResource P.Color.NeutralDark.950}"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="{DynamicResource P.Color.NeutralDark.900}"/>
    <SolidColorBrush x:Key="SurfaceDefault"    Color="{DynamicResource P.Color.NeutralDark.800}"/>
    <SolidColorBrush x:Key="SurfaceRaised"     Color="{DynamicResource P.Color.NeutralDark.700}"/>
    <SolidColorBrush x:Key="SurfaceOverlay"    Color="{DynamicResource P.Color.NeutralDark.600}"/>
    <SolidColorBrush x:Key="SurfaceSunken"     Color="{DynamicResource P.Color.NeutralDark.950}"/>

    <!-- ===== الحدود ===== -->
    <SolidColorBrush x:Key="OutlineSubtle"  Color="{DynamicResource P.Color.NeutralDark.700}"/>
    <SolidColorBrush x:Key="OutlineDefault" Color="{DynamicResource P.Color.NeutralDark.600}"/>
    <SolidColorBrush x:Key="OutlineStrong"  Color="{DynamicResource P.Color.NeutralDark.500}"/>
    <SolidColorBrush x:Key="OutlineFocus"   Color="{DynamicResource P.Color.Brand.400}"/>

    <!-- ===== النصوص — لا أبيض نقي (إجهاد بصري) ===== -->
    <SolidColorBrush x:Key="TextPrimary"   Color="{DynamicResource P.Color.Neutral.100}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource P.Color.Neutral.300}"/>
    <SolidColorBrush x:Key="TextTertiary"  Color="{DynamicResource P.Color.Neutral.400}"/>
    <SolidColorBrush x:Key="TextMuted"     Color="{DynamicResource P.Color.Neutral.500}"/>
    <SolidColorBrush x:Key="TextOnBrand"   Color="{DynamicResource P.Color.White}"/>
    <SolidColorBrush x:Key="TextLink"      Color="{DynamicResource P.Color.Brand.400}"/>

    <!-- ===== العلامة — أفتح في الداكن لتحقيق التباين ===== -->
    <SolidColorBrush x:Key="BrandDefault"    Color="{DynamicResource P.Color.Brand.500}"/>
    <SolidColorBrush x:Key="BrandHover"      Color="{DynamicResource P.Color.Brand.400}"/>
    <SolidColorBrush x:Key="BrandActive"     Color="{DynamicResource P.Color.Brand.600}"/>
    <SolidColorBrush x:Key="BrandSoft"       Color="{DynamicResource P.Color.NeutralDark.700}"/>
    <SolidColorBrush x:Key="BrandSoftBorder" Color="{DynamicResource P.Color.Brand.700}"/>
    <SolidColorBrush x:Key="BrandSoftText"   Color="{DynamicResource P.Color.Brand.300}"/>

    <!-- ===== هيدر/صفوف الجدول (AppDataGrid) — قيم خاصة بالوضع، راجع C.Grid.* في Tokens.Grid.xaml ===== -->
    <SolidColorBrush x:Key="GridHeaderBg" Color="{DynamicResource P.Color.NeutralDark.700}"/>
    <SolidColorBrush x:Key="GridHeaderFg" Color="{DynamicResource P.Color.Neutral.100}"/>
    <SolidColorBrush x:Key="GridRowAltBg" Color="{DynamicResource P.Color.Nav.700}"/>

    <SolidColorBrush x:Key="TreeFolder" Color="{DynamicResource P.Color.Folder}"/>

    <!-- ===== الحالات — الناعم يصبح داكناً مشبعاً ===== -->
    <SolidColorBrush x:Key="Success"         Color="{DynamicResource P.Color.Success.500}"/>
    <SolidColorBrush x:Key="SuccessHover"    Color="{DynamicResource P.Color.Success.600}"/>
    <SolidColorBrush x:Key="SuccessSoft"     Color="{DynamicResource P.Color.Success.900}"/>
    <SolidColorBrush x:Key="SuccessSoftText" Color="{DynamicResource P.Color.Success.100}"/>

    <SolidColorBrush x:Key="Danger"         Color="{DynamicResource P.Color.Danger.500}"/>
    <SolidColorBrush x:Key="DangerHover"    Color="{DynamicResource P.Color.Danger.600}"/>
    <SolidColorBrush x:Key="DangerSoft"     Color="{DynamicResource P.Color.Danger.900}"/>
    <SolidColorBrush x:Key="DangerSoftText" Color="{DynamicResource P.Color.Danger.100}"/>

    <SolidColorBrush x:Key="Warning"         Color="{DynamicResource P.Color.Warning.500}"/>
    <SolidColorBrush x:Key="WarningHover"    Color="{DynamicResource P.Color.Warning.600}"/>
    <SolidColorBrush x:Key="WarningSoft"     Color="{DynamicResource P.Color.Warning.900}"/>
    <SolidColorBrush x:Key="WarningSoftText" Color="{DynamicResource P.Color.Warning.100}"/>

    <SolidColorBrush x:Key="Info"         Color="{DynamicResource P.Color.Info.500}"/>
    <SolidColorBrush x:Key="InfoHover"    Color="{DynamicResource P.Color.Info.600}"/>
    <SolidColorBrush x:Key="InfoSoft"     Color="{DynamicResource P.Color.Info.900}"/>
    <SolidColorBrush x:Key="InfoSoftText" Color="{DynamicResource P.Color.Info.100}"/>

    <!-- ===== التنقل — الـ Sidebar يصبح أغمق من المحتوى ===== -->
    <SolidColorBrush x:Key="NavSurface"       Color="{DynamicResource P.Color.Nav.950}"/>
    <SolidColorBrush x:Key="NavSurfaceRaised" Color="{DynamicResource P.Color.Nav.800}"/>
    <SolidColorBrush x:Key="NavText"          Color="{DynamicResource P.Color.Neutral.200}"/>
    <SolidColorBrush x:Key="NavTextHover"     Color="{DynamicResource P.Color.White}"/>
    <SolidColorBrush x:Key="NavTextSelected"  Color="{DynamicResource P.Color.White}"/>
    <SolidColorBrush x:Key="NavIcon"          Color="{DynamicResource P.Color.Neutral.400}"/>
    <SolidColorBrush x:Key="NavIconHover"     Color="{DynamicResource P.Color.Neutral.200}"/>
    <SolidColorBrush x:Key="NavIconSelected"  Color="{DynamicResource P.Color.White}"/>
    <SolidColorBrush x:Key="NavHover"         Color="{DynamicResource P.Color.NeutralDark.800}"/>
    <SolidColorBrush x:Key="NavSelected"      Color="{DynamicResource P.Color.Brand.700}"/>
    <SolidColorBrush x:Key="NavSelectedBar"   Color="{DynamicResource P.Color.Brand.400}"/>
    <SolidColorBrush x:Key="NavSectionLabel"  Color="{DynamicResource P.Color.Neutral.600}"/>
    <SolidColorBrush x:Key="NavDivider"       Color="{DynamicResource P.Color.NeutralDark.800}"/>

    <!-- ===== الشريط العلوي ===== -->
    <SolidColorBrush x:Key="TopBarSurface"   Color="{DynamicResource P.Color.NeutralDark.800}"/>
    <SolidColorBrush x:Key="TopBarBorder"    Color="{DynamicResource P.Color.NeutralDark.600}"/>
    <SolidColorBrush x:Key="TopBarText"      Color="{DynamicResource P.Color.Neutral.100}"/>
    <SolidColorBrush x:Key="TopBarIcon"      Color="{DynamicResource P.Color.Neutral.400}"/>
    <SolidColorBrush x:Key="TopBarIconHover" Color="{DynamicResource P.Color.Brand.400}"/>

    <!-- ===== الجداول — لا أزرق في رأس الجدول بالداكن (يبهر) ===== -->
    <SolidColorBrush x:Key="TableHeaderBg"        Color="{DynamicResource P.Color.NeutralDark.700}"/>
    <SolidColorBrush x:Key="TableHeaderText"      Color="{DynamicResource P.Color.Neutral.100}"/>
    <SolidColorBrush x:Key="TableHeaderBorder"    Color="{DynamicResource P.Color.NeutralDark.600}"/>
    <SolidColorBrush x:Key="TableRowBg"           Color="{DynamicResource P.Color.NeutralDark.800}"/>
    <SolidColorBrush x:Key="TableRowAltBg"        Color="{DynamicResource P.Color.NeutralDark.700}"/>
    <SolidColorBrush x:Key="TableRowHover"        Color="{DynamicResource P.Color.NeutralDark.700}"/>
    <SolidColorBrush x:Key="TableRowSelected"     Color="{DynamicResource P.Color.NeutralDark.600}"/>
    <SolidColorBrush x:Key="TableRowSelectedText" Color="{DynamicResource P.Color.Neutral.100}"/>
    <SolidColorBrush x:Key="TableBorder"          Color="{DynamicResource P.Color.NeutralDark.700}"/>
    <SolidColorBrush x:Key="TableFooterBg"        Color="{DynamicResource P.Color.NeutralDark.900}"/>

    <!-- ===== التفاعل ===== -->
    <SolidColorBrush x:Key="StateHoverOverlay"   Color="{DynamicResource P.Color.White}" Opacity="0.06"/>
    <SolidColorBrush x:Key="StatePressedOverlay" Color="{DynamicResource P.Color.White}" Opacity="0.10"/>
    <sys:Double x:Key="StateDisabledOpacity">0.40</sys:Double>
    <SolidColorBrush x:Key="StateSelectedBg" Color="{DynamicResource P.Color.NeutralDark.600}"/>
    <SolidColorBrush x:Key="FocusRing"       Color="{DynamicResource P.Color.Brand.400}"/>
    <sys:Double x:Key="FocusRingWidth">2</sys:Double>

    <!-- ===== الظلال — معطَّلة فعلياً في الداكن (العمق يُعبَّر عنه بالإضاءة لا الظل)؛ Opacity=0 حرفياً هنا
         قرار متعمَّد لا إغفال — راجع القاعدة أعلاه. Blur/Depth تبقى من L1 (P.Shadow.*) رغم عدم ظهورها بصرياً،
         فقط لتفادي تكرار الرقم بلا داعٍ؛ القطع تستخدم OutlineDefault على الأسطح المرتفعة بدلاً من الظل. ===== -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="{DynamicResource P.Shadow.Sm.Blur}" ShadowDepth="{DynamicResource P.Shadow.Sm.Depth}" Opacity="0" Color="{DynamicResource P.Color.Black}" Direction="270"/>
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="{DynamicResource P.Shadow.Md.Blur}" ShadowDepth="{DynamicResource P.Shadow.Md.Depth}" Opacity="0" Color="{DynamicResource P.Color.Black}" Direction="270"/>
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="{DynamicResource P.Shadow.Lg.Blur}" ShadowDepth="{DynamicResource P.Shadow.Lg.Depth}" Opacity="0" Color="{DynamicResource P.Color.Black}" Direction="270"/>
    <DropShadowEffect x:Key="ShadowXl" BlurRadius="{DynamicResource P.Shadow.Xl.Blur}" ShadowDepth="{DynamicResource P.Shadow.Xl.Depth}" Opacity="0" Color="{DynamicResource P.Color.Black}" Direction="270"/>

    <SolidColorBrush x:Key="Scrim" Color="{DynamicResource P.Color.Black}" Opacity="0.55"/>

</ResourceDictionary>
