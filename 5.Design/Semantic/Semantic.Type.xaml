<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L2 — أدوار طباعية دلالية. كل مفتاح يجمع عائلة+حجم+وزن لدور استخدام واحد، بدل أن تختار كل قطعة أرقاماً
        خاماً من P.Font.* بنفسها. صفر قيمة حرفية — كل شيء DynamicResource لمفتاح P.* من حزمة الهوية الحالية.
        لا فرق فاتح/داكن هنا (الطباعة ليست لونية) — ملف واحد يخدم كل الأوضاع.

        ⚠️ ارتفاع السطر (P.Line.Tight/Normal/Relaxed، Primitives.Motion.xaml) عمداً غير مربوط هنا كـ Setter:
        هو نسبة (مضاعِف) لا بكسل مطلق، وTextBlock.LineHeight يحتاج بكسل — حسابه (FontSize × النسبة) يتطلب
        Binding حيّ مع MultiValueConverter لا مجرد DynamicResource واحد (WPF لا يدعم عمليات حسابية بين مورَدين
        داخل Setter مباشرة). القيمة تبقى متاحة كمصدر حقيقي لأي مستهلك يحسبها بنفسه (مثال: قوالب الطباعة)
        بدل تجميد ارتفاع سطر حرفي هنا بلا معنى تجريبي (ليس من الأبعاد الخمسة المُختبَرة في IdentityServiceTests).
    -->

    <Style x:Key="S.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.400}"/>
        <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.Normal}"/>
    </Style>

    <Style x:Key="S.Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
        <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.Medium}"/>
    </Style>

    <Style x:Key="S.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Display}"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.700}"/>
        <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.SemiBold}"/>
    </Style>

    <Style x:Key="S.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.100}"/>
        <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.Normal}"/>
    </Style>

    <!-- الأرقام/المبالغ: Mono + SemiBold — اصطفاف عمودي في الجداول (قاعدة موثّقة سابقاً في Typography.xaml القديم). -->
    <Style x:Key="S.Text.Numeric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.400}"/>
        <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.SemiBold}"/>
    </Style>

    <Style x:Key="S.Text.Code" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.300}"/>
        <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.Normal}"/>
    </Style>

</ResourceDictionary>
