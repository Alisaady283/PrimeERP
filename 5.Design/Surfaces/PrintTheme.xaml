<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        ثيم الطباعة — منطقة تصميم مستقلة، لا تُدمَج في App.Resources إطلاقاً. يحمّلها PrintService بنفسه
        (ResourceDictionary مستقلة تُضاف لموارد FlowDocument وقت البناء فقط). ثابتة دائماً (قيم الوضع الفاتح
        من Colors.xaml حرفياً) — لو قرأ القالب من Themes/*.xaml بدل هذا الملف، ستطبع الأوراق بخلفية سوداء
        عند تفعيل الوضع الداكن في التطبيق. نفس المجموعات الدلالية الست الموجودة في Themes وExportTheme، بنفس القيم.
    -->

    <FontFamily x:Key="FontFamilyPrimary">Segoe UI, Tahoma, Arial</FontFamily>

    <sys:Double x:Key="FontSizeXs">9</sys:Double>
    <sys:Double x:Key="FontSizeSm">10</sys:Double>
    <sys:Double x:Key="FontSizeBase">11</sys:Double>
    <sys:Double x:Key="FontSizeMd">13</sys:Double>
    <sys:Double x:Key="FontSizeLg">16</sys:Double>
    <sys:Double x:Key="FontSizeXl">20</sys:Double>

    <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <!-- ===== أساس الصفحة ===== -->
    <SolidColorBrush x:Key="SurfaceDefault" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#475569"/>
    <SolidColorBrush x:Key="TextMuted"      Color="#94A3B8"/>
    <SolidColorBrush x:Key="OutlineDefault" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="OutlineSubtle" Color="#EDF1F6"/>  <!-- شبكة الجداول: أخفّ من الحدّ العام -->
    <SolidColorBrush x:Key="HeaderBackground" Color="#F1F5F9"/>

    <!-- ===== المجموعات الدلالية الست — Solid / Soft / SoftText (لا Hover ولا حالة مرور على ورق) ===== -->
    <SolidColorBrush x:Key="NeutralSolid"    Color="#64748B"/>
    <SolidColorBrush x:Key="NeutralSoft"     Color="#F1F5F9"/>
    <SolidColorBrush x:Key="NeutralSoftText" Color="#475569"/>

    <SolidColorBrush x:Key="InfoSolid"    Color="#0891B2"/>
    <SolidColorBrush x:Key="InfoSoft"     Color="#ECFEFF"/>
    <SolidColorBrush x:Key="InfoSoftText" Color="#0E7490"/>

    <SolidColorBrush x:Key="BrandSolid"    Color="#0F2442"/>
    <SolidColorBrush x:Key="BrandSoft"     Color="#EEF2F7"/>
    <SolidColorBrush x:Key="BrandSoftText" Color="#1E3D64"/>
    <SolidColorBrush x:Key="OnBrandText"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnBrandMuted"  Color="#C9D6E6"/>

    <SolidColorBrush x:Key="SuccessSolid"    Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessSoft"     Color="#F0FDF4"/>
    <SolidColorBrush x:Key="SuccessSoftText" Color="#15803D"/>

    <SolidColorBrush x:Key="WarningSolid"    Color="#D97706"/>
    <SolidColorBrush x:Key="WarningSoft"     Color="#FFFBEB"/>
    <SolidColorBrush x:Key="WarningSoftText" Color="#B45309"/>

    <SolidColorBrush x:Key="DangerSolid"    Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoft"     Color="#FEF2F2"/>
    <SolidColorBrush x:Key="DangerSoftText" Color="#B91C1C"/>

</ResourceDictionary>
