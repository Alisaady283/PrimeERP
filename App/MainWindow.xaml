<Window x:Class="PrimeERP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource SurfaceCanvas}"
        xmlns:shell="clr-namespace:PrimeERP.UI.Components.Shell"
        Title="PrimeERP"
        WindowState="Maximized"
        MinWidth="1024"
        MinHeight="600"
        FlowDirection="RightToLeft">

    <shell:AppShell x:Name="shell"
                     NavigationRequested="Shell_NavigationRequested"
                     UpdateRequested="Shell_UpdateRequested"
                     LogoutRequested="Shell_LogoutRequested"
                     PasswordChangeRequested="Shell_PasswordChangeRequested"
                     LanguageToggled="Shell_LanguageToggled"/>
</Window>
