<Window x:Class="PrimeERP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:PrimeERP.UI.Components.Shell"
        Title="PrimeERP"
        WindowState="Maximized"
        MinWidth="1024"
        MinHeight="600"
        FlowDirection="RightToLeft">

    <!-- المرحلة H — القاعدة المعمارية: لا منطق ولا عنصر مرئي أصلي في Window، تجميع قطع فقط. AppShell وحدها. -->
    <shell:AppShell x:Name="shell"
                     NavigationRequested="Shell_NavigationRequested"
                     LogoutRequested="Shell_LogoutRequested"/>
</Window>
