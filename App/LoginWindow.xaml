<Window x:Class="PrimeERP.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inputs="clr-namespace:PrimeERP.UI.Components.Inputs"
        Title="{DynamicResource Str.AppName}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        SizeToContent="Height"
        Width="380"
        Background="{DynamicResource SurfaceCanvas}">

    <Border Padding="{DynamicResource P.Space.4.Uniform}">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str.AppName}" HorizontalAlignment="Center"
                       FontSize="{DynamicResource P.Font.Size.700}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource P.Space.4.Bottom}"/>

            <inputs:AppTextBox x:Name="txtUsername" Label="{DynamicResource Str.Login.Username}" IsRequired="True"
                                Margin="{DynamicResource P.Space.2.Bottom}"/>

            <inputs:AppPasswordBox x:Name="txtPassword" Label="{DynamicResource Str.Login.Password}" IsRequired="True"
                                    KeyDown="txtPassword_KeyDown" Margin="{DynamicResource P.Space.2.Bottom}"/>

            <TextBlock x:Name="txtError" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="{DynamicResource P.Space.2.Bottom}"/>

            <Button x:Name="btnLogin" Content="{DynamicResource Str.Login.Submit}" Style="{StaticResource AppButtonStyle}"
                    HorizontalAlignment="Stretch" Click="btnLogin_Click"/>
        </StackPanel>
    </Border>
</Window>
