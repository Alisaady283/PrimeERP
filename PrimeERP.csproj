<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- PrimeERP.Tests مشروع منفصل بملف .csproj خاص به — يُستثنى من جلب هذا المشروع الضمني. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PrimeERP.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 6.UI/DevTools (Gallery) أداة تطوير للمراجعة البصرية فقط، بلا مستهلك من مسار حي — تُستثنى من بناء
       Release كي لا تُشحن للمستخدم النهائي (راجع R9، ARCHITECTURE.md). -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="6.UI\DevTools\**\*.cs" />
    <Page Remove="6.UI\DevTools\**\*.xaml" />
    <None Include="6.UI\DevTools\**\*.xaml" />
  </ItemGroup>

  <!-- مشروع WPF المؤقّت (‎*_wpftmp.csproj‎) يُنشَأ أثناء ترجمة XAML ويُحذَف عند نجاح البناء، فيبقى متخلّفاً
       كلما انقطع البناء. عندها يرى dotnet run مشروعين ويتوقّف. التنظيف بعد نجاح البناء لا قبله: حينها
       لا يكون أي مشروع مؤقّت قيد الاستخدام، فلا يُحذف واحد أثناء ترجمته. -->
  <Target Name="RemoveStaleWpfTempProjects" AfterTargets="Build"
          Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ItemGroup>
      <_StaleWpfTemp Include="$(MSBuildProjectDirectory)\*_wpftmp.csproj" />
    </ItemGroup>
    <Delete Files="@(_StaleWpfTemp)" ContinueOnError="true" />
  </Target>

</Project>