<Window x:Class="PrimeERP.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تثبيت PrimeERP" Height="380" Width="520"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="#F7F8FA" ResizeMode="NoResize" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PrimeERP" FontSize="26" FontWeight="Bold" Foreground="#16324F"/>
        <TextBlock Grid.Row="1" Text="أدخل سريال الترخيص لتنزيل نسختك" Margin="0,4,0,18" Foreground="#5A6B7B"/>

        <TextBlock Grid.Row="2" Text="السريال"/>
        <TextBox   Grid.Row="3" x:Name="serialBox" Height="34" FontSize="16" Padding="6,4"
                   CharacterCasing="Upper" Margin="0,4,0,14"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="مجلد التثبيت" VerticalAlignment="Center"/>
            <TextBox   x:Name="folderBox" Width="300" Height="28" Margin="8,0" Padding="6,2"/>
            <Button    x:Name="browseButton" Content="استعراض" Padding="10,2" Click="Browse_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
            <ProgressBar x:Name="progress" Height="10" Margin="0,16,0,6"/>
            <TextBlock   x:Name="statusText" Foreground="#5A6B7B" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Grid.Row="6" x:Name="installButton" Content="تثبيت" Height="38" FontSize="15"
                Background="#16324F" Foreground="White" BorderThickness="0" Click="Install_Click"/>
    </Grid>
</Window>
