<UserControl x:Class="PrimeERP.UI.Components.Shell.AppTopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:PrimeERP.UI.Components.Display"
             xmlns:actionsctl="clr-namespace:PrimeERP.UI.Components.Actions"
             xmlns:conv="clr-namespace:PrimeERP.UI.Converters">

    <!-- قشرة AppTopBar -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceDefault}" BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="0,0,0,1">
        <Grid MinHeight="60" Margin="{DynamicResource P.Space.4.Horizontal}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <actionsctl:AppIconButton Grid.Column="0" x:Name="btnToggleSidebar" Icon="{StaticResource IconMenu}"
                                       TooltipText="{DynamicResource Str.TopBar.ToggleSidebar}" Click="btnToggleSidebar_Click" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <display:AppBreadcrumb x:Name="breadcrumb"/>
                <TextBlock x:Name="pageTitleText" FontSize="{DynamicResource P.Font.Size.600}"
                           FontWeight="{DynamicResource P.Font.Weight.Bold}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>

            <Border Grid.Column="2"/>

            <TextBlock Grid.Column="3" x:Name="companyText" VerticalAlignment="Center" Margin="0,0,18,0"
                       FontSize="{DynamicResource P.Font.Size.300}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextSecondary}"/>

            <StackPanel Grid.Column="4" x:Name="datePanel" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock x:Name="gregorianText" HorizontalAlignment="Left"
                           FontSize="{DynamicResource P.Font.Size.200}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="hijriText" HorizontalAlignment="Left"
                           FontSize="{DynamicResource P.Font.Size.200}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>

            <Grid Grid.Column="5" Margin="{DynamicResource C.Field.Gap}">
                <Border x:Name="notifBadge" Background="{DynamicResource Danger}" CornerRadius="7"
                        Width="{DynamicResource C.Glyph.Size}" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="notifBadgeText" FontSize="9" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <ContentPresenter Grid.Column="6" x:Name="actionsPresenter" VerticalAlignment="Center" Margin="{DynamicResource C.Field.Gap}"/>

            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="{DynamicResource C.IconButton.Size}" Height="{DynamicResource C.IconButton.Size}" CornerRadius="17" Background="{DynamicResource BrandDefault}" Margin="{DynamicResource C.Field.GapSm}">
                    <TextBlock x:Name="userInitialText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                               FontFamily="{DynamicResource P.Font.Family.Primary}"/>
                </Border>
                <actionsctl:AppDropdownButton x:Name="userMenu" ItemSelected="userMenu_ItemSelected"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
