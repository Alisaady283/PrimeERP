<UserControl x:Class="PrimeERP.UI.Components.Documents.DocumentHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inputs="clr-namespace:PrimeERP.UI.Components.Inputs"
             xmlns:display="clr-namespace:PrimeERP.UI.Components.Display"
             xmlns:actionsctl="clr-namespace:PrimeERP.UI.Components.Actions"
             x:Name="root">
    <Border Background="{DynamicResource SurfaceDefault}"
            BorderBrush="{DynamicResource OutlineDefault}"
            BorderThickness="1"
            CornerRadius="{DynamicResource P.Radius.Lg}"
            Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== الصف الأول: الرقم / التاريخ / النوع / الحالة ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- رقم المستند: للقراءة فقط + زر توليد -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="رقم المستند" FontSize="{DynamicResource P.Font.Size.200}"
                               FontFamily="{DynamicResource P.Font.Family.Primary}"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <inputs:AppTextBox Grid.Column="0" x:Name="noBox" IsReadOnly="True"
                                            Text="{Binding DocumentNo, ElementName=root, Mode=TwoWay}"/>
                        <actionsctl:AppButton Grid.Column="1" x:Name="btnGenerate" Text="توليد" Variant="secondary"
                                               Icon="{StaticResource IconRefresh}" Margin="6,0,0,0"
                                               Click="btnGenerate_Click"/>
                    </Grid>
                </StackPanel>

                <inputs:AppDatePicker Grid.Column="2" x:Name="datePicker" Label="التاريخ"
                                      SelectedDate="{Binding DocumentDate, ElementName=root, Mode=TwoWay}"
                                      SelectedDateChanged="datePicker_SelectedDateChanged"/>

                <inputs:AppComboBox Grid.Column="4" x:Name="typeCombo" Label="النوع" IsSearchable="False"
                                     ItemsSource="{Binding DocumentTypes, ElementName=root}"
                                     SelectedItem="{Binding DocumentType, ElementName=root, Mode=TwoWay}"/>

                <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <display:AppBadge x:Name="badge"/>
                </StackPanel>
            </Grid>

            <!-- ===== الصف الثاني: البيان + حقول إضافية خاصة بنوع المستند ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <inputs:AppTextArea Grid.Column="0" x:Name="descriptionBox" Label="البيان" Rows="2"
                                     Text="{Binding Description, ElementName=root, Mode=TwoWay}"/>

                <ContentPresenter Grid.Column="2" Content="{Binding ExtraFieldsContent, ElementName=root}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
