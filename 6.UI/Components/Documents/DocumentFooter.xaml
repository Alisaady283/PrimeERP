<UserControl x:Class="PrimeERP.UI.Components.Documents.DocumentFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="clr-namespace:PrimeERP.UI.Components.Documents"
             xmlns:conv="clr-namespace:PrimeERP.UI.Converters"
             x:Name="root">

    <!-- محرر المستند DocumentFooter -->
    <UserControl.Resources>
        <conv:FooterVariantToBrushConverter x:Key="VariantBrush"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceDefault}"
            BorderBrush="{DynamicResource OutlineDefault}"
            BorderThickness="1"
            CornerRadius="{DynamicResource P.Radius.Lg}"
            Padding="18,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{DynamicResource P.Space.4.Column}"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- رسالة الحالة -->
            <Border Grid.Column="0" x:Name="statusWrap" VerticalAlignment="Center"
                    Padding="{DynamicResource C.Bar.Padding}" CornerRadius="{DynamicResource P.Radius.Sm}" Visibility="Collapsed">
                <TextBlock x:Name="statusText"
                           FontSize="{DynamicResource P.Font.Size.300}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           FontWeight="{DynamicResource P.Font.Weight.SemiBold}"/>
            </Border>

            <!-- الإجماليات -->
            <ItemsControl Grid.Column="2" x:Name="totalsList" ItemsSource="{Binding TotalsSource, ElementName=root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="{DynamicResource C.Section.Indent}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                       FontSize="{DynamicResource P.Font.Size.200}"
                                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                                       Foreground="{DynamicResource TextMuted}" Margin="{DynamicResource P.Space.1.Bottom}"/>
                            <TextBlock Text="{Binding Value, StringFormat={}{0:N2}}" HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                                       Foreground="{Binding Variant, Converter={StaticResource VariantBrush}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.300}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBold}" Value="True">
                                                <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.SemiBold}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLarge}" Value="True">
                                                <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.600}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ContentPresenter Grid.Column="4" Content="{Binding ActionsContent, ElementName=root}" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
