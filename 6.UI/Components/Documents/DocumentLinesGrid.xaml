<UserControl x:Class="PrimeERP.UI.Components.Documents.DocumentLinesGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="clr-namespace:PrimeERP.UI.Components.Documents">
    <UserControl.Resources>

        <docs:LineCellValueConverter x:Key="CellValueConverter"/>
        <docs:CellHasErrorConverter x:Key="CellHasErrorConverter"/>
        <docs:CellErrorMessageConverter x:Key="CellErrorMessageConverter"/>
        <docs:HorizontalToTextAlignmentConverter x:Key="HAlignToTextAlign"/>

        <!-- ===== نمط الخلية: إطار أحمر + tooltip عند وجود خطأ تحقّق لهذه الخلية بالذات ===== -->
        <Style x:Key="LineCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TableRowSelected}"/>
                </Trigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CellHasErrorConverter}">
                            <Binding Path="Errors"/>
                            <Binding RelativeSource="{RelativeSource Self}" Path="Column.SortMemberPath"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource CellErrorMessageConverter}">
                                <Binding Path="Errors"/>
                                <Binding RelativeSource="{RelativeSource Self}" Path="Column.SortMemberPath"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== عمود ترقيم السطور: يعرض DataGridRow.Header الذي يضبطه Grid_LoadingRow ===== -->
        <DataTemplate x:Key="CellView_RowNumber">
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextMuted}"/>
        </DataTemplate>

        <!-- ===== نص عادي (يُستخدم أيضاً لأعمدة الـ Picker في هذا الجزء) =====
             ملاحظة: Binding الأول Path="Self" (خاصية DocumentLine.Self ترجع this) — لا Path فارغ.
             WPF لا يُنشئ أي مستمع PropertyChanged لمسار فارغ (Path=""), فلا يتحدّث القيمة حياً أبداً.
             Path="Self" ينشئ مستمعاً حقيقياً يستجيب لإشعار OnPropertyChanged(string.Empty) القياسي. -->
        <DataTemplate x:Key="CellView_Text">
            <TextBlock VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment}"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="CellEdit_Text">
            <TextBox VerticalAlignment="Center" Margin="3" Padding="6,4"
                     TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment, Converter={StaticResource HAlignToTextAlign}}"
                     BorderThickness="1" BorderBrush="{DynamicResource OutlineFocus}"
                     Background="{DynamicResource C.Input.Bg}" Foreground="{DynamicResource TextPrimary}"
                     FontSize="{DynamicResource P.Font.Size.300}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                     LostFocus="TextCell_LostFocus">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" Mode="OneWay">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </DataTemplate>

        <!-- ===== Picker (نص عادي فقط في هذا الجزء — الدمج الفعلي في الجزء 4.3) ===== -->
        <DataTemplate x:Key="CellView_Picker">
            <TextBlock VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment}"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <!-- ===== وضع تعديل Picker: TextBox + زر صغير (…) — لا PickerBaseControl كامل داخل الخلية ===== -->
        <DataTemplate x:Key="CellEdit_Picker">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" VerticalAlignment="Center" Margin="3,3,0,3" Padding="6,4"
                         TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment, Converter={StaticResource HAlignToTextAlign}}"
                         BorderThickness="1" BorderBrush="{DynamicResource OutlineFocus}"
                         Background="{DynamicResource C.Input.Bg}" Foreground="{DynamicResource TextPrimary}"
                         FontSize="{DynamicResource P.Font.Size.300}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                         LostFocus="TextCell_LostFocus">
                    <TextBox.Text>
                        <MultiBinding Converter="{StaticResource CellValueConverter}" Mode="OneWay">
                            <Binding Path="Self"/>
                            <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>
                <Button Grid.Column="1" Content="…" Width="24" Margin="2,3,3,3" Padding="0"
                        Cursor="Hand" Click="PickerButton_Click"
                        Background="{DynamicResource SurfaceDefault}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"/>
            </Grid>
        </DataTemplate>

        <!-- ===== Integer ===== -->
        <DataTemplate x:Key="CellView_Integer">
            <TextBlock VerticalAlignment="Center" Margin="10,0"
                       HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment}"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" StringFormat="{}{0:N0}">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="CellEdit_Integer">
            <TextBox VerticalAlignment="Center" Margin="3" Padding="6,4"
                     TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment, Converter={StaticResource HAlignToTextAlign}}"
                     BorderThickness="1" BorderBrush="{DynamicResource OutlineFocus}"
                     Background="{DynamicResource C.Input.Bg}" Foreground="{DynamicResource TextPrimary}"
                     FontSize="{DynamicResource P.Font.Size.300}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                     LostFocus="TextCell_LostFocus">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" Mode="OneWay">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </DataTemplate>

        <!-- ===== Decimal ===== -->
        <DataTemplate x:Key="CellView_Decimal">
            <TextBlock VerticalAlignment="Center" Margin="10,0"
                       HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment}"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" StringFormat="{}{0:N2}">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="CellEdit_Decimal">
            <TextBox VerticalAlignment="Center" Margin="3" Padding="6,4"
                     TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment, Converter={StaticResource HAlignToTextAlign}}"
                     BorderThickness="1" BorderBrush="{DynamicResource OutlineFocus}"
                     Background="{DynamicResource C.Input.Bg}" Foreground="{DynamicResource TextPrimary}"
                     FontSize="{DynamicResource P.Font.Size.300}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                     LostFocus="TextCell_LostFocus">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" Mode="OneWay">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </DataTemplate>

        <!-- ===== Money ===== -->
        <DataTemplate x:Key="CellView_Money">
            <TextBlock VerticalAlignment="Center" Margin="10,0"
                       HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment}"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" StringFormat="{}{0:N2}">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="CellEdit_Money">
            <TextBox VerticalAlignment="Center" Margin="3" Padding="6,4"
                     TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment, Converter={StaticResource HAlignToTextAlign}}"
                     BorderThickness="1" BorderBrush="{DynamicResource OutlineFocus}"
                     Background="{DynamicResource C.Input.Bg}" Foreground="{DynamicResource TextPrimary}"
                     FontSize="{DynamicResource P.Font.Size.300}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                     LostFocus="TextCell_LostFocus">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" Mode="OneWay">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </DataTemplate>

        <!-- ===== Percent ===== -->
        <DataTemplate x:Key="CellView_Percent">
            <TextBlock VerticalAlignment="Center" Margin="10,0"
                       HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment}"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" StringFormat="{}{0:0.##}%">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="CellEdit_Percent">
            <TextBox VerticalAlignment="Center" Margin="3" Padding="6,4"
                     TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment, Converter={StaticResource HAlignToTextAlign}}"
                     BorderThickness="1" BorderBrush="{DynamicResource OutlineFocus}"
                     Background="{DynamicResource C.Input.Bg}" Foreground="{DynamicResource TextPrimary}"
                     FontSize="{DynamicResource P.Font.Size.300}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                     LostFocus="TextCell_LostFocus">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" Mode="OneWay">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </DataTemplate>

        <!-- ===== Combo (بلا قائمة عناصر بعد — تحرير نصي عبر ComboBox قابل للتحرير) ===== -->
        <DataTemplate x:Key="CellView_Combo">
            <TextBlock VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment}"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="CellEdit_Combo">
            <ComboBox IsEditable="True" VerticalAlignment="Center" Margin="3"
                      FontSize="{DynamicResource P.Font.Size.300}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                      LostFocus="TextCell_LostFocus">
                <ComboBox.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" Mode="OneWay">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </ComboBox.Text>
            </ComboBox>
        </DataTemplate>

        <!-- ===== Checkbox (قالب واحد للعرض والتعديل معاً — دائماً في الوسط) ===== -->
        <DataTemplate x:Key="CellView_Checkbox">
            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                      Checked="CheckCell_Changed" Unchecked="CheckCell_Changed">
                <CheckBox.IsChecked>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" Mode="OneWay">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </CheckBox.IsChecked>
            </CheckBox>
        </DataTemplate>

        <!-- ===== Computed (للعرض فقط دائماً) ===== -->
        <DataTemplate x:Key="CellView_Computed">
            <TextBlock VerticalAlignment="Center" Margin="10,0"
                       HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=HorizontalContentAlignment}"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                       Foreground="{DynamicResource TextSecondary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CellValueConverter}" StringFormat="{}{0:N2}">
                        <Binding Path="Self"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.SortMemberPath"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"
                CornerRadius="{DynamicResource P.Radius.Md}" ClipToBounds="True">
            <DataGrid x:Name="grid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="All"
                      GridLinesVisibility="All"
                      SelectionUnit="CellOrRowHeader"
                      SelectionMode="Extended"
                      ClipboardCopyMode="None"
                      RowHeight="38"
                      RowHeaderWidth="14"
                      BorderThickness="0"
                      Background="{DynamicResource SurfaceDefault}"
                      RowBackground="{DynamicResource SurfaceDefault}"
                      AlternatingRowBackground="{DynamicResource SurfaceCanvas}"
                      HorizontalGridLinesBrush="{DynamicResource OutlineDefault}"
                      VerticalGridLinesBrush="{DynamicResource OutlineDefault}"
                      FontSize="{DynamicResource P.Font.Size.300}"
                      FontFamily="{DynamicResource P.Font.Family.Primary}"
                      Foreground="{DynamicResource TextPrimary}"
                      LoadingRow="Grid_LoadingRow"
                      PreviewKeyDown="Grid_PreviewKeyDown"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      PreviewTextInput="Grid_PreviewTextInput"
                      PreparingCellForEdit="Grid_PreparingCellForEdit">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceCanvas}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.SemiBold}"/>
                        <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource OutlineDefault}"/>
                        <!-- عناوين الأعمدة: وسط دائماً بلا استثناء (قاعدة موحدة لكل جداول النظام) -->
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <!-- شريط رفيع غير مُرقّم — مجرّد مقبض نقر لتحديد الصف كاملاً (عمود "#" أصلاً يعرض الرقم) -->
                <DataGrid.RowHeaderStyle>
                    <Style TargetType="DataGridRowHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceCanvas}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource OutlineDefault}"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Setter Property="Content" Value=""/>
                    </Style>
                </DataGrid.RowHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TableRowSelected}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TableRowHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- ===== صف الإجماليات — Grid منفصل بنفس عروض الأعمدة، يتزامن أفقياً مع الجدول الأساسي ===== -->
        <Border Grid.Row="1" x:Name="footerWrap"
                Visibility="Collapsed"
                BorderBrush="{DynamicResource OutlineDefault}"
                BorderThickness="1,0,1,1">
            <DataGrid x:Name="footerGrid"
                      HeadersVisibility="None"
                      IsHitTestVisible="False"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      CanUserResizeColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      RowHeight="34"
                      Background="{DynamicResource SurfaceCanvas}"
                      FontSize="{DynamicResource P.Font.Size.300}"
                      FontFamily="{DynamicResource P.Font.Family.Primary}"
                      FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                      Foreground="{DynamicResource TextPrimary}"/>
        </Border>

        <!-- ===== شريط أزرار السطور ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="{DynamicResource P.Space.2.Top}">
            <Button Content="+ إضافة سطر" Click="btnAddRow_Click" Padding="10,5" Margin="0,0,6,0" Cursor="Hand"
                    FontSize="{DynamicResource P.Font.Size.200}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                    Background="{DynamicResource SurfaceDefault}" Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"/>
            <Button Content="حذف السطر" Click="btnDeleteRow_Click" Padding="10,5" Margin="0,0,6,0" Cursor="Hand"
                    FontSize="{DynamicResource P.Font.Size.200}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                    Background="{DynamicResource SurfaceDefault}" Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"/>
            <Button Content="حذف الكل" Click="btnDeleteAllRows_Click" Padding="10,5" Margin="0,0,6,0" Cursor="Hand"
                    FontSize="{DynamicResource P.Font.Size.200}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                    Background="{DynamicResource SurfaceDefault}" Foreground="{DynamicResource Danger}"
                    BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"/>
            <Button Content="نسخ" Click="btnCopyRows_Click" Padding="10,5" Margin="0,0,6,0" Cursor="Hand"
                    FontSize="{DynamicResource P.Font.Size.200}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                    Background="{DynamicResource SurfaceDefault}" Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"/>
            <Button Content="لصق" Click="btnPasteRows_Click" Padding="10,5" Cursor="Hand"
                    FontSize="{DynamicResource P.Font.Size.200}" FontFamily="{DynamicResource P.Font.Family.Primary}"
                    Background="{DynamicResource SurfaceDefault}" Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</UserControl>
