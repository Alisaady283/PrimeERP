<UserControl x:Class="PrimeERP.UI.Components.Display.AppTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tree="clr-namespace:PrimeERP.UI.Components.Tree"
             xmlns:display="clr-namespace:PrimeERP.UI.Components.Display">

    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type tree:TreeNodeViewModel}" ItemsSource="{Binding VisibleChildren}">
            <StackPanel Orientation="Horizontal">

                <!-- مؤشّر الحالة — يظهر فقط حين CheckMode != None، ويُدوِّر الحالة بالنقر -->
                <Border x:Name="checkBox" Width="16" Height="16" Margin="0,0,8,0"
                        VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed"
                        CornerRadius="{DynamicResource P.Radius.Sm}" BorderThickness="1"
                        Background="{DynamicResource SurfaceDefault}"
                        BorderBrush="{DynamicResource OutlineStrong}"
                        MouseLeftButtonUp="CheckBox_Click">
                    <Path x:Name="checkGlyph" Stretch="Uniform" Width="10" Height="10"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeThickness="2" Visibility="Collapsed"
                          Data="{StaticResource IconCheck}"
                          Stroke="{DynamicResource TextOnBrand}"/>
                </Border>

                <Path x:Name="nodeIcon" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                      Width="{DynamicResource C.Icon.Size.Md}" Height="{DynamicResource C.Icon.Size.Md}"
                      Data="{StaticResource IconFolderFilled}"
                      Fill="{DynamicResource C.Tree.Folder.Fg}"/>

                <TextBlock x:Name="label" Text="{Binding DisplayText}"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           FontSize="{DynamicResource P.Font.Size.300}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrandDefault}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock x:Name="hint" Text="{Binding InheritedHint}" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           FontSize="{DynamicResource P.Font.Size.200}"
                           Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>

            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                    <Setter TargetName="nodeIcon" Property="Data" Value="{StaticResource IconFileFilled}"/>
                    <Setter TargetName="nodeIcon" Property="Fill" Value="{DynamicResource C.Tree.Leaf.Fg}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CheckMode, RelativeSource={RelativeSource AncestorType=display:AppTreeView}}" Value="TwoState">
                    <Setter TargetName="checkBox" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckMode, RelativeSource={RelativeSource AncestorType=display:AppTreeView}}" Value="ThreeState">
                    <Setter TargetName="checkBox" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsCheckEnabled}" Value="False">
                    <Setter TargetName="checkBox" Property="IsHitTestVisible" Value="False"/>
                    <Setter TargetName="checkBox" Property="Opacity" Value="0.35"/>
                    <Setter TargetName="checkBox" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="label" Property="Opacity" Value="0.45"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CheckState}" Value="Checked">
                    <Setter TargetName="checkBox" Property="Background" Value="{DynamicResource BrandDefault}"/>
                    <Setter TargetName="checkBox" Property="BorderBrush" Value="{DynamicResource BrandDefault}"/>
                    <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="Granted">
                    <Setter TargetName="checkBox" Property="Background" Value="{DynamicResource Success}"/>
                    <Setter TargetName="checkBox" Property="BorderBrush" Value="{DynamicResource Success}"/>
                    <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="Revoked">
                    <Setter TargetName="checkBox" Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="checkBox" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="checkGlyph" Property="Data" Value="{StaticResource IconClose}"/>
                    <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="Inherited">
                    <Setter TargetName="checkBox" Property="Background" Value="{DynamicResource SurfaceSunken}"/>
                    <Setter TargetName="checkBox" Property="BorderBrush" Value="{DynamicResource OutlineStrong}"/>
                    <Setter TargetName="checkGlyph" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <!-- موروث ومسموح: علامة باهتة مفرّغة — يُقرأ كمسموح، ويُميَّز عن المنح الصريح. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CheckState}" Value="Inherited"/>
                        <Condition Binding="{Binding InheritedAllowed}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="checkBox" Property="BorderBrush" Value="{DynamicResource Success}"/>
                    <Setter TargetName="checkGlyph" Property="Stroke" Value="{DynamicResource Success}"/>
                    <Setter TargetName="checkGlyph" Property="Data" Value="{StaticResource IconCheck}"/>
                    <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="checkBox" Property="Opacity" Value="0.65"/>
                </MultiDataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"
            CornerRadius="{DynamicResource P.Radius.Md}" Background="{DynamicResource SurfaceDefault}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TreeView x:Name="tree"
                      BorderThickness="0"
                      Background="Transparent"
                      Padding="{DynamicResource P.Space.2.Uniform}"
                      SelectedItemChanged="tree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="4,4"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </ScrollViewer>
    </Border>
</UserControl>
