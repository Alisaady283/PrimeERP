<UserControl x:Class="PrimeERP.UI.Components.Display.AppTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource OutlineDefault}"
                BorderThickness="0,0,0,1">
            <StackPanel x:Name="pnlTabs" Orientation="Horizontal"/>
        </Border>
        <ContentPresenter x:Name="contentHost" Margin="0,16,0,0"/>
    </DockPanel>
</UserControl>
