<UserControl x:Class="PrimeERP.UI.Components.Display.AppDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:PrimeERP.UI.Components.Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Toolbar (Export) ===== -->
        <StackPanel Grid.Row="0" x:Name="toolbar"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="{DynamicResource P.Space.2.Bottom}"
                    Visibility="Collapsed">
            <Button x:Name="btnExport" Cursor="Hand" Padding="12,6" Click="btnExport_Click"
                    Background="{DynamicResource SurfaceDefault}"
                    BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource P.Radius.Md}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconExport}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="2" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Str.Export}"
                               FontSize="{DynamicResource P.Font.Size.200}"
                               FontFamily="{DynamicResource P.Font.Family.Primary}"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ===== Grid + Overlays ===== -->
        <Grid Grid.Row="1" MinHeight="180">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- صفّ المجموعات: أعمدته تحاذي أعمدة الشبكة، وخلية المجموعة تمتدّ على أعمدتها. -->
            <Border x:Name="groupHeaderWrap" Grid.Row="0" Visibility="Collapsed"
                    Background="{DynamicResource C.Grid.Header.Bg}"
                    BorderBrush="{DynamicResource C.Grid.Header.Border}" BorderThickness="0,0,0,1">
                <Grid x:Name="groupHeader"/>
            </Border>

            <Border Grid.Row="1" BorderBrush="{DynamicResource C.Grid.Border}" BorderThickness="{DynamicResource C.Grid.Container.BorderThickness}"
                    CornerRadius="{DynamicResource C.Grid.Container.Radius}" ClipToBounds="True">
                <DataGrid x:Name="grid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          SelectionUnit="FullRow"
                          RowHeight="{DynamicResource C.Grid.Row.Height}"
                          RowHeaderWidth="{DynamicResource C.Grid.RowHeader.Width}"
                          BorderThickness="0"
                          Background="{DynamicResource C.Grid.Row.Bg}"
                          RowBackground="{DynamicResource C.Grid.Row.Bg}"
                          AlternatingRowBackground="{DynamicResource C.Grid.Row.AltBg}"
                          HorizontalGridLinesBrush="{DynamicResource C.Grid.Border}"
                          VerticalGridLinesBrush="{DynamicResource C.Grid.Border}"
                          FontSize="{DynamicResource P.Font.Size.300}"
                          FontFamily="{DynamicResource P.Font.Family.Primary}"
                          Foreground="{DynamicResource C.Grid.Cell.Fg}"
                          Sorting="grid_Sorting">
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="DataGridRowHeader">
                            <Setter Property="Background" Value="{DynamicResource C.Grid.Header.Bg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource C.Grid.Header.Fg}"/>
                            <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource C.Grid.Header.Border}"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource C.Grid.Header.Bg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource C.Grid.Header.Fg}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource P.Font.Weight.SemiBold}"/>
                            <Setter Property="FontSize" Value="{DynamicResource P.Font.Size.200}"/>
                            <Setter Property="Height" Value="{DynamicResource C.Grid.Header.Height}"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="{DynamicResource C.Grid.Header.BorderBottomThickness}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource C.Grid.Header.Border}"/>
                            <!-- عناوين الأعمدة: وسط دائماً بلا استثناء (قاعدة موحدة لكل جداول النظام) -->
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource C.Grid.Cell.Fg}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource C.Grid.Row.Selected.Fg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <!-- القائمة المالية ليست جدول بيانات: عنوان القسم وإجماليه يُميَّزان
                                     بدل تبادل ألوان يُقرأ كصفوف متساوية. -->
                                <Trigger Property="Tag" Value="heading">
                                    <Setter Property="Background" Value="{DynamicResource C.Grid.Header.Bg}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="total">
                                    <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="danger">
                                    <Setter Property="Background" Value="{DynamicResource C.Grid.Row.Danger.Bg}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="warning">
                                    <Setter Property="Background" Value="{DynamicResource C.Grid.Row.Warning.Bg}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource C.Grid.Row.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource C.Grid.Row.Selected.Bg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource C.Grid.Row.Selected.Border}"/>
                                    <Setter Property="BorderThickness" Value="{DynamicResource C.Grid.Row.Selected.BorderThickness}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <display:AppEmptyState x:Name="emptyState" Grid.Row="1" Visibility="Collapsed"
                                   Margin="{DynamicResource C.Grid.Empty.Margin}"/>
            <display:AppLoadingOverlay x:Name="loadingOverlay" Grid.Row="1"/>
        </Grid>

        <!-- ===== Footer totals ===== -->
        <Border Grid.Row="2" x:Name="footerWrap"
                Visibility="Collapsed"
                BorderBrush="{DynamicResource C.Grid.Footer.Border}"
                BorderThickness="{DynamicResource C.Grid.Footer.BorderThickness}">
            <DataGrid x:Name="footerGrid"
                      HeadersVisibility="None"
                      IsHitTestVisible="False"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      CanUserResizeColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      RowHeight="{DynamicResource C.Grid.Footer.Height}"
                      Background="{DynamicResource C.Grid.Footer.Bg}"
                      FontSize="{DynamicResource P.Font.Size.300}"
                      FontFamily="{DynamicResource P.Font.Family.Primary}"
                      FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                      Foreground="{DynamicResource C.Grid.Footer.Fg}"/>
        </Border>

        <!-- ===== Summary ===== -->
        <TextBlock Grid.Row="3" x:Name="summaryText" Visibility="Collapsed"
                   Margin="24,8,24,0" TextWrapping="Wrap"
                   FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource TextPrimary}"/>

        <!-- ===== Pagination ===== -->
        <display:AppPagination Grid.Row="4" x:Name="pagination" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
