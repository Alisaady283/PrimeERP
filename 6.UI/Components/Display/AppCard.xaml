<UserControl x:Class="PrimeERP.UI.Components.Display.AppCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}">
        <StackPanel>
            <Grid x:Name="header" Margin="18,16,18,12" Cursor="Arrow" MouseLeftButtonUp="Header_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="icon" Grid.Column="0"
                      Stretch="Uniform" Width="18" Height="18"
                      Margin="0,0,10,0"
                      StrokeThickness="1.8"
                      Stroke="{DynamicResource BodyTextBrush}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="Collapsed"/>

                <TextBlock x:Name="txtTitle" Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeMd}"
                           FontWeight="{StaticResource FontWeightSemibold}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"/>

                <ContentPresenter x:Name="actionsPresenter" Grid.Column="2" VerticalAlignment="Center"/>

                <Button x:Name="btnCollapse" Grid.Column="3"
                        Width="24" Height="24" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="btnCollapse_Click">
                    <Path x:Name="collapseIcon" Data="{StaticResource IconChevronDown}"
                          Stretch="Uniform" Width="12" Height="12"
                          Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="2"/>
                </Button>
            </Grid>

            <Border x:Name="separator" Height="1" Background="{DynamicResource OutlineBrush}" Margin="18,0"/>

            <ContentPresenter x:Name="bodyPresenter" Margin="18,16"/>
        </StackPanel>
    </Border>
</UserControl>
