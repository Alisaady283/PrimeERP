<UserControl x:Class="PrimeERP.UI.Components.Display.AppBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- عرض AppBadge -->
    <Border x:Name="border"
            CornerRadius="{DynamicResource P.Radius.Sm}"
            Padding="10,4"
            HorizontalAlignment="Left"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Path x:Name="icon"
                  Stretch="Uniform" Width="{DynamicResource C.Icon.Size.Xs}" Height="{DynamicResource C.Icon.Size.Xs}"
                  Margin="0,0,5,0"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"/>
            <TextBlock x:Name="txt"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
