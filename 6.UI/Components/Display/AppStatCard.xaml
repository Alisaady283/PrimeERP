<UserControl x:Class="PrimeERP.UI.Components.Display.AppStatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="root" Cursor="Arrow"
            Background="{DynamicResource SurfaceDefault}"
            BorderBrush="{DynamicResource OutlineDefault}"
            BorderThickness="1"
            CornerRadius="{DynamicResource P.Radius.Lg}"
            Padding="18"
            MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="txtTitle"
                           FontSize="{DynamicResource P.Font.Size.200}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextMuted}"/>
                <TextBlock x:Name="txtValue"
                           FontSize="{DynamicResource P.Font.Size.700}"
                           FontWeight="{DynamicResource P.Font.Weight.Bold}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="txtSubtitle"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource P.Font.Size.200}"
                               FontFamily="{DynamicResource P.Font.Family.Primary}"
                               Foreground="{DynamicResource TextSecondary}"
                               Visibility="Collapsed"/>
                    <Border x:Name="trendBadge"
                            CornerRadius="{DynamicResource P.Radius.Sm}"
                            Padding="6,2"
                            Margin="8,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="txtTrend"
                                   FontSize="{DynamicResource P.Font.Size.200}"
                                   FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                                   FontFamily="{DynamicResource P.Font.Family.Primary}"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border x:Name="iconWrap" Grid.Column="1"
                    Width="44" Height="44"
                    CornerRadius="{DynamicResource P.Radius.Md}"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <Path x:Name="icon"
                      Stretch="Uniform" Width="20" Height="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
