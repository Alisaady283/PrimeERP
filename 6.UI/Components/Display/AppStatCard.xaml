<UserControl x:Class="PrimeERP.UI.Components.Display.AppStatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- عرض AppStatCard -->
    <Border x:Name="root" Cursor="Arrow"
            Background="{DynamicResource SurfaceDefault}"
            BorderBrush="{DynamicResource OutlineDefault}"
            BorderThickness="1"
            CornerRadius="{DynamicResource P.Radius.Lg}"
            Padding="18"
            MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtTitle" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,8,0"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextMuted}"/>

            <Border x:Name="iconWrap" Grid.Row="0" Grid.Column="1"
                    Width="36" Height="36"
                    CornerRadius="{DynamicResource P.Radius.Md}"
                    Visibility="Collapsed">
                <Path x:Name="icon"
                      Stretch="Uniform" Width="18" Height="18"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>

            <Viewbox Grid.Row="1" Grid.ColumnSpan="2" StretchDirection="DownOnly" Stretch="Uniform"
                     HorizontalAlignment="Left" Margin="0,10,0,0">
                <TextBlock x:Name="txtValue"
                           FontSize="{DynamicResource P.Font.Size.700}"
                           FontWeight="{DynamicResource P.Font.Weight.Bold}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Viewbox>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="txtSubtitle"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource P.Font.Size.200}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextSecondary}"
                           Visibility="Collapsed"/>
                <Border x:Name="trendBadge"
                        CornerRadius="{DynamicResource P.Radius.Sm}"
                        Padding="6,2"
                        Margin="{DynamicResource P.Space.2.Left}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="txtTrend"
                               FontSize="{DynamicResource P.Font.Size.200}"
                               FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                               FontFamily="{DynamicResource P.Font.Family.Primary}"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
