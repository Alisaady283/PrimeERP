<UserControl x:Class="PrimeERP.UI.Components.Display.AppPagination"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="{DynamicResource C.Pagination.Height}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="txtInfo" Grid.Column="0"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource P.Font.Size.200}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource TextMuted}"/>

        <StackPanel x:Name="pnlPages" Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"/>

        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Str.RowsPerPage}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextMuted}"/>
            <ComboBox x:Name="cmbPageSize"
                      Width="70" Height="{DynamicResource C.Input.Height.Sm}"
                      FontSize="{DynamicResource P.Font.Size.200}"
                      FontFamily="{DynamicResource P.Font.Family.Primary}"
                      SelectionChanged="cmbPageSize_SelectionChanged"/>
        </StackPanel>
    </Grid>
</UserControl>
