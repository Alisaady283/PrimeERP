<Window x:Class="PrimeERP.UI.Components.Feedback.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        SizeToContent="Height"
        PreviewKeyDown="AppDialogWindow_PreviewKeyDown">

    <!-- الاستدارة والحدّ والظل على البطاقة لا على النافذة: النافذة شفافة ليقع الظل خارج البطاقة، فتنفصل
         عمّا خلفها بدل أن تذوب فيه — خصوصاً في الوضع الداكن حيث لا يكفي الظل وحده فيحدّها الإطار.
         نفس توكنات فورم الدخول، فالشكل واحد لكل نافذة في البرنامج. -->
    <Border x:Name="shell"
            Margin="{DynamicResource C.Dialog.Gutter}"
            Background="{DynamicResource SurfaceOverlay}"
            BorderBrush="{DynamicResource OutlineDefault}" BorderThickness="1"
            CornerRadius="{DynamicResource P.Radius.Lg}"
            Effect="{DynamicResource ShadowLg}">

        <!-- القصّ يُلزم الهيدر الملوّن والفوتر باستدارة البطاقة بدل أن يربّعا زواياها. -->
        <Grid x:Name="card">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border x:Name="headerBorder" Grid.Row="0" Style="{StaticResource DialogHeaderStyle}"
                MouseLeftButtonDown="headerBorder_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="headerIconWrap" Grid.Column="0" Style="{StaticResource DialogHeaderIconWrapStyle}" Visibility="Collapsed">
                    <Grid>
                        <Border x:Name="headerIconBackdrop" Style="{StaticResource DialogHeaderIconBackdropStyle}"/>
                        <Path x:Name="headerIcon" Style="{StaticResource DialogHeaderIconStyle}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeaderTitle" Style="{StaticResource DialogHeaderTitleStyle}"/>
                    <TextBlock x:Name="txtHeaderSubtitle" Style="{StaticResource DialogHeaderSubtitleStyle}" Visibility="Collapsed"/>
                </StackPanel>

                <Button x:Name="btnClose" Grid.Column="2" Style="{StaticResource DialogCloseButtonStyle}"
                        Click="btnClose_Click">
                    <Path x:Name="closeIcon" Data="{StaticResource IconClose}" Style="{StaticResource DialogCloseIconStyle}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <ScrollViewer Grid.Row="1" x:Name="contentScroll" Style="{StaticResource DialogContentScrollStyle}">
            <ContentPresenter x:Name="contentHost"/>
        </ScrollViewer>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <ContentPresenter x:Name="footerHost" HorizontalAlignment="Left"/>
        </Border>
        </Grid>
    </Border>
</Window>
