<UserControl x:Class="PrimeERP.UI.Components.Feedback.AppToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="root"
            Background="{DynamicResource SurfaceRaised}"
            CornerRadius="{DynamicResource P.Radius.Md}"
            Width="320"
            ClipToBounds="True"
            Effect="{DynamicResource ShadowMd}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle x:Name="accent" Grid.Column="0"/>

            <Grid Grid.Column="1" Margin="{DynamicResource P.Space.3.Uniform}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="iconWrap" Grid.Column="0"
                        Width="28" Height="28" CornerRadius="14"
                        Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path x:Name="icon"
                          Stretch="Uniform"
                          Width="{DynamicResource C.Icon.Size.Sm}" Height="{DynamicResource C.Icon.Size.Sm}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeThickness="{DynamicResource C.Icon.Stroke}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>

                <TextBlock x:Name="txtMessage" Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource P.Font.Size.300}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextPrimary}"/>

                <Button x:Name="btnClose" Grid.Column="2"
                        Width="22" Height="22" Margin="{DynamicResource P.Space.2.Left}"
                        VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="btnClose_Click">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform"
                          Width="9" Height="9" Stroke="{DynamicResource TextMuted}" StrokeThickness="2"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
