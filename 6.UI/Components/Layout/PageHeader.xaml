<UserControl x:Class="PrimeERP.UI.Components.Layout.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="iconWrap"
                        Width="40" Height="40"
                        CornerRadius="{StaticResource RadiusMd}"
                        Background="{DynamicResource BrandTintBrush}"
                        Margin="0,0,12,0"
                        Visibility="Collapsed">
                    <Path x:Name="icon"
                          Stretch="Uniform" Width="18" Height="18"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource BrandBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitle"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="{StaticResource FontWeightBold}"
                               FontFamily="{StaticResource AppFontFamily}"
                               Foreground="{DynamicResource BodyTextBrush}"/>
                    <TextBlock x:Name="txtSubtitle"
                               FontSize="{StaticResource FontSizeXs}"
                               FontFamily="{StaticResource AppFontFamily}"
                               Foreground="{DynamicResource FaintTextBrush}"
                               Margin="0,2,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <ContentPresenter x:Name="actionsPresenter" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
