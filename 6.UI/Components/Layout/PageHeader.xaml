<UserControl x:Class="PrimeERP.UI.Components.Layout.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceDefault}"
            BorderBrush="{DynamicResource OutlineDefault}"
            BorderThickness="0"
            Padding="24,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="iconWrap"
                        Width="40" Height="40"
                        CornerRadius="{DynamicResource P.Radius.Md}"
                        Background="{DynamicResource BrandSoft}"
                        Margin="{DynamicResource P.Space.3.Right}"
                        Visibility="Collapsed">
                    <Path x:Name="icon"
                          Stretch="Uniform" Width="18" Height="18"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource BrandDefault}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitle"
                               FontSize="{DynamicResource P.Font.Size.600}"
                               FontWeight="{DynamicResource P.Font.Weight.Bold}"
                               FontFamily="{DynamicResource P.Font.Family.Primary}"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="txtSubtitle"
                               FontSize="{DynamicResource P.Font.Size.200}"
                               FontFamily="{DynamicResource P.Font.Family.Primary}"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,2,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <ContentPresenter x:Name="actionsPresenter" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
