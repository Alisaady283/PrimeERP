<UserControl x:Class="PrimeERP.UI.Components.Actions.AppDropdownButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Button x:Name="btn" Height="{DynamicResource C.Button.Height.Sm}" Padding="14,0" Cursor="Hand"
                BorderThickness="1" Click="btn_Click"
                Background="{DynamicResource SurfaceDefault}"
                BorderBrush="{DynamicResource OutlineDefault}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource P.Radius.Md}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txt"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource P.Font.Size.300}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="{DynamicResource P.Space.2.Right}"/>
                <Path Data="{StaticResource IconChevronDown}"
                      Width="10" Height="10" Stretch="Uniform"
                      Stroke="{DynamicResource TextMuted}" StrokeThickness="2"
                      VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Popup x:Name="popup"
               PlacementTarget="{Binding ElementName=btn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource OutlineDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource P.Radius.Md}"
                    MinWidth="160"
                    Margin="{DynamicResource P.Space.1.Top}"
                    Effect="{DynamicResource ShadowMd}">
                <ListBox x:Name="lst"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{DynamicResource P.Font.Size.300}"
                         FontFamily="{DynamicResource P.Font.Family.Primary}"
                         MouseUp="lst_MouseUp"/>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
