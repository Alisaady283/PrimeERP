<UserControl x:Class="PrimeERP.UI.Components.Actions.ActionToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PrimeERP.UI.Components.Actions"
             SizeChanged="ActionToolbar_SizeChanged">

    <!-- أزرار ActionToolbar -->
    <DockPanel LastChildFill="False">
        <StackPanel x:Name="mainPanel" DockPanel.Dock="Left" Orientation="Horizontal"/>
        <actions:AppDropdownButton x:Name="overflowBtn" DockPanel.Dock="Left"
                                    Text="المزيد" Visibility="Collapsed"
                                    ItemSelected="OverflowBtn_ItemSelected"/>
    </DockPanel>
</UserControl>
