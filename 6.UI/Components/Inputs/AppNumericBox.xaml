<UserControl x:Class="PrimeERP.UI.Components.Inputs.AppNumericBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <StackPanel x:Name="pnlLabel" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
            <TextBlock x:Name="txtLabel"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="txtRequired" Text=" *"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource Danger}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Border x:Name="border"
                Background="{DynamicResource C.Input.Bg}"
                BorderBrush="{DynamicResource OutlineDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource P.Radius.Md}"
                Height="{DynamicResource C.Input.Height}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txt" Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{DynamicResource P.Font.Size.300}"
                         FontFamily="{DynamicResource P.Font.Family.Primary}"
                         Foreground="{DynamicResource TextPrimary}"
                         VerticalContentAlignment="Center"
                         TextAlignment="Left"
                         FlowDirection="LeftToRight"
                         Padding="10,0"
                         PreviewTextInput="txt_PreviewTextInput"
                         GotFocus="txt_GotFocus"
                         LostFocus="txt_LostFocus"/>

                <TextBlock x:Name="txtSuffix" Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="{DynamicResource P.Font.Size.300}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextMuted}"
                           Visibility="Collapsed"/>

                <StackPanel x:Name="pnlSpinner" Grid.Column="2"
                            Orientation="Vertical"
                            Visibility="Collapsed">
                    <Button x:Name="btnUp" Height="18" Width="24"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="btnUp_Click">
                        <Path Data="{StaticResource IconChevronUp}" Stretch="Uniform"
                              Width="10" Height="10" Stroke="{DynamicResource TextMuted}"
                              StrokeThickness="2"/>
                    </Button>
                    <Button x:Name="btnDown" Height="18" Width="24"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="btnDown_Click">
                        <Path Data="{StaticResource IconChevronDown}" Stretch="Uniform"
                              Width="10" Height="10" Stroke="{DynamicResource TextMuted}"
                              StrokeThickness="2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="txtError"
                   FontSize="{DynamicResource P.Font.Size.200}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource Danger}"
                   Margin="2,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
