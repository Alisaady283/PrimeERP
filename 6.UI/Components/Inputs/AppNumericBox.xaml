<UserControl x:Class="PrimeERP.UI.Components.Inputs.AppNumericBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- حقل إدخال AppNumericBox -->
    <StackPanel>

        <StackPanel x:Name="pnlLabel" Orientation="Horizontal" Margin="{DynamicResource P.Space.1.Bottom}" Visibility="Collapsed">
            <TextBlock x:Name="txtLabel"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="txtRequired" Text=" *"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource Danger}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Border x:Name="border"
                Background="{DynamicResource SurfaceDefault}"
                BorderBrush="{DynamicResource OutlineDefault}"
                BorderThickness="{DynamicResource C.Input.BorderThickness}"
                CornerRadius="{DynamicResource C.Input.Radius}"
                Height="{DynamicResource C.Input.Height}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txt" Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{DynamicResource C.Input.FontSize}"
                         FontFamily="{DynamicResource P.Font.Family.Primary}"
                         Foreground="{DynamicResource TextPrimary}"
                         VerticalContentAlignment="Center"
                         TextAlignment="Left"
                         FlowDirection="LeftToRight"
                         Padding="{DynamicResource C.Input.Padding}"
                         PreviewTextInput="txt_PreviewTextInput"
                         TextChanged="txt_TextChanged"
                         GotFocus="txt_GotFocus"
                         LostFocus="txt_LostFocus"/>

                <TextBlock x:Name="txtSuffix" Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource P.Space.2.Right}"
                           FontSize="{DynamicResource P.Font.Size.300}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextMuted}"
                           Visibility="Collapsed"/>

                <StackPanel x:Name="pnlSpinner" Grid.Column="2"
                            Orientation="Vertical"
                            Visibility="Collapsed">
                    <Button x:Name="btnUp" Height="{DynamicResource C.Stepper.Height}" Width="{DynamicResource C.Control.Size.Xs}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="btnUp_Click">
                        <Path Data="{StaticResource IconChevronUp}" Stretch="Uniform"
                              Width="{DynamicResource C.Icon.Size.Xs}" Height="{DynamicResource C.Icon.Size.Xs}" Stroke="{DynamicResource TextMuted}"
                              StrokeThickness="2"/>
                    </Button>
                    <Button x:Name="btnDown" Height="{DynamicResource C.Stepper.Height}" Width="{DynamicResource C.Control.Size.Xs}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="btnDown_Click">
                        <Path Data="{StaticResource IconChevronDown}" Stretch="Uniform"
                              Width="{DynamicResource C.Icon.Size.Xs}" Height="{DynamicResource C.Icon.Size.Xs}" Stroke="{DynamicResource TextMuted}"
                              StrokeThickness="2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="txtError"
                   FontSize="{DynamicResource P.Font.Size.200}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource Danger}"
                   Margin="{DynamicResource C.Input.AdornmentMargin}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
