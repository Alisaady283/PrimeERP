<UserControl x:Class="PrimeERP.UI.Components.Inputs.AppToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock x:Name="txtLabel"
                   FontSize="{StaticResource FontSizeXs}"
                   FontFamily="{StaticResource AppFontFamily}"
                   Foreground="{DynamicResource SubTextBrush}"
                   Margin="0,0,0,4"
                   Visibility="Collapsed"/>

        <StackPanel x:Name="root" Orientation="Horizontal" Cursor="Hand"
                    Background="Transparent"
                    MouseLeftButtonUp="Root_MouseLeftButtonUp">
            <Border x:Name="track" Width="42" Height="24" CornerRadius="12"
                    Background="{DynamicResource OutlineStrongBrush}">
                <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9"
                        Background="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="thumbTransform" X="0"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="Black"/>
                    </Border.Effect>
                </Border>
            </Border>

            <TextBlock x:Name="txtStatus"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeSm}"
                       FontFamily="{StaticResource AppFontFamily}"
                       Foreground="{DynamicResource BodyTextBrush}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
