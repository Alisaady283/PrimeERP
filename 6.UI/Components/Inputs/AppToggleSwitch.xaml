<UserControl x:Class="PrimeERP.UI.Components.Inputs.AppToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock x:Name="txtLabel"
                   FontSize="{DynamicResource P.Font.Size.200}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="{DynamicResource P.Space.1.Bottom}"
                   Visibility="Collapsed"/>

        <StackPanel x:Name="root" Orientation="Horizontal" Cursor="Hand"
                    Background="Transparent"
                    MouseLeftButtonUp="Root_MouseLeftButtonUp">
            <Border x:Name="track" Width="42" Height="24" CornerRadius="12"
                    Background="{DynamicResource OutlineStrong}">
                <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9"
                        Background="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="thumbTransform" X="0"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="Black"/>
                    </Border.Effect>
                </Border>
            </Border>

            <TextBlock x:Name="txtStatus"
                       Margin="{DynamicResource P.Space.2.Left}"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource P.Font.Size.300}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
