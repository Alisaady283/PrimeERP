<UserControl x:Class="PrimeERP.UI.Components.Inputs.AppDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- حقل إدخال AppDatePicker -->
    <StackPanel>

        <StackPanel x:Name="pnlLabel" Orientation="Horizontal" Margin="{DynamicResource P.Space.1.Bottom}" Visibility="Collapsed">
            <TextBlock x:Name="txtLabel"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="txtRequired" Text=" *"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource Danger}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Border x:Name="border"
                Background="{DynamicResource SurfaceDefault}"
                BorderBrush="{DynamicResource OutlineDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource P.Radius.Md}"
                Height="{DynamicResource C.Input.Height}">
            <DatePicker x:Name="picker"
                        BorderThickness="0"
                        Background="Transparent"
                        FontSize="{DynamicResource P.Font.Size.300}"
                        FontFamily="{DynamicResource P.Font.Family.Primary}"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalContentAlignment="Center"
                        SelectedDateFormat="Short"
                        SelectedDateChanged="picker_SelectedDateChanged"
                        GotFocus="picker_GotFocus"
                        LostFocus="picker_LostFocus"/>
        </Border>

        <TextBlock x:Name="txtError"
                   FontSize="{DynamicResource P.Font.Size.200}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource Danger}"
                   Margin="{DynamicResource C.Input.AdornmentMargin}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
