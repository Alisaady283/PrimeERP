<UserControl x:Class="PrimeERP.UI.Components.Inputs.AppTextArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <Grid Margin="{DynamicResource P.Space.1.Bottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="pnlLabel" Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="txtLabel"
                           FontSize="{DynamicResource P.Font.Size.200}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="txtRequired" Text=" *"
                           FontSize="{DynamicResource P.Font.Size.200}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource Danger}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="txtCounter" Grid.Column="1"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextMuted}"
                       Visibility="Collapsed"/>
        </Grid>

        <Border x:Name="border"
                Background="{DynamicResource C.Input.Bg}"
                BorderBrush="{DynamicResource OutlineDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource P.Radius.Md}">
            <Grid>
                <TextBox x:Name="txt"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{DynamicResource P.Font.Size.300}"
                         FontFamily="{DynamicResource P.Font.Family.Primary}"
                         Foreground="{DynamicResource TextPrimary}"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="txt_TextChanged"
                         GotFocus="txt_GotFocus"
                         LostFocus="txt_LostFocus"/>
                <TextBlock x:Name="placeholder"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           Margin="10,8"
                           FontSize="{DynamicResource P.Font.Size.300}"
                           FontFamily="{DynamicResource P.Font.Family.Primary}"
                           Foreground="{DynamicResource TextMuted}"/>
            </Grid>
        </Border>

        <TextBlock x:Name="txtError"
                   FontSize="{DynamicResource P.Font.Size.200}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource Danger}"
                   Margin="2,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
