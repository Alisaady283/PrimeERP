<UserControl x:Class="PrimeERP.UI.Components.Inputs.AppComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- حقل إدخال AppComboBox -->
    <StackPanel>

        <StackPanel x:Name="pnlLabel" Orientation="Horizontal" Visibility="Collapsed" Style="{StaticResource FieldLabelRowStyle}">
            <TextBlock x:Name="txtLabel" Style="{StaticResource FieldLabelTextStyle}"/>
            <TextBlock x:Name="txtRequired" Text=" *" Style="{StaticResource FieldRequiredMarkStyle}" Visibility="Collapsed"/>
        </StackPanel>

        <Border x:Name="border" Style="{StaticResource FieldBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Style="{StaticResource FieldInnerTextBoxStyle}"
                         TextChanged="txtSearch_TextChanged"
                         GotFocus="txtSearch_GotFocus"
                         LostFocus="txtSearch_LostFocus"
                         PreviewMouseLeftButtonDown="txtSearch_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="txtSearch_PreviewMouseLeftButtonUp"
                         PreviewKeyDown="txtSearch_PreviewKeyDown"/>

                <Button x:Name="btnClear" Grid.Column="1" Style="{StaticResource FieldClearButtonStyle}"
                        Visibility="Collapsed"
                        Click="btnClear_Click">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource FieldClearIconStyle}"/>
                </Button>

                <Path x:Name="chevron" Grid.Column="2" Data="{StaticResource IconChevronDown}" Style="{StaticResource ComboChevronStyle}"
                      Fill="Transparent" Cursor="Hand" MouseLeftButtonUp="chevron_MouseLeftButtonUp"/>
            </Grid>
        </Border>

        <Popup x:Name="popup"
               PlacementTarget="{Binding ElementName=border}"
               Placement="Bottom"
               Width="{Binding ElementName=border, Path=ActualWidth}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Style="{StaticResource ComboPopupBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lst" Style="{StaticResource ComboPopupListBoxStyle}"
                             PreviewMouseLeftButtonUp="lst_PreviewMouseLeftButtonUp"
                             KeyDown="lst_KeyDown"/>
                </ScrollViewer>
            </Border>
        </Popup>

        <TextBlock x:Name="txtError" Style="{StaticResource FieldErrorTextStyle}" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
