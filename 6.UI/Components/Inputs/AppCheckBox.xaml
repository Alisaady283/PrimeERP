<UserControl x:Class="PrimeERP.UI.Components.Inputs.AppCheckBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="root" Background="Transparent"
          MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="box" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CheckBoxBoxStyle}">
            <Grid>
                <!-- علامة الصح (Checked) -->
                <Path x:Name="checkPath"
                      Data="{StaticResource IconCheck}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Style="{StaticResource CheckBoxMarkStyle}"
                      Visibility="Collapsed"/>

                <!-- شرطة (Indeterminate) -->
                <Rectangle x:Name="dashMark"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource CheckBoxDashStyle}"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="txtLabel" Style="{StaticResource CheckBoxLabelStyle}"/>
            <TextBlock x:Name="txtDescription" Style="{StaticResource CheckBoxDescriptionStyle}" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
