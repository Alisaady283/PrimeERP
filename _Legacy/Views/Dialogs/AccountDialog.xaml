<Window x:Class="PrimeERP.Views.Dialogs.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حساب"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="txtHeaderIcon"
                           Text="📊"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitle"
                               Text="إضافة حساب"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="txtSubtitle"
                               Text="بيانات الحساب الجديد"
                               FontSize="11"
                               Foreground="#B3D9FF"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="✕"
                        FontSize="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        Cursor="Hand"
                        Click="btnClose_Click"
                        Opacity="0.8"/>
            </Grid>
        </Border>

        <!-- ===== Tabs ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Margin="24,0">
                <Border x:Name="tabInfo"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="0,0,0,0"
                        Margin="0,0,24,0"
                        Cursor="Hand">
                    <TextBlock Text="بيانات الحساب"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Padding="0,10"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Content ===== -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,16">
            <StackPanel>

                <!-- Row 1: الحساب الأب + كود الحساب -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- الحساب الأب -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الحساب الأب:"
                                   Style="{StaticResource FieldLabel}"/>
                        <Border Background="{StaticResource SecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="40"
                                Padding="12,0">
                            <TextBlock x:Name="txtParentCode"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- كود الحساب -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,4">
                            <Run Text="كود الحساب: "/>
                            <Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <Border Background="{StaticResource SecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="40"
                                Padding="12,0">
                            <TextBlock x:Name="txtCode"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 2: المستوى + النوع -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- المستوى -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="المستوى:"
                                   Style="{StaticResource FieldLabel}"/>
                        <Border Background="{StaticResource SecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="40"
                                Padding="12,0">
                            <TextBlock x:Name="txtLevel"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- النوع -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="النوع:"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbType"
                                  Height="40"
                                  FontSize="13"
                                  FontFamily="Segoe UI"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Background="White"
                                  IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- اسم الحساب -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6">
                        <Run Text="اسم الحساب "/>
                        <Run Text="*" Foreground="{StaticResource DangerBrush}"/>
                    </TextBlock>
                    <Border x:Name="nameBorder"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="40">
                        <TextBox x:Name="txtName"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 FontFamily="Segoe UI"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 GotFocus="txtName_GotFocus"
                                 LostFocus="txtName_LostFocus"/>
                    </Border>
                    <TextBlock x:Name="lblNameError"
                               Text="اسم الحساب مطلوب"
                               FontSize="11"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="4,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- يقبل قيود -->
                <Border x:Name="pnlLeaf"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="يقبل قيود محاسبية"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="عند التفعيل لا يمكن إضافة حسابات فرعية تحت هذا الحساب"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  x:Name="chkLeaf"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Width="20"
                                  Height="20"/>
                    </Grid>
                </Border>

                <!-- ملاحظات -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="ملاحظات:"
                               Style="{StaticResource FieldLabel}"/>
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBox x:Name="txtNotes"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 FontFamily="Segoe UI"
                                 Padding="12,10"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Info -->
                <TextBlock x:Name="txtFooterInfo"
                           Grid.Column="0"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>

                <!-- Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="✕  إلغاء"
                            Style="{StaticResource SecondaryButton}"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="btnCancel_Click"/>
                    <Button x:Name="btnSave"
                            Style="{StaticResource PrimaryButton}"
                            Width="120"
                            Click="btnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 "
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>