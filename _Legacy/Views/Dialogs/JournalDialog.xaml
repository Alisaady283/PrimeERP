<Window x:Class="PrimeERP.Views.Dialogs.JournalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="قيد يومية"
        Width="850"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="700"
        MinHeight="500"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="📒"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitle"
                               Text="قيد جديد"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="txtSubtitle"
                               Text="إدخال قيد محاسبي جديد"
                               FontSize="11"
                               Foreground="#B3D9FF"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="✕"
                        FontSize="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        Cursor="Hand"
                        Opacity="0.8"
                        Click="btnClose_Click"/>
            </Grid>
        </Border>

        <!-- ===== Entry Info ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- رقم القيد -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="رقم القيد:"
                               Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource PrimaryLightBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6">
                        <TextBlock x:Name="txtEntryNo"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- التاريخ -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="التاريخ *:"
                               Style="{StaticResource FieldLabel}"/>
                    <Border x:Name="dateBorder"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Width="140">
                        <TextBox x:Name="txtDate"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 GotFocus="txtDate_GotFocus"
                                 LostFocus="txtDate_LostFocus"/>
                    </Border>
                </StackPanel>

                <!-- النوع -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="النوع:"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbSource"
                              Width="130"
                              Height="36"
                              FontSize="13"
                              BorderBrush="{StaticResource BorderBrush}"
                              Background="White"/>
                </StackPanel>

                <!-- البيان -->
                <StackPanel Grid.Column="6">
                    <TextBlock Text="البيان:"
                               Style="{StaticResource FieldLabel}"/>
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBox x:Name="txtDescription"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Height="36"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ===== Grid Lines ===== -->
        <Border Grid.Row="2"
                Margin="16,12,16,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <DataGrid x:Name="gridLines"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="Cell"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      Background="White"
                      FontSize="13"
                      FontFamily="Segoe UI"
                      RowHeight="40"
                      ColumnHeaderHeight="42"
                      AlternatingRowBackground="#F7FAFF"
                      CellEditEnding="gridLines_CellEditEnding"
                      BeginningEdit="gridLines_BeginningEdit">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="Foreground"   Value="White"/>
                        <Setter Property="FontWeight"   Value="SemiBold"/>
                        <Setter Property="FontSize"     Value="13"/>
                        <Setter Property="Padding"      Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate
                                    TargetType="DataGridColumnHeader">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <!-- # -->
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding LineNo}"
                                        Width="45"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextMutedBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- كود الحساب -->
                    <DataGridTextColumn Header="كود الحساب"
                                        Binding="{Binding AccountCode,
                                                  UpdateSourceTrigger=LostFocus}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- اسم الحساب -->
                    <DataGridTextColumn Header="اسم الحساب"
                                        Binding="{Binding AccountName}"
                                        Width="*"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextSecondaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- مدين -->
                    <DataGridTextColumn Header="مدين"
                                        Binding="{Binding Debit,
                                                  UpdateSourceTrigger=LostFocus,
                                                  StringFormat=N2}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource SuccessBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- دائن -->
                    <DataGridTextColumn Header="دائن"
                                        Binding="{Binding Credit,
                                                  UpdateSourceTrigger=LostFocus,
                                                  StringFormat=N2}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource DangerBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- بيان السطر -->
                    <DataGridTextColumn Header="بيان"
                                        Binding="{Binding Notes,
                                                  UpdateSourceTrigger=LostFocus}"
                                        Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== Add Line Button ===== -->
        <Border Grid.Row="3"
                Margin="16,0"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAddLine"
                        Style="{StaticResource GhostButton}"
                        Height="32"
                        Padding="12,0"
                        Click="btnAddLine_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+ "
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="إضافة سطر"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}"
                        Height="32"
                        Padding="12,0"
                        Margin="8,0,0,0"
                        Click="btnDeleteLine_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑 "
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="حذف السطر"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== Balance Bar ===== -->
        <Border Grid.Row="4"
                Margin="16,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="txtBalanceStatus"
                           Text="أدخل بيانات القيد"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <TextBlock Text="مدين: "
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="txtTotalDebit"
                               Text="0.00"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <TextBlock Text="دائن: "
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="txtTotalCredit"
                               Text="0.00"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="الفرق: "
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="txtDiff"
                               Text="0.00"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="5"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtFooterInfo"
                           Grid.Column="0"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="✕  إلغاء"
                            Style="{StaticResource SecondaryButton}"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="btnCancel_Click"/>
                    <Button x:Name="btnSave"
                            Style="{StaticResource PrimaryButton}"
                            Width="130"
                            Click="btnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 "
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ القيد"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>