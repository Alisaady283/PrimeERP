<UserControl x:Class="PrimeERP.Views.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PrimeERP.ViewModels"
             xmlns:display="clr-namespace:PrimeERP.Views.Controls.Display"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:AccountsViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="شجرة الحسابات"
                               Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="عرض وإدارة شجرة الحسابات"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="+ إضافة حساب"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}"
                            Width="140"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding EditCommand}"
                            Width="95"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️ "
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="تعديل"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}"
                            Width="80">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️ "
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="حذف"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Filter Bar ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="260"
                        Height="38"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0"
                                   FontSize="14"/>
                        <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 FontFamily="Segoe UI"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,10,0"
                                 Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <!-- Level Filters -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0">

                    <Button Content="تصفية الكل"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="0"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,6,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☰ "
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="تصفية الكل"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="المستوى 1"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="1"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,6,0"/>

                    <Button Content="المستوى 2"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="2"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,6,0"/>

                    <Button Content="المستوى 3"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="3"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,6,0"/>

                    <Button Content="المستوى 4"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="4"
                            Height="34"
                            Padding="12,0"/>
                </StackPanel>

                <!-- Count Badge -->
                <Border Grid.Column="2"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="إجمالي: "
                                   FontSize="12"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding TotalCount}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text=" حساب"
                                   FontSize="12"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ===== DataGrid ===== -->
        <Border Grid.Row="2"
                Margin="24,16,24,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding PagedAccounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      Style="{StaticResource AppDataGrid}"
                      ColumnHeaderStyle="{StaticResource AppDataGridColumnHeader}"
                      RowStyle="{StaticResource AppDataGridRow}"
                      CellStyle="{StaticResource AppDataGridCell}"
                      MouseDoubleClick="Grid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="الكود"
                                        Binding="{Binding Code}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Margin" Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="اسم الحساب"
                                        Binding="{Binding DisplayName}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Margin" Value="14,0"/>
                                <Setter Property="FontFamily"
                                        Value="Segoe UI"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="المستوى"
                                        Binding="{Binding Level}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="النوع"
                                        Binding="{Binding TypeName}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- يقبل قيود — Badge -->
                    <DataGridTemplateColumn Header="يقبل قيود"
                                            Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="12"
                                        Padding="10,3"
                                        Margin="0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLeaf}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="#F0FFF4"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#38A169"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLeaf}"
                                                             Value="False">
                                                    <Setter Property="Background"
                                                            Value="#FFF5F5"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#E53E3E"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LeafText}"
                                               FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLeaf}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="#38A169"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}"
                                                                 Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="#E53E3E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="الرصيد"
                                        Binding="{Binding BalanceText}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== Pagination ===== -->
        <display:AppPagination Grid.Row="3"
                                x:Name="pagination"
                                Margin="24,8,24,8"/>

    </Grid>
</UserControl>