<UserControl x:Class="PrimeERP.Views.Pages.JournalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PrimeERP.ViewModels"
             xmlns:display="clr-namespace:PrimeERP.Views.Controls.Display"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:JournalViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="قيود اليومية"
                               Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="إدارة وعرض القيود المحاسبية"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}"
                            Width="140"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+ "
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="قيد جديد"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding ViewCommand}"
                            Width="85"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁 "
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="عرض"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding EditCommand}"
                            Width="90"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️ "
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="تعديل"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}"
                            Width="80">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️ "
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="حذف"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Summary Cards ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource BackgroundBrush}"
                Padding="24,12">
            <StackPanel Orientation="Horizontal">

                <!-- إجمالي القيود -->
                <Border Style="{StaticResource Card}"
                        Width="180"
                        Margin="0,0,12,0"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي القيود"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding TotalCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontFamily="Segoe UI"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="قيد محاسبي"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <!-- إجمالي المدين -->
                <Border Style="{StaticResource Card}"
                        Width="200"
                        Margin="0,0,12,0"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي المدين"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding TotalDebit}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontFamily="Segoe UI"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- إجمالي الدائن -->
                <Border Style="{StaticResource Card}"
                        Width="200"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="إجمالي الدائن"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding TotalCredit}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontFamily="Segoe UI"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- ===== Filter Bar ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="300"
                        Height="38"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0"
                                   FontSize="14"/>
                        <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 FontFamily="Segoe UI"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,10,0"
                                 Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ===== DataGrid ===== -->
        <Border Grid.Row="3"
                Margin="24,16,24,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding PagedEntries}"
                      SelectedItem="{Binding SelectedEntry}"
                      Style="{StaticResource AppDataGrid}"
                      ColumnHeaderStyle="{StaticResource AppDataGridColumnHeader}"
                      RowStyle="{StaticResource AppDataGridRow}"
                      CellStyle="{StaticResource AppDataGridCell}"
                      MouseDoubleClick="Grid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="رقم القيد"
                                        Binding="{Binding EntryNo}"
                                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Margin"
                                        Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding EntryDate}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="البيان"
                                        Binding="{Binding Description}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Margin"
                                        Value="14,0"/>
                                <Setter Property="TextTrimming"
                                        Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="إجمالي مدين"
                                        Binding="{Binding DebitText}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource SuccessBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="إجمالي دائن"
                                        Binding="{Binding CreditText}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource DangerBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="المصدر"
                                        Binding="{Binding Source}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الحالة Badge -->
                    <DataGridTemplateColumn Header="الحالة"
                                            Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="12"
                                        Padding="10,3"
                                        Margin="0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsPosted}"
                                                    Value="True">
                                                    <Setter Property="Background"
                                                            Value="#F0FFF4"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#38A169"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding IsPosted}"
                                                    Value="False">
                                                    <Setter Property="Background"
                                                            Value="#FFFFF0"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#D69E2E"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsPosted}"
                                                        Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="#38A169"/>
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsPosted}"
                                                        Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="#D69E2E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== Pagination ===== -->
        <display:AppPagination Grid.Row="4"
                                x:Name="pagination"
                                Margin="24,8,24,8"/>

    </Grid>
</UserControl>