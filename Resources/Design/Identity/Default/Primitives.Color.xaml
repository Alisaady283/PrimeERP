<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L1 — حزمة الهوية "Default". كل قيمة هنا حرفية (Hex) — الوحيد المسموح له بذلك في السلسلة كاملة.
        الأسماء بالدور (Brand/Neutral/Success...) لا بالصبغة (Blue/Slate...) عمداً: هذا ما يسمح لحزمة هوية
        بديلة (مثال Corporate) بإعادة تعريف P.Color.Brand.* بصبغة مختلفة تماماً بلا أي تغيير في Semantic —
        لو سُمّي "Blue" هنا لصار كذباً بصرياً بمجرد أن تصبح قيمته بنفسجية في حزمة أخرى.
        Semantic/Semantic.Light.xaml و Semantic.Dark.xaml يشيران لهذه المفاتيح حصراً عبر DynamicResource
        (داخل خاصية Color لـ SolidColorBrush/DropShadowEffect — القيد الوحيد الذي يقبله WPF لمرجع لون بين ملفات).
    -->

    <!-- ===== Brand (العلامة) ===== -->
    <Color x:Key="P.Color.Brand.50">#EFF6FF</Color>
    <Color x:Key="P.Color.Brand.100">#DBEAFE</Color>
    <Color x:Key="P.Color.Brand.200">#BFDBFE</Color>
    <Color x:Key="P.Color.Brand.300">#93C5FD</Color>
    <Color x:Key="P.Color.Brand.400">#60A5FA</Color>
    <Color x:Key="P.Color.Brand.500">#3B82F6</Color>
    <Color x:Key="P.Color.Brand.600">#2563EB</Color>
    <Color x:Key="P.Color.Brand.700">#1D4ED8</Color>
    <Color x:Key="P.Color.Brand.800">#1E40AF</Color>
    <Color x:Key="P.Color.Brand.900">#1E3A8A</Color>
    <Color x:Key="P.Color.Brand.950">#172554</Color>

    <!-- ===== Neutral (رمادي محايد — نصوص، أسطح، حدود الوضع الفاتح) ===== -->
    <Color x:Key="P.Color.Neutral.50">#F8FAFC</Color>
    <Color x:Key="P.Color.Neutral.100">#F1F5F9</Color>
    <Color x:Key="P.Color.Neutral.200">#E2E8F0</Color>
    <Color x:Key="P.Color.Neutral.300">#CBD5E1</Color>
    <Color x:Key="P.Color.Neutral.400">#94A3B8</Color>
    <Color x:Key="P.Color.Neutral.500">#64748B</Color>
    <Color x:Key="P.Color.Neutral.600">#475569</Color>
    <Color x:Key="P.Color.Neutral.700">#334155</Color>
    <Color x:Key="P.Color.Neutral.800">#1E293B</Color>
    <Color x:Key="P.Color.Neutral.900">#0F172A</Color>
    <Color x:Key="P.Color.Neutral.950">#020617</Color>

    <!-- ===== NeutralDark (أسطح/جداول الوضع الداكن فقط — سلّم منفصل عن Neutral، الإضاءة فيه تزيد مع الارتفاع لا العكس) ===== -->
    <Color x:Key="P.Color.NeutralDark.950">#0D101A</Color>
    <Color x:Key="P.Color.NeutralDark.900">#12162A</Color>
    <Color x:Key="P.Color.NeutralDark.800">#1A1F35</Color>
    <Color x:Key="P.Color.NeutralDark.700">#232942</Color>
    <Color x:Key="P.Color.NeutralDark.600">#2A3050</Color>
    <Color x:Key="P.Color.NeutralDark.500">#3A4260</Color>

    <!-- ===== Nav (الشريط الجانبي — غامق دائماً بصرف النظر عن الوضع فاتح/داكن) ===== -->
    <Color x:Key="P.Color.Nav.700">#1E2438</Color>
    <Color x:Key="P.Color.Nav.800">#171C2C</Color>
    <Color x:Key="P.Color.Nav.900">#12162A</Color>
    <Color x:Key="P.Color.Nav.950">#0D101A</Color>

    <!-- ===== Success ===== -->
    <Color x:Key="P.Color.Success.50">#F0FDF4</Color>
    <Color x:Key="P.Color.Success.100">#DCFCE7</Color>
    <Color x:Key="P.Color.Success.500">#22C55E</Color>
    <Color x:Key="P.Color.Success.600">#16A34A</Color>
    <Color x:Key="P.Color.Success.700">#15803D</Color>
    <Color x:Key="P.Color.Success.900">#14532D</Color>

    <!-- ===== Danger ===== -->
    <Color x:Key="P.Color.Danger.50">#FEF2F2</Color>
    <Color x:Key="P.Color.Danger.100">#FEE2E2</Color>
    <Color x:Key="P.Color.Danger.500">#EF4444</Color>
    <Color x:Key="P.Color.Danger.600">#DC2626</Color>
    <Color x:Key="P.Color.Danger.700">#B91C1C</Color>
    <Color x:Key="P.Color.Danger.900">#7F1D1D</Color>

    <!-- ===== Warning ===== -->
    <Color x:Key="P.Color.Warning.50">#FFFBEB</Color>
    <Color x:Key="P.Color.Warning.100">#FEF3C7</Color>
    <Color x:Key="P.Color.Warning.500">#F59E0B</Color>
    <Color x:Key="P.Color.Warning.600">#D97706</Color>
    <Color x:Key="P.Color.Warning.700">#B45309</Color>
    <Color x:Key="P.Color.Warning.900">#78350F</Color>

    <!-- ===== Info ===== -->
    <Color x:Key="P.Color.Info.50">#ECFEFF</Color>
    <Color x:Key="P.Color.Info.100">#CFFAFE</Color>
    <Color x:Key="P.Color.Info.500">#06B6D4</Color>
    <Color x:Key="P.Color.Info.600">#0891B2</Color>
    <Color x:Key="P.Color.Info.700">#0E7490</Color>
    <Color x:Key="P.Color.Info.900">#164E63</Color>

    <!-- ===== Base (بلا صبغة) ===== -->
    <Color x:Key="P.Color.White">#FFFFFF</Color>
    <Color x:Key="P.Color.Black">#000000</Color>

</ResourceDictionary>
