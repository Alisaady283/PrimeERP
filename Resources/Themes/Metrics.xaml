<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== سلّم المسافات (مضاعفات 4) ===== -->
    <!--
        قواعد الاستخدام (للمرجعية):
        Space1  بين أيقونة ونص داخل زر         Space2  بين عناصر متقاربة (أزرار متجاورة)
        Space3  حشو داخلي للحقول أفقياً        Space4  حشو البطاقات، بين مجموعات الحقول
        Space6  حشو الصفحة، بين الأقسام        Space8  بين الأقسام الكبرى
    -->
    <sys:Double x:Key="Space0">0</sys:Double>
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">20</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>
    <sys:Double x:Key="Space10">40</sys:Double>
    <sys:Double x:Key="Space12">48</sys:Double>
    <sys:Double x:Key="Space16">64</sys:Double>

    <!-- ===== نصف القطر (Radius) ===== -->
    <!--
        RadiusSm  الشارات الصغيرة، مربع الصح     RadiusMd  الأزرار، الحقول
        RadiusLg  البطاقات، الحوارات، الجداول    RadiusXl  البطاقات الكبيرة، الصور
        RadiusFull الصور الرمزية، الشارات الدائرية
    -->
    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ===== الأبعاد (Heights) ===== -->
    <sys:Double x:Key="HeightXs">28</sys:Double>   <!-- شارة، زر أيقونة صغير -->
    <sys:Double x:Key="HeightSm">32</sys:Double>   <!-- زر صغير، فلتر -->
    <sys:Double x:Key="HeightMd">36</sys:Double>   <!-- زر عادي -->
    <sys:Double x:Key="HeightLg">40</sys:Double>   <!-- حقل إدخال -->
    <sys:Double x:Key="HeightXl">44</sys:Double>   <!-- صف جدول -->
    <sys:Double x:Key="Height2xl">48</sys:Double>  <!-- رأس جدول، عنصر تنقل -->
    <sys:Double x:Key="Height3xl">56</sys:Double>  <!-- الشريط العلوي -->
    <sys:Double x:Key="Height4xl">64</sys:Double>  <!-- رأس الصفحة -->

    <!-- ===== عروض ثابتة ===== -->
    <sys:Double x:Key="SidebarWidth">256</sys:Double>
    <sys:Double x:Key="SidebarCollapsedWidth">64</sys:Double>
    <sys:Double x:Key="DialogWidthSm">420</sys:Double>
    <sys:Double x:Key="DialogWidthMd">560</sys:Double>
    <sys:Double x:Key="DialogWidthLg">760</sys:Double>
    <sys:Double x:Key="DialogWidthXl">1000</sys:Double>

    <!-- ===== أحجام الأيقونات ===== -->
    <sys:Double x:Key="IconXs">14</sys:Double>  <!-- داخل الشارات -->
    <sys:Double x:Key="IconSm">16</sys:Double>  <!-- داخل الأزرار -->
    <sys:Double x:Key="IconMd">18</sys:Double>  <!-- أزرار الأيقونات -->
    <sys:Double x:Key="IconLg">20</sys:Double>  <!-- عناصر التنقل -->
    <sys:Double x:Key="IconXl">24</sys:Double>  <!-- عناوين الصفحات -->
    <sys:Double x:Key="Icon2xl">32</sys:Double> <!-- الحالات الفارغة -->

    <!--
        ===== قيم بنيوية مسمّاة (استثناء مبرَّر — تُستخدم في ColumnDefinitions/RowDefinitions داخل القطع نفسها،
        فهي بنية لا تنسيق: لو تغيّرت انكسر تخطيط العمود لا مجرد شكله) =====
    -->
    <sys:Double x:Key="IconColumnWidth">24</sys:Double>
    <sys:Double x:Key="NavSelectedBarWidth">3</sys:Double>
    <sys:Double x:Key="RowNumberColumnWidth">45</sys:Double>
    <sys:Double x:Key="ActionsColumnWidth">90</sys:Double>

</ResourceDictionary>
