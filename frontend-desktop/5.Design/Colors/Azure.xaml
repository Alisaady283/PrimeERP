<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- الهوية: أزرق سماوي (Azure) — على نهج Microsoft Fluent: شريطان أزرقان داكنان وعلامةٌ زرقاء — اسم الملف اسم الهوية، ومحتواه ألوانها؛ والنسخة الجديدة تُنسخ منه بالمفاتيح والتعليقات نفسها؛ واللون يُغيَّر في الطبقة الأولى وحدها، والطبقة الثانية واحدةٌ في كل الهويات -->

    <!-- ===== الطبقة الأولى: لوحة الألوان — كل لونٍ مرّةً واحدة، وتحتها الرموز تستدعيه ===== -->

    <!-- Surfaces -->
    <Color x:Key="C.Card">#FFFFFF</Color>  <!-- الأبيض: الحقول والأزرار والجداول والصفحة والخطّ فوق لون الهوية -->
    <Color x:Key="C.Paper">#F5F5F5</Color>  <!-- سطح النافذة والحدود الخفيفة ورؤوس الجدول الداخلية -->
    <Color x:Key="C.PaperSoft">#FAFAFA</Color>  <!-- سطحٌ أفتح والصفّ المتناوب -->
    <Color x:Key="C.Login">#FAFAFA</Color>  <!-- خلفية نافذة الدخول -->
    <Color x:Key="C.PageTint">#D7E7F7</Color>  <!-- طرفا خلفية الصفحات PageWash -->
    <Color x:Key="C.PageCenter">#F5F5F5</Color>  <!-- وسط خلفية الصفحات PageWash -->

    <!-- Lines -->
    <Color x:Key="C.Line">#E0E0E0</Color>  <!-- حدّ الحقول والأزرار والحوار -->
    <Color x:Key="C.LineStrong">#D1D1D1</Color>  <!-- حدّ قوي وشريط التمرير -->

    <!-- Ink -->
    <Color x:Key="C.Ink">#242424</Color>  <!-- الخطّ الأساسي ولون الظلال -->
    <Color x:Key="C.InkSoft">#424242</Color>  <!-- الخطّ الثانوي -->
    <Color x:Key="C.InkTertiary">#616161</Color>  <!-- خطّ الشارة المحايدة -->
    <Color x:Key="C.InkFaint">#9E9E9E</Color>  <!-- الخطّ الباهت والتلميحات -->

    <!-- Brand -->
    <Color x:Key="C.Brand">#0F6CBD</Color>  <!-- لون الهوية: الأزرار الأساسية والتركيز والروابط -->
    <Color x:Key="C.BrandHover">#115EA3</Color>  <!-- لون الهوية عند التمرير -->
    <Color x:Key="C.BrandActive">#0C3B5E</Color>  <!-- لون الهوية عند الضغط -->
    <Color x:Key="C.BrandSoft">#EBF3FC</Color>  <!-- خلفيةٌ فاتحة بلون الهوية وتمرير صفّ الجدول -->
    <Color x:Key="C.BrandSoftLine">#B4D6FA</Color>  <!-- حدّ الشارة بلون الهوية -->
    <Color x:Key="C.BrandSoftInk">#0F548C</Color>  <!-- خطّ الشارة بلون الهوية -->
    <Color x:Key="C.Selected">#CFE4FA</Color>  <!-- الصفّ المحدّد في الجدول والقوائم -->

    <!-- Field -->
    <Color x:Key="C.Field">#0A2E52</Color>  <!-- الحقل الداكن: السايدبار والهيدر وشريط العنوان -->
    <Color x:Key="C.FieldRaised">#0E3A66</Color>  <!-- الحقل الداكن المرتفع -->
    <Color x:Key="C.FieldHover">#0F4271</Color>  <!-- التمرير على الحقل الداكن -->
    <Color x:Key="C.FieldLine">#114C82</Color>  <!-- الفواصل والحدود على الحقل الداكن -->
    <Color x:Key="C.FieldMark">#FFFFFF</Color>  <!-- شريط علامة الصفحة المفتوحة -->
    <Color x:Key="C.OnField">#FFFFFF</Color>  <!-- الخطّ والأيقونات فوق الحقل الداكن -->
    <Color x:Key="C.OnFieldSoft">#CFE4FA</Color>  <!-- الخطّ الهادئ فوق الحقل الداكن -->
    <Color x:Key="C.OnFieldFaint">#8DB8E3</Color>  <!-- الأيقونات والخطّ الباهت فوق الحقل الداكن -->
    <Color x:Key="C.DialogField">#0A2E52</Color>  <!-- رأس الفورم ونوافذ الحوار -->
    <Color x:Key="C.Avatar">#0F6CBD</Color>  <!-- دائرة حرف المستخدم -->
    <Color x:Key="C.TableHead">#114C82</Color>  <!-- خلفية رأس الجدول: درجةٌ داكنة من السايدبار -->
    <Color x:Key="C.TableHeadLine">#0A2E52</Color>  <!-- حدّ رأس الجدول -->
    <Color x:Key="C.CloseHover">#E81123</Color>  <!-- زرّ الإغلاق عند التمرير -->

    <!-- Status -->
    <Color x:Key="C.Success">#277F55</Color>  <!-- النجاح -->
    <Color x:Key="C.SuccessDeep">#1E6544</Color>  <!-- النجاح الأغمق: تمريرٌ وخطّ -->
    <Color x:Key="C.SuccessSoft">#EDF6F0</Color>  <!-- خلفية النجاح الفاتحة -->
    <Color x:Key="C.Danger">#B03E34</Color>  <!-- الخطأ والحذف -->
    <Color x:Key="C.DangerDeep">#8F312A</Color>  <!-- الخطأ الأغمق: تمريرٌ وخطّ -->
    <Color x:Key="C.DangerSoft">#FCEFEE</Color>  <!-- خلفية الخطأ الفاتحة -->
    <Color x:Key="C.Warning">#B07817</Color>  <!-- التنبيه -->
    <Color x:Key="C.WarningDeep">#8D5F12</Color>  <!-- التنبيه الأغمق: تمريرٌ وخطّ -->
    <Color x:Key="C.WarningSoft">#FDF5E9</Color>  <!-- خلفية التنبيه الفاتحة -->
    <Color x:Key="C.Info">#3A66A0</Color>  <!-- المعلومة -->
    <Color x:Key="C.InfoDeep">#2F5382</Color>  <!-- المعلومة الأغمق: تمريرٌ وخطّ -->
    <Color x:Key="C.InfoSoft">#EEF3FA</Color>  <!-- خلفية المعلومة الفاتحة -->
    <Color x:Key="C.Folder">#E9B949</Color>  <!-- أيقونة المجلّد في الشجرة -->
    <Color x:Key="C.Scrim">#000000</Color>  <!-- تعتيم خلف شاشة التحميل -->

    <!-- Chart -->
    <Color x:Key="C.Chart1">#1F78C8</Color>  <!-- سلسلة الرسم الأولى: درجةٌ متوسطة من لون الهوية -->
    <Color x:Key="C.Chart2">#F2784B</Color>  <!-- سلسلة الرسم الثانية: مرجاني ناعم -->
    <Color x:Key="C.Chart3">#2BA89C</Color>  <!-- سلسلة الرسم الثالثة: فيروزي -->
    <Color x:Key="C.Chart4">#DE9B2A</Color>  <!-- سلسلة الرسم الرابعة: كهرماني -->
    <Color x:Key="C.Chart5">#9B82D6</Color>  <!-- سلسلة الرسم الخامسة: بنفسجي هادئ -->
    <Color x:Key="C.ChartGood">#2BA89C</Color>  <!-- طرف «جيد» في تدرّج الشدّة -->
    <Color x:Key="C.ChartWarn">#E9A23B</Color>  <!-- وسط تدرّج الشدّة -->
    <Color x:Key="C.ChartBad">#E0574F</Color>  <!-- طرف «حرج» في تدرّج الشدّة -->

    <!-- ===== الطبقة الثانية: الرموز التي تستعملها الواجهة — تستدعي اللوحة ولا تكتب لوناً ===== -->

    <!-- Surface -->
    <SolidColorBrush x:Key="PageBg" Color="{StaticResource C.Card}"/>  <!-- خلفية منطقة الصفحة -->
    <SolidColorBrush x:Key="SurfaceCanvas"     Color="{StaticResource C.Paper}"/>  <!-- خلفية النافذة الرئيسية وتمرير عناصر القوائم -->
    <LinearGradientBrush x:Key="PageWash" StartPoint="0,0" EndPoint="1,0">  <!-- خلفية كل الصفحات خلف البطاقات والرسوم والأزرار: الطرفان PageTint والوسط لون السطح -->
        <GradientStop Color="{StaticResource C.PageTint}" Offset="0"/>  <!-- PageTint: لمسة الهوية على الطرف -->
        <GradientStop Color="{StaticResource C.PageCenter}" Offset="0.35"/>  <!-- لون السطح في الوسط -->
        <GradientStop Color="{StaticResource C.PageCenter}" Offset="0.65"/>  <!-- لون السطح في الوسط -->
        <GradientStop Color="{StaticResource C.PageTint}" Offset="1"/>  <!-- PageTint: لمسة الهوية على الطرف -->
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBackground" Color="{StaticResource C.PaperSoft}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="SurfaceDefault"    Color="{StaticResource C.Card}"/>  <!-- خلفية الحقول والأزرار والجداول -->
    <SolidColorBrush x:Key="SurfaceRaised"     Color="{StaticResource C.Card}"/>  <!-- خلفية القوائم المنسدلة والجداول المرتفعة -->
    <SolidColorBrush x:Key="SurfaceOverlay"    Color="{StaticResource C.Card}"/>  <!-- خلفية نوافذ الحوار -->
    <SolidColorBrush x:Key="SurfaceSunken"     Color="{StaticResource C.Paper}"/>  <!-- خلفية تمرير زرّ الأيقونة والحقل المعطّل -->
    <SolidColorBrush x:Key="SurfaceHeader"     Color="{StaticResource C.PaperSoft}"/>  <!-- غير مستعمل -->

    <!-- Border -->
    <SolidColorBrush x:Key="OutlineSubtle"  Color="{StaticResource C.Paper}"/>  <!-- حدّ خفيف داخل الحوار والطباعة -->
    <SolidColorBrush x:Key="OutlineDefault" Color="{StaticResource C.Line}"/>  <!-- حدّ الحقول والأزرار والحوار -->
    <SolidColorBrush x:Key="OutlineStrong"  Color="{StaticResource C.LineStrong}"/>  <!-- حدّ قوي وشريط التمرير -->
    <SolidColorBrush x:Key="OutlineFocus"   Color="{StaticResource C.Brand}"/>  <!-- حدّ الحقل عند التركيز -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"   Color="{StaticResource C.Ink}"/>  <!-- الخطّ الأساسي -->
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource C.InkSoft}"/>  <!-- الخطّ الثانوي وأيقونات الأزرار -->
    <SolidColorBrush x:Key="TextTertiary"  Color="{StaticResource C.InkTertiary}"/>  <!-- خطّ الشارة المحايدة -->
    <SolidColorBrush x:Key="TextMuted"     Color="{StaticResource C.InkFaint}"/>  <!-- الخطّ الباهت والتلميحات -->
    <SolidColorBrush x:Key="TextOnBrand"   Color="{StaticResource C.Card}"/>  <!-- الخطّ فوق لون الهوية -->
    <SolidColorBrush x:Key="TextLink"      Color="{StaticResource C.Brand}"/>  <!-- غير مستعمل -->

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandDefault"    Color="{StaticResource C.Brand}"/>  <!-- لون الهوية: زرّ الدخول والأزرار الأساسية -->
    <SolidColorBrush x:Key="BrandHover"      Color="{StaticResource C.BrandHover}"/>  <!-- لون الهوية عند التمرير -->
    <SolidColorBrush x:Key="BrandActive"     Color="{StaticResource C.BrandActive}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="BrandSoft"       Color="{StaticResource C.BrandSoft}"/>  <!-- خلفية فاتحة بلون الهوية -->
    <SolidColorBrush x:Key="BrandSoftBorder" Color="{StaticResource C.BrandSoftLine}"/>  <!-- حدّ الشارة بلون الهوية -->
    <SolidColorBrush x:Key="BrandSoftText"   Color="{StaticResource C.BrandSoftInk}"/>  <!-- خطّ الشارة بلون الهوية -->

    <!-- Grid -->
    <SolidColorBrush x:Key="GridHeaderBg" Color="{StaticResource C.Paper}"/>  <!-- خلفية صفوف العناوين داخل الجدول -->
    <SolidColorBrush x:Key="GridHeaderFg" Color="{StaticResource C.Ink}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="GridBg"       Color="{StaticResource C.Card}"/>  <!-- خلفية الجدول تحت آخر صفّ -->
    <SolidColorBrush x:Key="GridRowBg"    Color="{StaticResource C.Card}"/>  <!-- خلفية صفّ البيانات في الجدول -->
    <SolidColorBrush x:Key="GridRowAltBg" Color="{StaticResource C.PaperSoft}"/>  <!-- خلفية الصفّ المتناوب في الجدول -->

    <SolidColorBrush x:Key="TreeFolder" Color="{StaticResource C.Folder}"/>  <!-- أيقونة المجلّد في الشجرة -->
    <SolidColorBrush x:Key="LoginBg" Color="{StaticResource C.Login}"/>  <!-- خلفية نافذة الدخول -->

    <!-- Status -->
    <SolidColorBrush x:Key="Success"         Color="{StaticResource C.Success}"/>  <!-- لون النجاح -->
    <SolidColorBrush x:Key="SuccessHover"    Color="{StaticResource C.SuccessDeep}"/>  <!-- النجاح عند التمرير -->
    <SolidColorBrush x:Key="SuccessSoft"     Color="{StaticResource C.SuccessSoft}"/>  <!-- خلفية النجاح الفاتحة -->
    <SolidColorBrush x:Key="SuccessSoftText" Color="{StaticResource C.SuccessDeep}"/>  <!-- خطّ النجاح -->

    <SolidColorBrush x:Key="Danger"         Color="{StaticResource C.Danger}"/>  <!-- لون الخطأ والحذف -->
    <SolidColorBrush x:Key="DangerHover"    Color="{StaticResource C.DangerDeep}"/>  <!-- الخطأ عند التمرير -->
    <SolidColorBrush x:Key="DangerSoft"     Color="{StaticResource C.DangerSoft}"/>  <!-- خلفية الخطأ الفاتحة -->
    <SolidColorBrush x:Key="DangerSoftText" Color="{StaticResource C.DangerDeep}"/>  <!-- خطّ الخطأ -->

    <SolidColorBrush x:Key="Warning"         Color="{StaticResource C.Warning}"/>  <!-- لون التنبيه -->
    <SolidColorBrush x:Key="WarningHover"    Color="{StaticResource C.WarningDeep}"/>  <!-- التنبيه عند التمرير -->
    <SolidColorBrush x:Key="WarningSoft"     Color="{StaticResource C.WarningSoft}"/>  <!-- خلفية التنبيه الفاتحة -->
    <SolidColorBrush x:Key="WarningSoftText" Color="{StaticResource C.WarningDeep}"/>  <!-- خطّ التنبيه -->

    <SolidColorBrush x:Key="Info"         Color="{StaticResource C.Info}"/>  <!-- لون المعلومة -->
    <SolidColorBrush x:Key="InfoHover"    Color="{StaticResource C.InfoDeep}"/>  <!-- المعلومة عند التمرير -->
    <SolidColorBrush x:Key="InfoSoft"     Color="{StaticResource C.InfoSoft}"/>  <!-- خلفية المعلومة الفاتحة -->
    <SolidColorBrush x:Key="InfoSoftText" Color="{StaticResource C.InfoDeep}"/>  <!-- خطّ المعلومة -->

    <!-- Nav -->
    <SolidColorBrush x:Key="NavSurface"       Color="{StaticResource C.Field}"/>  <!-- خلفية السايدبار -->
    <SolidColorBrush x:Key="NavSurfaceRaised" Color="{StaticResource C.FieldRaised}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="NavText"          Color="{StaticResource C.OnFieldSoft}"/>  <!-- خطّ السايدبار -->
    <SolidColorBrush x:Key="NavTextHover"     Color="{StaticResource C.OnField}"/>  <!-- خطّ السايدبار عند التمرير -->
    <SolidColorBrush x:Key="NavTextSelected"  Color="{StaticResource C.OnField}"/>  <!-- خطّ الصفحة المفتوحة واسم البرنامج -->
    <SolidColorBrush x:Key="NavIcon"          Color="{StaticResource C.OnFieldFaint}"/>  <!-- أيقونات السايدبار ولاحقة ERP -->
    <SolidColorBrush x:Key="NavIconHover"     Color="{StaticResource C.OnField}"/>  <!-- أيقونة السايدبار عند التمرير -->
    <SolidColorBrush x:Key="NavIconSelected"  Color="{StaticResource C.OnField}"/>  <!-- أيقونة الصفحة المفتوحة -->
    <SolidColorBrush x:Key="NavHover"         Color="{StaticResource C.FieldHover}"/>  <!-- خلفية التمرير والصفحة المفتوحة والفواصل في السايدبار -->
    <SolidColorBrush x:Key="NavSelected"      Color="{StaticResource C.FieldLine}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="NavSelectedBar"   Color="{StaticResource C.FieldMark}"/>  <!-- شريط علامة الصفحة المفتوحة -->
    <SolidColorBrush x:Key="NavSectionLabel"  Color="{StaticResource C.OnFieldFaint}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="NavDivider"       Color="{StaticResource C.FieldLine}"/>  <!-- غير مستعمل -->

    <!-- Dialog -->
    <SolidColorBrush x:Key="DialogHeaderSurface" Color="{StaticResource C.DialogField}"/>  <!-- خلفية رأس الفورم ونوافذ الحوار -->
    <SolidColorBrush x:Key="DialogHeaderText"    Color="{StaticResource C.OnField}"/>  <!-- عنوان رأس الفورم وأيقونتاه -->

    <!-- TitleBar -->
    <SolidColorBrush x:Key="TitleBarSurface"    Color="{StaticResource C.Field}"/>  <!-- خلفية شريط العنوان أعلى النافذة -->
    <SolidColorBrush x:Key="TitleBarIcon"       Color="{StaticResource C.OnField}"/>  <!-- أيقونات التصغير والتكبير والإغلاق -->
    <SolidColorBrush x:Key="TitleBarHover"      Color="{StaticResource C.FieldHover}"/>  <!-- خلفية زرّ التصغير والتكبير عند التمرير -->
    <SolidColorBrush x:Key="TitleBarCloseHover" Color="{StaticResource C.CloseHover}"/>  <!-- خلفية زرّ الإغلاق عند التمرير -->

    <!-- TopBar -->
    <SolidColorBrush x:Key="TopBarSurface"   Color="{StaticResource C.Field}"/>  <!-- خلفية الهيدر وقائمة المستخدم -->
    <SolidColorBrush x:Key="TopBarBorder"    Color="{StaticResource C.FieldLine}"/>  <!-- حدّ الهيدر السفلي -->
    <SolidColorBrush x:Key="TopBarText"      Color="{StaticResource C.OnField}"/>  <!-- خطّ الهيدر -->
    <SolidColorBrush x:Key="TopBarIcon"      Color="{StaticResource C.OnFieldSoft}"/>  <!-- أيقونات الهيدر -->
    <SolidColorBrush x:Key="TopBarIconHover" Color="{StaticResource C.OnField}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="TopBarTextMuted" Color="{StaticResource C.OnFieldFaint}"/>  <!-- الخطّ الباهت في الهيدر -->
    <SolidColorBrush x:Key="TopBarHover"     Color="{StaticResource C.FieldHover}"/>  <!-- التمرير في الهيدر -->
    <SolidColorBrush x:Key="TopBarAvatar"    Color="{StaticResource C.Avatar}"/>  <!-- دائرة حرف المستخدم -->

    <!-- Table -->
    <SolidColorBrush x:Key="TableHeaderBg"        Color="{StaticResource C.TableHead}"/>  <!-- خلفية رأس الجدول -->
    <SolidColorBrush x:Key="TableHeaderText"      Color="{StaticResource C.OnField}"/>  <!-- خطّ رأس الجدول -->
    <SolidColorBrush x:Key="TableHeaderBorder"    Color="{StaticResource C.TableHeadLine}"/>  <!-- حدّ رأس الجدول -->
    <SolidColorBrush x:Key="TableRowHover"        Color="{StaticResource C.BrandSoft}"/>  <!-- خلفية صفّ الجدول عند التمرير -->
    <SolidColorBrush x:Key="TableRowSelected"     Color="{StaticResource C.Selected}"/>  <!-- خلفية الصفّ المحدّد في الجدول والقوائم -->
    <SolidColorBrush x:Key="TableRowSelectedText" Color="{StaticResource C.Ink}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="TableBorder"          Color="{StaticResource C.Paper}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="TableFooterBg"        Color="{StaticResource C.Paper}"/>  <!-- غير مستعمل -->

    <!-- Interaction -->
    <SolidColorBrush x:Key="StateHoverOverlay"   Color="{StaticResource C.Ink}" Opacity="0.04"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="StatePressedOverlay" Color="{StaticResource C.Ink}" Opacity="0.08"/>  <!-- غير مستعمل -->
    <sys:Double x:Key="StateDisabledOpacity">0.45</sys:Double>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="StateSelectedBg" Color="{StaticResource C.Selected}"/>  <!-- غير مستعمل -->
    <SolidColorBrush x:Key="FocusRing"       Color="{StaticResource C.Brand}"/>  <!-- غير مستعمل -->
    <sys:Double x:Key="FocusRingWidth">2</sys:Double>  <!-- غير مستعمل -->

    <!-- Shadow -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="{DynamicResource P.Shadow.Sm.Blur}" ShadowDepth="{DynamicResource P.Shadow.Sm.Depth}" Opacity="{DynamicResource P.Shadow.Sm.Opacity}" Color="{StaticResource C.Ink}" Direction="270"/>  <!-- ظلّ صغير للبطاقات -->
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="{DynamicResource P.Shadow.Md.Blur}" ShadowDepth="{DynamicResource P.Shadow.Md.Depth}" Opacity="{DynamicResource P.Shadow.Md.Opacity}" Color="{StaticResource C.Ink}" Direction="270"/>  <!-- ظلّ القوائم المنسدلة -->
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="{DynamicResource P.Shadow.Lg.Blur}" ShadowDepth="{DynamicResource P.Shadow.Lg.Depth}" Opacity="{DynamicResource P.Shadow.Lg.Opacity}" Color="{StaticResource C.Ink}" Direction="270"/>  <!-- ظلّ نوافذ الحوار والدخول -->
    <DropShadowEffect x:Key="ShadowXl" BlurRadius="{DynamicResource P.Shadow.Xl.Blur}" ShadowDepth="{DynamicResource P.Shadow.Xl.Depth}" Opacity="{DynamicResource P.Shadow.Xl.Opacity}" Color="{StaticResource C.Ink}" Direction="270"/>  <!-- غير مستعمل -->

    <!-- Chart -->
    <SolidColorBrush x:Key="ChartSeries1" Color="{StaticResource C.Chart1}"/>  <!-- سلسلة الرسم الأولى والوحيدة -->
    <SolidColorBrush x:Key="ChartSeries2" Color="{StaticResource C.Chart2}"/>  <!-- سلسلة الرسم الثانية -->
    <SolidColorBrush x:Key="ChartSeries3" Color="{StaticResource C.Chart3}"/>  <!-- سلسلة الرسم الثالثة -->
    <SolidColorBrush x:Key="ChartSeries4" Color="{StaticResource C.Chart4}"/>  <!-- سلسلة الرسم الرابعة -->
    <SolidColorBrush x:Key="ChartSeries5" Color="{StaticResource C.Chart5}"/>  <!-- سلسلة الرسم الخامسة -->

    <SolidColorBrush x:Key="ChartGood"    Color="{StaticResource C.ChartGood}"/>  <!-- طرف «جيد» في تدرّج الشدّة: فيروزي -->
    <SolidColorBrush x:Key="ChartWarn"    Color="{StaticResource C.ChartWarn}"/>  <!-- وسط تدرّج الشدّة: كهرماني -->
    <SolidColorBrush x:Key="ChartBad"     Color="{StaticResource C.ChartBad}"/>  <!-- طرف «حرج» في تدرّج الشدّة: مرجاني أحمر -->

    <!-- Scrim -->
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource C.Scrim}" Opacity="0.35"/>  <!-- تعتيم خلف شاشة التحميل -->

</ResourceDictionary>
