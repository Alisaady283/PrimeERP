<UserControl x:Class="PrimeERP.UI.Components.Shell.AppTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource C.TitleBar.ButtonWidth}"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBarIcon}"/>
            <Setter Property="FontFamily" Value="{DynamicResource P.Font.Family.Glyph}"/>
            <Setter Property="FontSize" Value="{DynamicResource C.TitleBar.GlyphSize}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chrome" Background="Transparent">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource TitleBarHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chrome" Background="Transparent">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource TitleBarCloseHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnBrand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Height="{DynamicResource C.TitleBar.Height}" Background="{DynamicResource TitleBarSurface}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="{DynamicResource Str.TitleBar.Minimize}" Click="btnMinimize_Click"/>
            <Button Style="{StaticResource CaptionButton}" x:Name="btnMaximize" Content="&#xE922;" ToolTip="{DynamicResource Str.TitleBar.Maximize}" Click="btnMaximize_Click"/>
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="{DynamicResource Str.TitleBar.Close}" Click="btnClose_Click"/>
        </StackPanel>
    </Border>
</UserControl>
