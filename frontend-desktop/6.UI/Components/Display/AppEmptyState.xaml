<UserControl x:Class="PrimeERP.UI.Components.Display.AppEmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- عرض AppEmptyState -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">

        <Border Width="56" Height="56"
                CornerRadius="28"
                Background="{DynamicResource SurfaceSunken}"
                HorizontalAlignment="Center"
                Margin="{DynamicResource P.Space.4.Bottom}">
            <Path x:Name="icon"
                  Stretch="Uniform" Width="{DynamicResource C.Icon.Size.Lg}" Height="{DynamicResource C.Icon.Size.Lg}"
                  Stroke="{DynamicResource TextMuted}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Border>

        <TextBlock x:Name="txtTitle"
                   FontSize="{DynamicResource P.Font.Size.300}"
                   FontWeight="{DynamicResource P.Font.Weight.SemiBold}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

        <TextBlock x:Name="txtMessage"
                   FontSize="{DynamicResource P.Font.Size.200}"
                   FontFamily="{DynamicResource P.Font.Family.Primary}"
                   Foreground="{DynamicResource TextMuted}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="{DynamicResource P.Space.1.Top}"/>

        <Button x:Name="btnAction"
                Margin="{DynamicResource P.Space.4.Top}"
                Padding="16,8"
                Cursor="Hand"
                Background="{DynamicResource BrandDefault}"
                Foreground="{DynamicResource TextOnBrand}"
                BorderThickness="0"
                Visibility="Collapsed"
                Click="btnAction_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource P.Radius.Md}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="txtAction"
                       FontSize="{DynamicResource P.Font.Size.200}"
                       FontFamily="{DynamicResource P.Font.Family.Primary}"
                       Foreground="{DynamicResource TextOnBrand}"/>
        </Button>
    </StackPanel>
</UserControl>
