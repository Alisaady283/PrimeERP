<UserControl x:Class="PrimeERP.Views.Dev.ControlsGalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inputs="clr-namespace:PrimeERP.Views.Controls.Inputs"
             xmlns:display="clr-namespace:PrimeERP.Views.Controls.Display"
             xmlns:layout="clr-namespace:PrimeERP.Views.Controls.Layout"
             xmlns:actionsctl="clr-namespace:PrimeERP.Views.Controls.Actions"
             xmlns:pickers="clr-namespace:PrimeERP.Views.Controls.Pickers"
             xmlns:docs="clr-namespace:PrimeERP.Views.Controls.Documents"
             xmlns:shell="clr-namespace:PrimeERP.Views.Controls.Shell"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SwatchLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <Style x:Key="SwatchBox" TargetType="StackPanel">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str.Gallery.Title}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="{StaticResource FontWeightBold}"
                               FontFamily="{StaticResource AppFontFamily}"
                               Foreground="{DynamicResource BodyTextBrush}"/>
                    <TextBlock Text="{DynamicResource Str.Gallery.Subtitle}"
                               FontSize="{StaticResource FontSizeXs}"
                               FontFamily="{StaticResource AppFontFamily}"
                               Foreground="{DynamicResource FaintTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnToggleTheme" Content="Light / Dark"
                            Click="btnToggleTheme_Click"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                            Background="{DynamicResource PanelBrush}"
                            Foreground="{DynamicResource BodyTextBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                    <Button x:Name="btnToggleLanguage" Content="AR / EN"
                            Click="btnToggleLanguage_Click"
                            Padding="12,6" Cursor="Hand"
                            Background="{DynamicResource PanelBrush}"
                            Foreground="{DynamicResource BodyTextBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===== محاكي الصلاحيات ===== -->
                <Border Style="{StaticResource SectionCard}" BorderBrush="{DynamicResource BrandBrush}">
                    <StackPanel>
                        <TextBlock Text="محاكي الصلاحيات" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="عطّل DevMode ثم فعّل/عطّل صلاحيات محددة لمراجعة PermissionButton وActionToolbar وColumnPermissions بصرياً قبل ربط تسجيل الدخول"
                                   Style="{StaticResource SwatchLabel}" TextWrapping="Wrap" Margin="2,0,0,14"/>

                        <inputs:AppToggleSwitch x:Name="devModeToggle"
                                                 Label="DevMode (يمنح كل الصلاحيات تلقائياً)"
                                                 OnLabel="مفعّل — كل شيء مسموح" OffLabel="معطّل — حسب القائمة أدناه"
                                                 Margin="0,0,0,16"/>

                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" MaxHeight="240" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="permissionsWrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Batch 1: Inputs ===== -->
                <TextBlock Text="الدفعة 1 — Inputs"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"
                           Margin="0,0,0,16"/>

                <!-- AppTextBox -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppTextBox" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="عادي" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppTextBox Label="اسم الحساب" IsRequired="True"
                                                    Placeholder="أدخل الاسم" PrefixIcon="{StaticResource IconUser}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="خطأ" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppTextBox Label="البريد الإلكتروني" Text="ali@"
                                                    ErrorText="البريد الإلكتروني غير صحيح"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="معطّل" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppTextBox Label="الكود" Text="1220" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="للقراءة فقط" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppTextBox Label="الرقم المرجعي" Text="JE-2026-00001" IsReadOnly="True"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AppNumericBox -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppNumericBox" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="عادي (فاصلة آلاف)" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppNumericBox Label="سعر البيع" Value="12500.5" Decimals="2"
                                                       ThousandSeparator="True" Suffix="ج.م"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="مع Spinner" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppNumericBox Label="الكمية" Value="3" Decimals="0"
                                                       Step="1" Min="0" AllowNegative="False" ShowSpinner="True"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="خطأ" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppNumericBox Label="نسبة الخصم" Value="150" Suffix="%"
                                                       ErrorText="النسبة يجب ألا تتجاوز 100"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="معطّل" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppNumericBox Label="الرصيد الافتتاحي" Value="0" IsEnabled="False"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AppComboBox -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppComboBox" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="قابل للبحث" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppComboBox x:Name="cmbSearchable" Label="الحساب" IsRequired="True"
                                                     IsSearchable="True" AllowClear="True" Placeholder="ابحث..."/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="قائمة عادية" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppComboBox x:Name="cmbPlain" Label="نوع الحساب" IsSearchable="False"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="خطأ" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppComboBox x:Name="cmbError" Label="العملة" ErrorText="اختر العملة"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="معطّل" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppComboBox x:Name="cmbDisabled" Label="الفرع" IsEnabled="False"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AppDatePicker -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppDatePicker" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="عادي" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppDatePicker Label="تاريخ القيد" IsRequired="True"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="خطأ" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppDatePicker Label="تاريخ الاستحقاق" ErrorText="التاريخ مطلوب"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="معطّل" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppDatePicker Label="تاريخ الإنشاء" IsEnabled="False"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AppCheckBox -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppCheckBox" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="عادي" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppCheckBox Label="حساب نشط" Description="يظهر في القوائم والتقارير" IsChecked="True"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="غير محدد (فارغ)" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppCheckBox Label="يقبل قيود مباشرة"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="Indeterminate" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppCheckBox Label="تحديد الكل" Description="بعض العناصر محدّدة فقط" IsIndeterminate="True"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="معطّل" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppCheckBox Label="حساب نظامي" IsChecked="True" IsEnabled="False"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AppToggleSwitch -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppToggleSwitch" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="مفعّل" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppToggleSwitch Label="السماح برصيد سالب" IsChecked="True"
                                                         OnLabel="مسموح" OffLabel="غير مسموح"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="معطّل (Off)" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppToggleSwitch Label="إشعارات البريد" OnLabel="مفعّلة" OffLabel="معطّلة"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="Disabled" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppToggleSwitch Label="الوضع الليلي" IsChecked="True" IsEnabled="False"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AppSearchBox -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppSearchBox" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="عادي" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppSearchBox Placeholder="بحث بالكود أو الاسم..." DelayMs="300"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="بنص" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppSearchBox Text="عميل" Placeholder="بحث..."/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="معطّل" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppSearchBox Placeholder="بحث..." IsEnabled="False"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AppTextArea -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppTextArea" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="عادي مع عدّاد" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppTextArea Label="ملاحظات" Rows="3" MaxLength="200" ShowCounter="True"
                                                     Placeholder="اكتب ملاحظاتك هنا..."/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="خطأ" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppTextArea Label="السبب" Rows="3" ErrorText="سبب الرفض مطلوب"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="معطّل" Style="{StaticResource SwatchLabel}"/>
                                <inputs:AppTextArea Label="وصف" Rows="3" Text="نص للقراءة فقط" IsEnabled="False"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Batch 2: Display + Layout ===== -->
                <TextBlock Text="الدفعة 2 — Display + Layout"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"
                           Margin="0,8,0,16"/>

                <!-- AppDataGrid -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppDataGrid" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="بيانات عادية (Sorting + Footer Sum + RowActions + Export + ترقيم صفوف)"
                                   Style="{StaticResource SwatchLabel}" Margin="2,0,0,8"/>
                        <display:AppDataGrid x:Name="gridDemo" Height="280" Margin="0,0,0,20"/>

                        <TextBlock Text="حالة فارغة (AppEmptyState)" Style="{StaticResource SwatchLabel}" Margin="2,0,0,8"/>
                        <display:AppDataGrid x:Name="gridEmpty" Height="220" Margin="0,0,0,20"/>

                        <TextBlock Text="حالة تحميل (Overlay)" Style="{StaticResource SwatchLabel}" Margin="2,0,0,8"/>
                        <display:AppDataGrid x:Name="gridLoading" Height="220"/>
                    </StackPanel>
                </Border>

                <!-- AppBadge -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppBadge" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <display:AppBadge Text="نشط" Variant="success" Margin="0,0,10,0"/>
                            <display:AppBadge Text="متأخر" Variant="danger" Margin="0,0,10,0"/>
                            <display:AppBadge Text="مسودة" Variant="warning" Margin="0,0,10,0"/>
                            <display:AppBadge Text="معلومة" Variant="info" Margin="0,0,10,0"/>
                            <display:AppBadge Text="أساسي" Variant="brand" Margin="0,0,10,0"/>
                            <display:AppBadge Text="محايد" Variant="neutral" Icon="{StaticResource IconCheck}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AppStatCard -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppStatCard" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <display:AppStatCard Title="إجمالي المبيعات" Value="210,500 ج.م" Subtitle="هذا الشهر"
                                                  Icon="{StaticResource IconSales}" Color="success" Trend="12.4"
                                                  Width="220" Margin="0,0,16,0"/>
                            <display:AppStatCard Title="الفواتير المتأخرة" Value="8" Subtitle="فاتورة"
                                                  Icon="{StaticResource IconWarning}" Color="danger" Trend="-3.2"
                                                  Width="220" Margin="0,0,16,0"/>
                            <display:AppStatCard Title="عدد العملاء" Value="342"
                                                  Icon="{StaticResource IconCustomers}" Color="info"
                                                  Width="220"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AppCard -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppCard" Style="{StaticResource SectionTitle}"/>
                        <display:AppCard Title="بيانات الشحن" Icon="{StaticResource IconBuilding}" IsCollapsible="True">
                            <display:AppCard.Body>
                                <TextBlock Text="محتوى الكارت القابل للطي — اضغط العنوان لتجربة الطي."
                                           FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSm}"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                            </display:AppCard.Body>
                        </display:AppCard>
                    </StackPanel>
                </Border>

                <!-- AppTabControl -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppTabControl" Style="{StaticResource SectionTitle}"/>
                        <display:AppTabControl x:Name="tabsDemo" Height="80"/>
                    </StackPanel>
                </Border>

                <!-- AppTreeView -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppTreeView" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="فلترة إخفاء حقيقية — اكتب &quot;بنك&quot; مثلاً وستختفي الفروع غير المطابقة تماماً"
                                   Style="{StaticResource SwatchLabel}" Margin="2,0,0,8"/>
                        <inputs:AppSearchBox x:Name="treeSearchDemo" Width="320" HorizontalAlignment="Left"
                                              Placeholder="بحث في الشجرة..." Margin="0,0,0,10"/>
                        <display:AppTreeView x:Name="treeDemo" Height="220" Width="320" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- AppEmptyState + AppLoadingOverlay -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppEmptyState / AppLoadingOverlay" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Height="200" Margin="0,0,10,0"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}">
                                <display:AppEmptyState x:Name="emptyStateDemo"
                                                        Icon="{StaticResource IconFolder}"
                                                        Title="لا توجد نتائج"
                                                        Message="جرّب تغيير الفلاتر أو أضف عنصراً جديداً"
                                                        ActionText="إضافة عنصر"/>
                            </Border>

                            <Grid Grid.Column="1" Height="200" Margin="10,0,0,0">
                                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource PanelBrush}"/>
                                <display:AppLoadingOverlay x:Name="loadingOverlayDemo" Message="جارٍ التحميل..." IsBusy="True"/>
                                <Button Content="تبديل" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Margin="0,0,0,10" Padding="12,6" Click="btnToggleLoadingOverlay_Click"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AppBreadcrumb -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppBreadcrumb" Style="{StaticResource SectionTitle}"/>
                        <display:AppBreadcrumb x:Name="breadcrumbDemo"/>
                    </StackPanel>
                </Border>

                <!-- PageHeader -->
                <Border Style="{StaticResource SectionCard}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="PageHeader" Style="{StaticResource SectionTitle}" Margin="20,20,20,12"/>
                        <layout:PageHeader Title="شجرة الحسابات" Subtitle="عرض وإدارة شجرة الحسابات"
                                           Icon="{StaticResource IconAccounts}">
                            <layout:PageHeader.ActionsContent>
                                <Button Content="+ إضافة" Padding="14,8"/>
                            </layout:PageHeader.ActionsContent>
                        </layout:PageHeader>
                    </StackPanel>
                </Border>

                <!-- FilterBar -->
                <Border Style="{StaticResource SectionCard}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="FilterBar" Style="{StaticResource SectionTitle}" Margin="20,20,20,12"/>
                        <layout:FilterBar SearchPlaceholder="بحث بالكود أو الاسم..." ResultCount="24"/>
                    </StackPanel>
                </Border>

                <!-- ===== Batch 3: Actions + Feedback ===== -->
                <TextBlock Text="الدفعة 3 — Actions + Feedback"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"
                           Margin="0,8,0,16"/>

                <!-- ActionToolbar -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="ActionToolbar" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="عريض (كل الأزرار ظاهرة)" Style="{StaticResource SwatchLabel}" Margin="2,0,0,6"/>
                        <actionsctl:ActionToolbar x:Name="toolbarWide" Height="40" Margin="0,0,0,16"/>

                        <TextBlock Text="ضيّق (Overflow — زر «المزيد»)" Style="{StaticResource SwatchLabel}" Margin="2,0,0,6"/>
                        <Border Width="260" HorizontalAlignment="Left" ClipToBounds="True">
                            <actionsctl:ActionToolbar x:Name="toolbarNarrow" Height="40"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- AppIconButton / AppDropdownButton / PermissionButton -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppIconButton" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <actionsctl:AppIconButton Icon="{StaticResource IconEdit}" TooltipText="تعديل" Margin="0,0,8,0"/>
                            <actionsctl:AppIconButton Icon="{StaticResource IconDelete}" TooltipText="حذف" Variant="danger" Margin="0,0,8,0"/>
                            <actionsctl:AppIconButton Icon="{StaticResource IconPrint}" TooltipText="طباعة" Margin="0,0,8,0"/>
                            <actionsctl:AppIconButton Icon="{StaticResource IconRefresh}" TooltipText="تحديث" Variant="brand"/>
                        </StackPanel>

                        <TextBlock Text="AppDropdownButton" Style="{StaticResource SectionTitle}"/>
                        <actionsctl:AppDropdownButton x:Name="dropdownDemo" Text="خيارات" Margin="0,0,0,20"/>

                        <TextBlock Text="PermissionButton" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="ملاحظة: DevMode يمنح كل الصلاحيات فلا يظهر الإخفاء فعلياً إلا بعد تفعيل تسجيل الدخول في المرحلة H"
                                   Style="{StaticResource SwatchLabel}" TextWrapping="Wrap" Margin="2,0,0,6"/>
                        <actionsctl:PermissionButton Text="حذف الحساب" Variant="danger" PermissionKey="Accounts.Delete"
                                                      Icon="{StaticResource IconDelete}"/>
                    </StackPanel>
                </Border>

                <!-- AppToast -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppToast (IToastService)" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Success" Click="btnToastSuccess_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Error (يدوي فقط)" Click="btnToastError_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Warning" Click="btnToastWarning_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Info" Click="btnToastInfo_Click" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dialogs -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="AppConfirmDialog / AppMessageDialog / AppProgressDialog (IDialogService)"
                                   Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="تأكيد خطر" Click="btnConfirmDangerous_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="رسالة نجاح" Click="btnShowMessage_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="رسالة خطأ" Click="btnShowError_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="نافذة تقدّم" Click="btnShowProgress_Click" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== الدفعة 4 — Business Controls (الخطوة 3: الـ Pickers الخمسة) ===== -->
                <TextBlock Text="الدفعة 4 — Business Controls"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"
                           Margin="0,8,0,16"/>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="الـ Pickers الخمسة" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="بيانات وهمية (Mock DataSources) — لا استدعاء DB من أي picker. اكتب مباشرة أو F4/زر البحث لفتح نافذة الاختيار الكاملة."
                                   Style="{StaticResource SwatchLabel}" TextWrapping="Wrap" Margin="2,0,0,14"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="AccountPicker (شجرة، LeafOnly)" Style="{StaticResource SwatchLabel}"/>
                                <pickers:AccountPicker x:Name="accountPickerDemo" Label="الحساب" IsRequired="True" AllowClear="True"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="CustomerPicker (جدول + إضافة سريعة)" Style="{StaticResource SwatchLabel}"/>
                                <pickers:CustomerPicker x:Name="customerPickerDemo" Label="العميل" AllowClear="True" AllowQuickAdd="True"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="SupplierPicker" Style="{StaticResource SwatchLabel}"/>
                                <pickers:SupplierPicker x:Name="supplierPickerDemo" Label="المورد" AllowClear="True"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="ProductPicker (تمييز أحمر لنفاد الرصيد)" Style="{StaticResource SwatchLabel}"/>
                                <pickers:ProductPicker x:Name="productPickerDemo" Label="الصنف" AllowClear="True" AllowQuickAdd="True"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SwatchBox}">
                                <TextBlock Text="EmployeePicker (ActiveOnly)" Style="{StaticResource SwatchLabel}"/>
                                <pickers:EmployeePicker x:Name="employeePickerDemo" Label="الموظف" AllowClear="True"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== الجزء 4.2/4.3/4.4 — مستند كامل: DocumentHeader + DocumentLinesGrid + DocumentFooter ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="مستند كامل (Header + LinesGrid + Footer)" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="ربط حقيقي: تغيير أي سطر → LineChanged/TotalsChanged → DocumentFooter.UpdateTotals فوراً. زر التوليد في الرأس يستخدم مصدراً وهمياً لأرقام المستندات."
                                   Style="{StaticResource SwatchLabel}" TextWrapping="Wrap" Margin="2,0,0,14"/>

                        <TextBlock Text="Journal — قيد يومية (مدين/دائن)" Style="{StaticResource SwatchLabel}" Margin="2,0,0,6"/>
                        <docs:DocumentHeader x:Name="headerJournal" Margin="0,0,0,10"/>
                        <docs:DocumentLinesGrid x:Name="linesGridJournal" Height="280" Margin="0,0,0,10"/>
                        <docs:DocumentFooter x:Name="footerJournal" Margin="0,0,0,24"/>

                        <TextBlock Text="SalesInvoice — فاتورة مبيعات" Style="{StaticResource SwatchLabel}" Margin="2,0,0,6"/>
                        <docs:DocumentHeader x:Name="headerSales" Margin="0,0,0,10"/>
                        <docs:DocumentLinesGrid x:Name="linesGridSales" Height="280" Margin="0,0,0,10"/>
                        <docs:DocumentFooter x:Name="footerSales" Margin="0,0,0,24"/>

                        <TextBlock Text="PurchaseInvoice — فاتورة مشتريات" Style="{StaticResource SwatchLabel}" Margin="2,0,0,6"/>
                        <docs:DocumentHeader x:Name="headerPurchase" Margin="0,0,0,10"/>
                        <docs:DocumentLinesGrid x:Name="linesGridPurchase" Height="280" Margin="0,0,0,10"/>
                        <docs:DocumentFooter x:Name="footerPurchase" Margin="0,0,0,24"/>

                        <TextBlock Text="Stock — إذن مخزن" Style="{StaticResource SwatchLabel}" Margin="2,0,0,6"/>
                        <docs:DocumentHeader x:Name="headerStock" Margin="0,0,0,10"/>
                        <docs:DocumentLinesGrid x:Name="linesGridStock" Height="280" Margin="0,0,0,10"/>
                        <docs:DocumentFooter x:Name="footerStock"/>
                    </StackPanel>
                </Border>

                <!-- ===== الدفعة 5 — Shell Controls (نهاية المرحلة D) ===== -->
                <TextBlock Text="الدفعة 5 — Shell Controls"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"
                           Margin="0,8,0,16"/>

                <Border Style="{StaticResource SectionCard}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="AppShell (AppSidebar + AppTopBar)" Style="{StaticResource SectionTitle}" Margin="20,20,20,0"/>
                        <TextBlock Text="اختبر: زر الطي في الشريط العلوي، تبديل الوضع الليلي من قائمة المستخدم، وإخفاء عناصر بلا صلاحية عبر محاكي الصلاحيات أعلى الصفحة."
                                   Style="{StaticResource SwatchLabel}" TextWrapping="Wrap" Margin="22,4,20,14"/>
                        <Border Height="640" Margin="20,0,20,20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True">
                            <shell:AppShell x:Name="shellDemo" NavigationRequested="shellDemo_NavigationRequested"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
