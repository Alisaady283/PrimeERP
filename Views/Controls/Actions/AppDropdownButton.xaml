<UserControl x:Class="PrimeERP.Views.Controls.Actions.AppDropdownButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Button x:Name="btn" Height="{StaticResource HeightSm}" Padding="14,0" Cursor="Hand"
                BorderThickness="1" Click="btn_Click"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource OutlineBrush}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txt"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSm}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"
                           Margin="0,0,8,0"/>
                <Path Data="{StaticResource IconChevronDown}"
                      Width="10" Height="10" Stretch="Uniform"
                      Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="2"
                      VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Popup x:Name="popup"
               PlacementTarget="{Binding ElementName=btn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    MinWidth="160"
                    Margin="0,4,0,0"
                    Effect="{StaticResource ShadowMd}">
                <ListBox x:Name="lst"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{StaticResource FontSizeSm}"
                         FontFamily="{StaticResource AppFontFamily}"
                         MouseUp="lst_MouseUp"/>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
