<UserControl x:Class="PrimeERP.Views.Controls.Shell.AppTopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:PrimeERP.Views.Controls.Display"
             xmlns:actionsctl="clr-namespace:PrimeERP.Views.Controls.Actions"
             xmlns:conv="clr-namespace:PrimeERP.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
        <Grid MinHeight="60" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- زر طي/فتح الشريط الجانبي -->
            <actionsctl:AppIconButton Grid.Column="0" x:Name="btnToggleSidebar" Icon="{StaticResource IconMenu}"
                                       TooltipText="طي/فتح القائمة" Click="btnToggleSidebar_Click" Margin="0,0,14,0"/>

            <!-- العنوان + الـ breadcrumb -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <display:AppBreadcrumb x:Name="breadcrumb"/>
                <TextBlock x:Name="pageTitleText" FontSize="{StaticResource FontSizeLg}"
                           FontWeight="{StaticResource FontWeightBold}" FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"/>
            </StackPanel>

            <!-- spacer -->
            <Border Grid.Column="2"/>

            <!-- اسم الشركة -->
            <TextBlock Grid.Column="3" x:Name="companyText" VerticalAlignment="Center" Margin="0,0,18,0"
                       FontSize="{StaticResource FontSizeSm}" FontFamily="{StaticResource AppFontFamily}"
                       Foreground="{DynamicResource SubTextBrush}"/>

            <!-- التاريخ: هجري وميلادي -->
            <StackPanel Grid.Column="4" x:Name="datePanel" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock x:Name="gregorianText" HorizontalAlignment="Left"
                           FontSize="{StaticResource FontSizeXs}" FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource BodyTextBrush}"/>
                <TextBlock x:Name="hijriText" HorizontalAlignment="Left"
                           FontSize="{StaticResource FontSizeXs}" FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource FaintTextBrush}"/>
            </StackPanel>

            <!-- الإشعارات -->
            <Grid Grid.Column="5" Margin="0,0,10,0">
                <actionsctl:AppIconButton x:Name="btnNotifications" Icon="{StaticResource IconBell}"
                                           TooltipText="الإشعارات" Click="btnNotifications_Click"/>
                <Border x:Name="notifBadge" Background="{DynamicResource CriticalBrush}" CornerRadius="7"
                        Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="notifBadgeText" FontSize="9" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- إجراءات إضافية من المستهلك -->
            <ContentPresenter Grid.Column="6" x:Name="actionsPresenter" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- قائمة المستخدم -->
            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BrandBrush}" Margin="0,0,8,0">
                    <TextBlock x:Name="userInitialText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="{StaticResource FontWeightSemibold}"
                               FontFamily="{StaticResource AppFontFamily}"/>
                </Border>
                <actionsctl:AppDropdownButton x:Name="userMenu" ItemSelected="userMenu_ItemSelected"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
