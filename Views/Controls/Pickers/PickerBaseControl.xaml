<UserControl x:Class="PrimeERP.Views.Controls.Pickers.PickerBaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PrimeERP.Converters">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
    </UserControl.Resources>
    <StackPanel>

        <StackPanel x:Name="pnlLabel" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
            <TextBlock x:Name="txtLabel"
                       FontSize="{StaticResource FontSizeXs}"
                       FontFamily="{StaticResource AppFontFamily}"
                       Foreground="{DynamicResource SubTextBrush}"/>
            <TextBlock x:Name="txtRequired" Text=" *"
                       FontSize="{StaticResource FontSizeXs}"
                       FontFamily="{StaticResource AppFontFamily}"
                       Foreground="{DynamicResource CriticalBrush}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Border x:Name="border"
                Background="{DynamicResource FieldBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}"
                Height="{StaticResource HeightMd}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txt" Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{StaticResource FontSizeSm}"
                         FontFamily="{StaticResource AppFontFamily}"
                         Foreground="{DynamicResource BodyTextBrush}"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         TextChanged="txt_TextChanged"
                         GotFocus="txt_GotFocus"
                         LostFocus="txt_LostFocus"
                         PreviewKeyDown="txt_PreviewKeyDown"/>

                <Button x:Name="btnClear" Grid.Column="1"
                        Width="24" Height="24" Margin="0,0,2,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="btnClear_Click">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform"
                          Width="10" Height="10" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="2"/>
                </Button>

                <Button x:Name="btnSearch" Grid.Column="2"
                        Width="30" Height="30" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="بحث كامل (F4)"
                        Click="btnSearch_Click">
                    <Path Data="{StaticResource IconSearch}" Stretch="Uniform"
                          Width="13" Height="13" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="2"/>
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="popup"
               PlacementTarget="{Binding ElementName=border}"
               Placement="Bottom"
               Width="{Binding ElementName=border, Path=ActualWidth}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    MaxHeight="240"
                    Margin="0,4,0,0"
                    Effect="{StaticResource ShadowMd}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lst"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="{StaticResource FontSizeSm}"
                             FontFamily="{StaticResource AppFontFamily}"
                             MouseUp="lst_MouseUp"
                             KeyDown="lst_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,6">
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{DynamicResource BodyTextBrush}"/>
                                    <TextBlock Text="{Binding ExtraInfo}"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{DynamicResource FaintTextBrush}"
                                               Visibility="{Binding ExtraInfo, Converter={StaticResource StringToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>
        </Popup>

        <TextBlock x:Name="txtError"
                   FontSize="{StaticResource FontSizeXs}"
                   FontFamily="{StaticResource AppFontFamily}"
                   Foreground="{DynamicResource CriticalBrush}"
                   Margin="2,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
