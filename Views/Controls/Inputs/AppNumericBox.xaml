<UserControl x:Class="PrimeERP.Views.Controls.Inputs.AppNumericBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <StackPanel x:Name="pnlLabel" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
            <TextBlock x:Name="txtLabel"
                       FontSize="{StaticResource FontSizeXs}"
                       FontFamily="{StaticResource AppFontFamily}"
                       Foreground="{DynamicResource SubTextBrush}"/>
            <TextBlock x:Name="txtRequired" Text=" *"
                       FontSize="{StaticResource FontSizeXs}"
                       FontFamily="{StaticResource AppFontFamily}"
                       Foreground="{DynamicResource CriticalBrush}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Border x:Name="border"
                Background="{DynamicResource FieldBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}"
                Height="{StaticResource HeightMd}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txt" Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{StaticResource FontSizeSm}"
                         FontFamily="{StaticResource AppFontFamily}"
                         Foreground="{DynamicResource BodyTextBrush}"
                         VerticalContentAlignment="Center"
                         TextAlignment="Left"
                         FlowDirection="LeftToRight"
                         Padding="10,0"
                         PreviewTextInput="txt_PreviewTextInput"
                         GotFocus="txt_GotFocus"
                         LostFocus="txt_LostFocus"/>

                <TextBlock x:Name="txtSuffix" Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="{StaticResource FontSizeSm}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource FaintTextBrush}"
                           Visibility="Collapsed"/>

                <StackPanel x:Name="pnlSpinner" Grid.Column="2"
                            Orientation="Vertical"
                            Visibility="Collapsed">
                    <Button x:Name="btnUp" Height="{StaticResource HeightXs}" Width="24"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="btnUp_Click">
                        <Path Data="{StaticResource IconChevronUp}" Stretch="Uniform"
                              Width="10" Height="10" Stroke="{DynamicResource FaintTextBrush}"
                              StrokeThickness="2"/>
                    </Button>
                    <Button x:Name="btnDown" Height="{StaticResource HeightXs}" Width="24"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="btnDown_Click">
                        <Path Data="{StaticResource IconChevronDown}" Stretch="Uniform"
                              Width="10" Height="10" Stroke="{DynamicResource FaintTextBrush}"
                              StrokeThickness="2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="txtError"
                   FontSize="{StaticResource FontSizeXs}"
                   FontFamily="{StaticResource AppFontFamily}"
                   Foreground="{DynamicResource CriticalBrush}"
                   Margin="2,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
