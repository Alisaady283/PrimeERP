<UserControl x:Class="PrimeERP.Views.Controls.Inputs.AppTextArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="pnlLabel" Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="txtLabel"
                           FontSize="{StaticResource FontSizeXs}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource SubTextBrush}"/>
                <TextBlock x:Name="txtRequired" Text=" *"
                           FontSize="{StaticResource FontSizeXs}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource CriticalBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="txtCounter" Grid.Column="1"
                       FontSize="{StaticResource FontSizeXs}"
                       FontFamily="{StaticResource AppFontFamily}"
                       Foreground="{DynamicResource FaintTextBrush}"
                       Visibility="Collapsed"/>
        </Grid>

        <Border x:Name="border"
                Background="{DynamicResource FieldBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
            <Grid>
                <TextBox x:Name="txt"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{StaticResource FontSizeSm}"
                         FontFamily="{StaticResource AppFontFamily}"
                         Foreground="{DynamicResource BodyTextBrush}"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="txt_TextChanged"
                         GotFocus="txt_GotFocus"
                         LostFocus="txt_LostFocus"/>
                <TextBlock x:Name="placeholder"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           Margin="10,8"
                           FontSize="{StaticResource FontSizeSm}"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource FaintTextBrush}"/>
            </Grid>
        </Border>

        <TextBlock x:Name="txtError"
                   FontSize="{StaticResource FontSizeXs}"
                   FontFamily="{StaticResource AppFontFamily}"
                   Foreground="{DynamicResource CriticalBrush}"
                   Margin="2,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
